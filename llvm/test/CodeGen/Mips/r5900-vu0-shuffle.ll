; CHECK-NEXT:    pextlw $1, $2, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    qmtc2 $1, $vf1
  %s = shufflevector <4 x float> %a, <4 x float> %b, <4 x i32> <i32 0, i32 4, i32 1, i32 5>
  ret <4 x float> %s
}


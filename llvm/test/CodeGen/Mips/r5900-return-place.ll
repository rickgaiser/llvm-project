; A return in the last 16 bytes of a 64-byte I-cache line costs the R5900 a
; cycle. A function without loops starts at a line, and its entry is placed in
; it (with padding that is not executed) so that its returns are not there.

; The return is at offset 12: no padding.
define void @short(ptr %p) {
; CHECK-LABEL: short:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    lw $2, 0($1)
; CHECK-NEXT:    addiu $2, $2, 1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sw $2, 0($1)
  %a = load i32, ptr %p
  %b = add i32 %a, 1
  store i32 %b, ptr %p
  ret void
}

; The return would be at offset 48 or 56: the entry moves so that it is at
; offset 0 of the next line.
define void @ret48(ptr %p) {
  %p0 = getelementptr i32, ptr %p, i32 0
  store i32 1, ptr %p0
  %p1 = getelementptr i32, ptr %p, i32 1
  store i32 2, ptr %p1
  %p2 = getelementptr i32, ptr %p, i32 2
  store i32 3, ptr %p2
  %p3 = getelementptr i32, ptr %p, i32 3
  store i32 4, ptr %p3
  %p4 = getelementptr i32, ptr %p, i32 4
  store i32 5, ptr %p4
  %z = getelementptr i32, ptr %p, i32 8
  store i32 0, ptr %z
  ret void
}

define void @ret56(ptr %p) {
  %p0 = getelementptr i32, ptr %p, i32 0
  store i32 1, ptr %p0
  %p1 = getelementptr i32, ptr %p, i32 1
  store i32 2, ptr %p1
  %p2 = getelementptr i32, ptr %p, i32 2
  store i32 3, ptr %p2
  %p3 = getelementptr i32, ptr %p, i32 3
  store i32 4, ptr %p3
  %p4 = getelementptr i32, ptr %p, i32 4
  store i32 5, ptr %p4
  %p5 = getelementptr i32, ptr %p, i32 5
  store i32 6, ptr %p5
  ret void
}

; With a loop a return is not a cycle of each iteration: the alignment is
; unchanged.
define void @loop(ptr %p, i32 %n) {
; CHECK-LABEL: loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $3, $5, 0
; CHECK-NEXT:    addiu $4, $zero, 0
; CHECK-NEXT:    move $5, $2
; CHECK-NEXT:    .p2align 3
; CHECK-NEXT:  .LBB3_1: # %body
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    sw $4, 0($5)
; CHECK-NEXT:    addiu $4, $4, 1
; CHECK-NEXT:    addiu $5, $5, 4
; CHECK-NEXT:    bne $3, $4, .LBB3_1
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    daddiu $1, $zero, 1
; CHECK-NEXT:    dsll $3, $1, 33
; CHECK-NEXT:    dsll $1, $1, 34
; CHECK-NEXT:    daddiu $3, $3, 1
; CHECK-NEXT:    daddiu $1, $1, 3
; CHECK-NEXT:    sdl $3, 7($2)
; CHECK-NEXT:    sdr $3, 0($2)
; CHECK-NEXT:    daddiu $3, $zero, 3
; CHECK-NEXT:    sdl $1, 15($2)
; CHECK-NEXT:    dsll $3, $3, 33
; CHECK-NEXT:    sdr $1, 8($2)
; CHECK-NEXT:    daddiu $1, $3, 5
; CHECK-NEXT:    sdl $1, 23($2)
; CHECK-NEXT:    sdr $1, 16($2)
; CHECK-NEXT:    addiu $1, $zero, 7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sw $1, 24($2)
entry:
  br label %body
body:
  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
  %q = getelementptr i32, ptr %p, i32 %i
  store i32 %i, ptr %q
  %i.next = add i32 %i, 1
  %c = icmp ne i32 %i.next, %n
  br i1 %c, label %body, label %exit
exit:
  %p0 = getelementptr i32, ptr %p, i32 0
  store i32 1, ptr %p0
  %p1 = getelementptr i32, ptr %p, i32 1
  store i32 2, ptr %p1
  %p2 = getelementptr i32, ptr %p, i32 2
  store i32 3, ptr %p2
  %p3 = getelementptr i32, ptr %p, i32 3
  store i32 4, ptr %p3
  %p4 = getelementptr i32, ptr %p, i32 4
  store i32 5, ptr %p4
  %p5 = getelementptr i32, ptr %p, i32 5
  store i32 6, ptr %p5
  %p6 = getelementptr i32, ptr %p, i32 6
  store i32 7, ptr %p6
  ret void
}


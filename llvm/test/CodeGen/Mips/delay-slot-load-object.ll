; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mipsel -mcpu=mips32r2 -relocation-model=static < %s \
; RUN:     | FileCheck %s --check-prefix=MIPS32
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi=n32 -relocation-model=static \
; RUN:     -mattr=+noabicalls < %s | FileCheck %s --check-prefix=R5900

; The delay slot filler may move a load past the stores that do not alias it,
; which it decides by the underlying objects of the load's address. A load
; from a global with a computed index goes into the delay slot of the return.

@ram = external global [65536 x i8]

define zeroext i8 @load_global_index(i32 signext %i) nounwind {
; MIPS32-LABEL: load_global_index:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    andi $1, $4, 65535
; MIPS32-NEXT:    lui $2, %hi(ram)
; MIPS32-NEXT:    addiu $2, $2, %lo(ram)
; MIPS32-NEXT:    addu $1, $2, $1
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    lbu $2, 0($1)
;
; R5900-LABEL: load_global_index:
; R5900:       # %bb.0: # %entry
; R5900-NEXT:    lui $1, %hi(ram)
; R5900-NEXT:    andi $2, $4, 65535
; R5900-NEXT:    addiu $1, $1, %lo(ram)
; R5900-NEXT:    addu $1, $1, $2
; R5900-NEXT:    jr $ra
; R5900-NEXT:    lbu $2, 0($1)
entry:
  %idx = and i32 %i, 65535
  %p = getelementptr inbounds [65536 x i8], ptr @ram, i32 0, i32 %idx
  %v = load i8, ptr %p, align 1
  ret i8 %v
}

; A load through a pointer argument has no identified object: the filler
; keeps it out of the delay slot.
define i32 @load_argument(ptr %p, i32 signext %i) nounwind {
; MIPS32-LABEL: load_argument:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    sll $1, $5, 2
; MIPS32-NEXT:    addu $1, $4, $1
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    lw $2, 0($1)
;
; R5900-LABEL: load_argument:
; R5900:       # %bb.0: # %entry
; R5900-NEXT:    sll $1, $4, 0
; R5900-NEXT:    sll $2, $5, 2
; R5900-NEXT:    addu $1, $1, $2
; R5900-NEXT:    jr $ra
; R5900-NEXT:    lw $2, 0($1)
entry:
  %q = getelementptr inbounds i32, ptr %p, i32 %i
  %v = load i32, ptr %q, align 4
  ret i32 %v
}

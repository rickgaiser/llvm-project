; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 < %s | FileCheck %s
;
; Test basic R5900 (PlayStation 2 Emotion Engine) code generation.
; R5900 is based on MIPS III with extensions:
; - Single-precision FPU only (no double precision)
; - 128-bit GPR extensions (not tested here yet)
; - No LL/SC atomic instructions

define i64 @test_add(i64 %a, i64 %b) {
; CHECK-LABEL: test_add:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddu $2, $4, $5
  %c = add i64 %a, %b
  ret i64 %c
}

; Test 64-bit multiply (R5900 has no dmult, so it expands to 32-bit mults)
define i64 @test_mul(i64 %a, i64 %b) {
; CHECK-LABEL: test_mul:
; CHECK:       # %bb.0:
; CHECK-NEXT:    dsrl $1, $5, 32
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    sll $3, $5, 0
; CHECK-NEXT:    mult $zero, $2, $1
; CHECK-NEXT:    dsrl $1, $4, 32
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    madd $1, $1, $3
; CHECK-NEXT:    multu $2, $3
; CHECK-NEXT:    mfhi $2
; CHECK-NEXT:    mflo $3
; CHECK-NEXT:    addu $1, $1, $2
; CHECK-NEXT:    dsll $2, $3, 32
; CHECK-NEXT:    dsll $1, $1, 32
; CHECK-NEXT:    dsrl $2, $2, 32
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    or $2, $2, $1
  %c = mul i64 %a, %b
  ret i64 %c
}

; Single-precision float in the FPU: with nnan ninf (without them a libcall,
; the FPU has no NaN or infinity)
define float @test_float_add(float %a, float %b) {
; CHECK-LABEL: test_float_add:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    add.s $f0, $f12, $f13
  %c = fadd nnan ninf float %a, %b
  ret float %c
}

define float @test_float_mul(float %a, float %b) {
; CHECK-LABEL: test_float_mul:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    mul.s $f0, $f12, $f13
  %c = fmul nnan ninf float %a, %b
  ret float %c
}

; Test 32-bit operations
define i32 @test_add32(i32 %a, i32 %b) {
; CHECK-LABEL: test_add32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $2, $1
  %c = add i32 %a, %b
  ret i32 %c
}

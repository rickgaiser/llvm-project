; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 < %s | FileCheck %s

; Adds and subtracts of a broadcast lane are VADDbc and VSUBbc.
define <4 x float> @broadcast_add_y(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: broadcast_add_y:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddy.xyzw $$vf1, $$vf12, $$vf13
  %splat = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %r = fadd <4 x float> %splat, %a
  ret <4 x float> %r
}

define <4 x float> @broadcast_sub_w(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: broadcast_sub_w:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vsubw.xyzw $$vf1, $$vf12, $$vf13
  %splat = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 3, i32 3, i32 3, i32 3>
  %r = fsub <4 x float> %a, %splat
  ret <4 x float> %r
}

; A subtract from a broadcast is not a VSUBbc.
define <4 x float> @broadcast_rsub_x(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: broadcast_rsub_x:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsub.xyzw $$vf1, $$vf13, $$vf13
; CHECK-NEXT:    vaddx.xyzw $$vf1, $$vf1, $$vf13
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vsub.xyzw $$vf1, $$vf1, $$vf12
  %splat = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> zeroinitializer
  %r = fsub <4 x float> %splat, %a
  ret <4 x float> %r
}

; Horizontal sums are a tree of broadcast adds into lane x.
define float @reduce_fadd(<4 x float> %v) {
; CHECK-LABEL: reduce_fadd:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vaddw.xyzw $$vf1, $$vf12, $$vf12
; CHECK-NEXT:    vaddy.xyzw $$vf2, $$vf12, $$vf12
; CHECK-NEXT:    vaddz.xyzw $$vf1, $$vf2, $$vf1
; CHECK-NEXT:    qmfc2 $1, $$vf1
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %r = call fast float @llvm.vector.reduce.fadd.v4f32(float 0.0, <4 x float> %v)
  ret float %r
}

define float @dot4(ptr %a, ptr %b) {
; CHECK-LABEL: dot4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lqc2 $$vf1, 0($4)
; CHECK-NEXT:    lqc2 $$vf2, 0($5)
; CHECK-NEXT:    vmul.xyzw $$vf1, $$vf1, $$vf2
; CHECK-NEXT:    vaddw.xyzw $$vf2, $$vf1, $$vf1
; CHECK-NEXT:    vaddy.xyzw $$vf1, $$vf1, $$vf1
; CHECK-NEXT:    vaddz.xyzw $$vf1, $$vf1, $$vf2
; CHECK-NEXT:    qmfc2 $1, $$vf1
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %x = load <4 x float>, ptr %a, align 16
  %y = load <4 x float>, ptr %b, align 16
  %m = fmul fast <4 x float> %x, %y
  %r = call fast float @llvm.vector.reduce.fadd.v4f32(float 0.0, <4 x float> %m)
  ret float %r
}

; The form instcombine makes of m[0] + m[1] + m[2] + m[3].
define float @sum_chain(<4 x float> %m) {
; CHECK-LABEL: sum_chain:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vaddw.xyzw $$vf1, $$vf12, $$vf12
; CHECK-NEXT:    vaddy.xyzw $$vf2, $$vf12, $$vf12
; CHECK-NEXT:    vaddz.xyzw $$vf1, $$vf2, $$vf1
; CHECK-NEXT:    qmfc2 $1, $$vf1
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %s1 = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 1, i32 poison, i32 poison, i32 poison>
  %a1 = fadd fast <4 x float> %m, %s1
  %s2 = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 2, i32 poison, i32 poison, i32 poison>
  %a2 = fadd fast <4 x float> %a1, %s2
  %s3 = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 3, i32 poison, i32 poison, i32 poison>
  %a3 = fadd fast <4 x float> %a2, %s3
  %r = extractelement <4 x float> %a3, i64 0
  ret float %r
}


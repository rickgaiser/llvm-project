    $r2 = LW killed $r1, 8
    PseudoReturn undef $r31, implicit $r2
...
---
name:            no_fold_sum_used
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4
    ; CHECK-LABEL: name: no_fold_sum_used
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDiu $r4, 72
    ; CHECK-NEXT: $r2 = LW $r1, 0
    ; CHECK-NEXT: $r3 = ADDu killed $r1, $r2
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3
    $r1 = ADDiu $r4, 72
    $r2 = LW $r1, 0
    $r3 = ADDu killed $r1, $r2
    PseudoReturn undef $r31, implicit $r2, implicit $r3
...
---
name:            no_fold_live_out
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: no_fold_live_out
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r3 = ADDiu $r4, 72
  ; CHECK-NEXT:   $r2 = LW $r3, 0
  ; CHECK-NEXT:   B %bb.1, implicit-def $r1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r2, $r3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r5 = LW killed $r3, 4
  ; CHECK-NEXT:   PseudoReturn undef $r31, implicit $r2, implicit $r5
  bb.0:
    successors: %bb.1
    liveins: $r4
    $r3 = ADDiu $r4, 72
    $r2 = LW $r3, 0
    B %bb.1, implicit-def $r1

  bb.1:
    liveins: $r2, $r3
    $r5 = LW killed $r3, 4
    PseudoReturn undef $r31, implicit $r2, implicit $r5
...

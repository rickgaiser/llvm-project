# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi=n32 -run-pass=mips-fold-address-offset -verify-machineinstrs %s -o - | FileCheck %s

# The register allocator rematerializes an address add before each load or
# store that uses it; the add is folded into their offsets.

--- |
  define void @fold_load_store() { ret void }
  define void @fold_two_uses() { ret void }
  define void @fold_through_addu() { ret void }
  define void @fold_through_addu_same_reg() { ret void }
  define void @no_fold_stored() { ret void }
  define void @no_fold_src_redefined() { ret void }
  define void @no_fold_offset_overflow() { ret void }
  define void @no_fold_sum_used() { ret void }
  define void @no_fold_live_out() { ret void }
...
---
name:            fold_load_store
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: fold_load_store
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = LW $r4, 76
    ; CHECK-NEXT: SW $r5, $r4, 80
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2
    $r1 = ADDiu $r4, 72
    $r2 = LW killed $r1, 4
    $r1 = ADDiu $r4, 80
    SW $r5, killed $r1, 0
    PseudoReturn undef $r31, implicit $r2
...
---
name:            fold_two_uses
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4
    ; CHECK-LABEL: name: fold_two_uses
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = LBu $r4, 65
    ; CHECK-NEXT: $r3 = LHu $r4, 66
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2, implicit $r3
    $r1 = ADDiu killed $r4, 64
    $r2 = LBu $r1, 1
    $r3 = LHu killed $r1, 2
    PseudoReturn undef $r31, implicit $r2, implicit $r3
...
---
name:            fold_through_addu
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5
    ; CHECK-LABEL: name: fold_through_addu
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDu $r4, killed $r5
    ; CHECK-NEXT: $r2 = LW killed $r1, 120
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2
    $r3 = ADDiu $r4, 120
    $r1 = ADDu killed $r3, killed $r5
    $r2 = LW killed $r1, 0
    PseudoReturn undef $r31, implicit $r2
...
---
# The sum is in the register of the add: its load keeps the sum as its base.
name:            fold_through_addu_same_reg
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3, $r5
    ; CHECK-LABEL: name: fold_through_addu_same_reg
    ; CHECK: liveins: $r3, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDu killed $r5, $r3
    ; CHECK-NEXT: $f0 = LWC1 killed $r1, 424
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $f0
    $r1 = ADDiu killed $r3, 280
    $r1 = ADDu killed $r5, killed $r1
    $f0 = LWC1 killed $r1, 144
    PseudoReturn undef $r31, implicit $f0
...
---
name:            no_fold_stored
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4
    ; CHECK-LABEL: name: no_fold_stored
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDiu $r4, 72
    ; CHECK-NEXT: SW killed $r1, $r4, 0
    ; CHECK-NEXT: PseudoReturn undef $r31
    $r1 = ADDiu $r4, 72
    SW killed $r1, $r4, 0
    PseudoReturn undef $r31
...
---
name:            no_fold_src_redefined
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4
    ; CHECK-LABEL: name: no_fold_src_redefined
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = ADDiu $r4, 72
    ; CHECK-NEXT: $r4 = ADDiu $r4, 4
    ; CHECK-NEXT: $r2 = LW killed $r1, 0
    ; CHECK-NEXT: PseudoReturn undef $r31, implicit $r2
    $r1 = ADDiu $r4, 72
    $r4 = ADDiu $r4, 4
    $r2 = LW killed $r1, 0
    PseudoReturn undef $r31, implicit $r2
...
---

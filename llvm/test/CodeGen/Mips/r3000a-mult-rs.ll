; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mipsel-none-elf -mcpu=r3000a -O2 < %s | FileCheck %s

; The multiplier stops early by the size of rs: the operand known to be the
; smaller goes there.

define i32 @small_rhs(i32 %a, ptr %p) {
; CHECK-LABEL: small_rhs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lh $1, 0($5)
; CHECK-NEXT:    nop
; CHECK-NEXT:    mult $1, $4
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %v = load i16, ptr %p
  %s = sext i16 %v to i32
  %m = mul i32 %a, %s
  ret i32 %m
}

define i32 @small_lhs(i32 %a, ptr %p) {
; CHECK-LABEL: small_lhs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lh $1, 0($5)
; CHECK-NEXT:    nop
; CHECK-NEXT:    mult $1, $4
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %v = load i16, ptr %p
  %s = sext i16 %v to i32
  %m = mul i32 %s, %a
  ret i32 %m
}

; For multu size is the leading zeros: the constant has none, x stays in rs.
define i32 @div10(i32 %x) {
; CHECK-LABEL: div10:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, 52428
; CHECK-NEXT:    ori $1, $1, 52429
; CHECK-NEXT:    multu $4, $1
; CHECK-NEXT:    mfhi $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    srl $2, $1, 3
  %r = udiv i32 %x, 10
  ret i32 %r
}

define i32 @mulhu_small(i32 %a, i16 zeroext %b) {
; CHECK-LABEL: mulhu_small:
; CHECK:       # %bb.0:
; CHECK-NEXT:    multu $5, $4
; CHECK-NEXT:    mfhi $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %a64 = zext i32 %a to i64
  %b64 = zext i16 %b to i64
  %m = mul i64 %a64, %b64
  %h = lshr i64 %m, 32
  %t = trunc i64 %h to i32
  ret i32 %t
}

; A cross product written with shuffles of vectors is VOPMULA.xyz acc, a, b
; and VOPMSUB.xyz d, b, a, when field w of the result is replaced or
; undefined: 2 instructions instead of 4 shuffles through the GPRs.

define <4 x float> @cross_w0(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: cross_w0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vopmula.xyz $acc, $vf12, $vf13
; CHECK-NEXT:    lui $1, %hi(.LCPI0_0)
; CHECK-NEXT:    vopmsub.xyz $vf1, $vf13, $vf12
; CHECK-NEXT:    lqc2 $vf2, %lo(.LCPI0_0)($1)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vmove.w $vf1, $vf2
  %a1 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 3>
  %b2 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 3>
  %a2 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 3>
  %b1 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 3>
  %m1 = fmul fast <4 x float> %a1, %b2
  %m2 = fmul fast <4 x float> %a2, %b1
  %c = fsub fast <4 x float> %m1, %m2
  %r = insertelement <4 x float> %c, float 0.0, i32 3
  ret <4 x float> %r
}

define <4 x float> @cross_wundef(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: cross_wundef:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vopmula.xyz $acc, $vf12, $vf13
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vopmsub.xyz $vf1, $vf13, $vf12
  %a1 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 poison>
  %b2 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 poison>
  %a2 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 poison>
  %b1 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 poison>
  %m1 = fmul fast <4 x float> %b2, %a1

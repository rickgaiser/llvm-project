; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mipsel-unknown-elf -mcpu=r3000a -mattr=+noabicalls -relocation-model=static -O2 < %s | FileCheck %s

; MIPS I needs two instructions between an mflo or mfhi and the next instruction
; that writes HI or LO, or an exception that restarts the mflo reads the new value.

; A signed multiply after one instruction.
define i32 @mult_after_one(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: mult_after_one:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mult $4, $5
; CHECK-NEXT:    mflo $1
; CHECK-NEXT:    addu $1, $1, $6
; CHECK-NEXT:    nop
; CHECK-NEXT:    mult $1, $5
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %m = mul i32 %x, %y
  %n = add i32 %m, %z
  %p = mul i32 %n, %y
  ret i32 %p
}

; An unsigned multiply after one instruction.
define i32 @multu_after_one(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: multu_after_one:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mult $4, $5
; CHECK-NEXT:    mflo $1
; CHECK-NEXT:    addu $1, $1, $6
; CHECK-NEXT:    nop
; CHECK-NEXT:    multu $1, $5
; CHECK-NEXT:    mfhi $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %m = mul i32 %x, %y
  %n = add i32 %m, %z
  %a = zext i32 %n to i64
  %b = zext i32 %y to i64
  %p = mul i64 %a, %b
  %h = lshr i64 %p, 32
  %r = trunc i64 %h to i32
  ret i32 %r
}

; A multiply in the delay slot of the branch after the mflo.
define i32 @mult_in_delay_slot(i32 %x, i32 %y, i1 %c) {
; CHECK-LABEL: mult_in_delay_slot:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mult $4, $5
; CHECK-NEXT:    andi $1, $6, 1
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    nop
; CHECK-NEXT:    beqz $1, $BB2_2
; CHECK-NEXT:    mult $2, $4
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:  $BB2_2: # %e
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %m = mul i32 %x, %y
  br i1 %c, label %t, label %e
t:
  %p = mul i32 %m, %x
  ret i32 %p
e:
  ret i32 %m
}

; mfhi and mflo after each other: the distance counts from the last one.
define i64 @mult_after_two_reads(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: mult_after_two_reads:
; CHECK:       # %bb.0:
; CHECK-NEXT:    multu $4, $5
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    addu $3, $2, $6
; CHECK-NEXT:    mfhi $1
; CHECK-NEXT:    nop
; CHECK-NEXT:    nop
; CHECK-NEXT:    multu $3, $5
; CHECK-NEXT:    mflo $3
; CHECK-NEXT:    addu $2, $3, $2
; CHECK-NEXT:    mfhi $4
; CHECK-NEXT:    addu $1, $4, $1
; CHECK-NEXT:    sltu $3, $2, $3
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $3, $1, $3
  %a = zext i32 %x to i64
  %b = zext i32 %y to i64
  %m = mul i64 %a, %b
  %l = trunc i64 %m to i32
  %n = add i32 %l, %z
  %q = zext i32 %n to i64
  %p = mul i64 %q, %b
  %s = add i64 %p, %m
  ret i64 %s
}

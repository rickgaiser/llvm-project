; OFF-NEXT:  .LBB0_1: # %loop
; OFF-NEXT:    # =>This Inner Loop Header: Depth=1
; OFF-NEXT:    lwc1 $f1, 0($4)
; OFF-NEXT:    addiu $2, $2, -1
; OFF-NEXT:    lwc1 $f2, 0($3)
; OFF-NEXT:    addiu $3, $3, 4
; OFF-NEXT:    addiu $4, $4, 4
; OFF-NEXT:    mul.s $f1, $f1, $f2

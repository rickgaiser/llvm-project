; OFF-NEXT:    vmadda.xyzw $acc, $vf3, $vf3
; OFF-NEXT:    bnez $3, .LBB5_4
; OFF-NEXT:    vmaddw.xyzw $vf1, $vf1, $vf0
; OFF-NEXT:  .LBB5_5: # %exit
; OFF-NEXT:    jr $ra
; OFF-NEXT:    sqc2 $vf1, 0($2)
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %s = phi <4 x float> [ zeroinitializer, %entry ], [ %s2, %loop ]
  %pa = getelementptr <4 x float>, ptr %a, i32 %i
  %pb = getelementptr <4 x float>, ptr %b, i32 %i
  %x = load <4 x float>, ptr %pa
  %y = load <4 x float>, ptr %pb
  %m0 = fmul reassoc nnan ninf <4 x float> %x, %y
  %m1 = fmul reassoc nnan ninf <4 x float> %y, %y
  %t = fadd reassoc nnan ninf <4 x float> %m0, %m1
  %s2 = fadd reassoc nnan ninf <4 x float> %t, %s
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  store <4 x float> %s2, ptr %out
  ret void
}

; MMI: sums of 16-bit products, PMADDH on HI and LO, which are read once
; after the loop.
define <8 x i32> @mmi_dot(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: mmi_dot:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $3, $7, 0
; CHECK-NEXT:    sll $4, $6, 0
; CHECK-NEXT:    sll $5, $5, 0
; CHECK-NEXT:    pmtlo $zero
; CHECK-NEXT:    pmthi $zero
; CHECK-NEXT:    .p2align 3
; CHECK-NEXT:  .LBB6_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lq $1, 0($5)
; CHECK-NEXT:    addiu $3, $3, -1
; CHECK-NEXT:    lq $6, 0($4)
; CHECK-NEXT:    addiu $4, $4, 16
; CHECK-NEXT:    addiu $5, $5, 16
; CHECK-NEXT:    bnez $3, .LBB6_1
; CHECK-NEXT:    pmaddh $1, $1, $6
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    pmflo $1
; CHECK-NEXT:    pmfhi $3
; CHECK-NEXT:    pcpyld $4, $3, $1
; CHECK-NEXT:    sq $4, 0($2)
; CHECK-NEXT:    pcpyud $1, $1, $3
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sq $1, 16($2)
;
; OFF-LABEL: mmi_dot:
; OFF:       # %bb.0: # %entry
; OFF-NEXT:    por $2, $zero, $zero
; OFF-NEXT:    sll $4, $4, 0
; OFF-NEXT:    sll $7, $7, 0
; OFF-NEXT:    por $3, $zero, $zero
; OFF-NEXT:    sll $6, $6, 0
; OFF-NEXT:    sll $5, $5, 0
; OFF-NEXT:    .p2align 3
; OFF-NEXT:  .LBB6_1: # %loop
; OFF-NEXT:    # =>This Inner Loop Header: Depth=1
; OFF-NEXT:    lq $1, 0($5)
; OFF-NEXT:    addiu $7, $7, -1
; OFF-NEXT:    lq $8, 0($6)
; OFF-NEXT:    addiu $6, $6, 16
; OFF-NEXT:    addiu $5, $5, 16
; OFF-NEXT:    pmulth $1, $1, $8
; OFF-NEXT:    pmflo $1
; OFF-NEXT:    pmfhi $8
; OFF-NEXT:    pcpyld $9, $8, $1
; OFF-NEXT:    pcpyud $1, $1, $8
; OFF-NEXT:    paddw $3, $3, $1
; OFF-NEXT:    bnez $7, .LBB6_1
; OFF-NEXT:    paddw $2, $2, $9
; OFF-NEXT:  # %bb.2: # %exit
; OFF-NEXT:    sq $2, 0($4)
; OFF-NEXT:    jr $ra
; OFF-NEXT:    sq $3, 16($4)
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %s = phi <8 x i32> [ zeroinitializer, %entry ], [ %s1, %loop ]
  %pa = getelementptr <8 x i16>, ptr %a, i32 %i
  %pb = getelementptr <8 x i16>, ptr %b, i32 %i
  %x = load <8 x i16>, ptr %pa
  %y = load <8 x i16>, ptr %pb
  %xw = sext <8 x i16> %x to <8 x i32>
  %yw = sext <8 x i16> %y to <8 x i32>
  %m = mul <8 x i32> %xw, %yw
  %s1 = add <8 x i32> %s, %m
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret <8 x i32> %s1
}

  %shift = and i32 %shl, 8
  %and = and i32 %a, 16777215
  %shr = lshr i32 %and, 20
  switch i32 %shr, label %return [
    i32 1, label %ram
    i32 2, label %sw.a
    i32 3, label %sw.b
    i32 4, label %sw.c
    i32 8, label %sw.d
    i32 13, label %sw.e

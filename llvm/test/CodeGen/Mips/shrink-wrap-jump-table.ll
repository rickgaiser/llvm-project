  %ca = tail call zeroext i16 @slow_a(i32 signext %a.1)
  %ca.32 = zext i16 %ca to i32
  %ca.sh = lshr i32 %ca.32, %shift
  %ca.8 = trunc i32 %ca.sh to i8
  br label %return


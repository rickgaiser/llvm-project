; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 < %s | FileCheck %s

; A v4f32 is built in a 128-bit GPR, with PEXTLW and PCPYLD or as a splat,
; and moved to VU0 with QMTC2. An element is inserted with a VMOVE of its
; field.

define <4 x float> @build(float %a, float %b, float %c, float %d) {
; CHECK-LABEL: build:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mfc1 $1, $f15
; CHECK-NEXT:    mfc1 $2, $f13
; CHECK-NEXT:    mfc1 $3, $f12
; CHECK-NEXT:    mfc1 $4, $f14
; CHECK-NEXT:    pextlw $2, $2, $3
; CHECK-NEXT:    pextlw $1, $1, $4
; CHECK-NEXT:    pcpyld $1, $1, $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    qmtc2 $1, $vf1
  %1 = insertelement <4 x float> poison, float %a, i32 0
  %2 = insertelement <4 x float> %1, float %b, i32 1
  %3 = insertelement <4 x float> %2, float %c, i32 2
  %4 = insertelement <4 x float> %3, float %d, i32 3
  ret <4 x float> %4
}

define <4 x float> @build_loads(ptr %p) {
; CHECK-LABEL: build_loads:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    lw $2, 0($1)
; CHECK-NEXT:    lw $3, 16($1)
; CHECK-NEXT:    pextlw $2, $3, $2
; CHECK-NEXT:    lw $3, 32($1)
; CHECK-NEXT:    lw $1, 48($1)
; CHECK-NEXT:    pextlw $1, $1, $3
; CHECK-NEXT:    pcpyld $1, $1, $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    qmtc2 $1, $vf1
  %a = load float, ptr %p
  %q1 = getelementptr float, ptr %p, i32 4
  %b = load float, ptr %q1
  %q2 = getelementptr float, ptr %p, i32 8
  %c = load float, ptr %q2
  %q3 = getelementptr float, ptr %p, i32 12
  %d = load float, ptr %q3
  %1 = insertelement <4 x float> poison, float %a, i32 0
  %2 = insertelement <4 x float> %1, float %b, i32 1
  %3 = insertelement <4 x float> %2, float %c, i32 2
  %4 = insertelement <4 x float> %3, float %d, i32 3
  ret <4 x float> %4
}


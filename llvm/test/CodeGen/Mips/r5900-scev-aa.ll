; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; The R5900 schedulers use SCEV based alias analysis: the stores to out[i]
; and the loads from pal[idx[i]] are in one object, but the loop count keeps
; them apart, so the loads of a pixel move above the store of the previous
; one.

%struct.mem = type { [256 x i32], [256 x i8], [256 x i32] }
@mem = internal global %struct.mem zeroinitializer, align 16

define void @lookup() {
; CHECK-LABEL: lookup:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lui $1, %hi(mem)
; CHECK-NEXT:    addiu $1, $1, %lo(mem)
; CHECK-NEXT:    addiu $2, $1, 4
; CHECK-NEXT:    addiu $3, $1, 1025
; CHECK-NEXT:    addiu $4, $1, 1280
; CHECK-NEXT:    addiu $5, $1, 1028
; CHECK-NEXT:    .p2align 3
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lbu $1, -1($3)
; CHECK-NEXT:    lbu $6, 0($3)
; CHECK-NEXT:    sll $1, $1, 2
; CHECK-NEXT:    nop
; CHECK-NEXT:    sll $6, $6, 2
; CHECK-NEXT:    addu $1, $4, $1
; CHECK-NEXT:    addu $6, $4, $6
; CHECK-NEXT:    lw $1, 0($1)
; CHECK-NEXT:    lw $6, 0($6)
; CHECK-NEXT:    sw $1, -4($2)
; CHECK-NEXT:    sw $6, 0($2)
; CHECK-NEXT:    addiu $2, $2, 8
; CHECK-NEXT:    bne $2, $5, .LBB0_1
; CHECK-NEXT:    addiu $3, $3, 2
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pi0 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 1, i32 %i
  %x0 = load i8, ptr %pi0, align 2
  %e0 = zext i8 %x0 to i32
  %pp0 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 2, i32 %e0
  %v0 = load i32, ptr %pp0, align 4
  %po0 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 0, i32 %i
  store i32 %v0, ptr %po0, align 8
  %i1 = or disjoint i32 %i, 1
  %pi1 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 1, i32 %i1
  %x1 = load i8, ptr %pi1, align 1
  %e1 = zext i8 %x1 to i32
  %pp1 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 2, i32 %e1
  %v1 = load i32, ptr %pp1, align 4
  %po1 = getelementptr inbounds %struct.mem, ptr @mem, i32 0, i32 0, i32 %i1
  store i32 %v1, ptr %po1, align 4
  %i.next = add nuw nsw i32 %i, 2
  %done = icmp eq i32 %i.next, 256
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

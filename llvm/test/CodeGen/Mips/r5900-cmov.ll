; RUN: llc -mtriple=mips64el -mcpu=r5900 < %s | FileCheck %s

; The R5900 supports the MIPS IV integer conditional moves (MOVN/MOVZ), so
; integer selects should not need branches. FP selects still use branches as
; the R5900 has no MOVN.S/MOVZ.S.

define i32 @select_ne_zero(i32 signext %c, i32 signext %a, i32 signext %b) {
; CHECK-LABEL: select_ne_zero:
; CHECK:       # %bb.0:
; CHECK-NEXT:    move $2, $6
; CHECK-NEXT:    # kill: def $r2 killed $r2 killed $r2_64
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    movn $2, $5, $4
  %cmp = icmp ne i32 %c, 0
  %r = select i1 %cmp, i32 %a, i32 %b
  ret i32 %r
}

define i32 @select_eq_zero(i32 signext %c, i32 signext %a, i32 signext %b) {
; CHECK-LABEL: select_eq_zero:
; CHECK:       # %bb.0:
; CHECK-NEXT:    move $2, $6
; CHECK-NEXT:    # kill: def $r2 killed $r2 killed $r2_64
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    movz $2, $5, $4
  %cmp = icmp eq i32 %c, 0
  %r = select i1 %cmp, i32 %a, i32 %b

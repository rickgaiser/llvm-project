# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64-mti-linux-gnu %s -o - -start-before mips-delay-slot-filler -stop-after mips-branch-expansion | FileCheck %s

# The padding before an aligned block, such as an R5900 loop header, counts
# toward the offset of a branch over it. The branch is in range without the
# padding.

--- |
  define i64 @aligned_target(i64 %a, i64 %b) {
    %cmp = icmp eq i64 %a, %b
    br i1 %cmp, label %iftrue, label %tail

  iftrue:
    call void asm sideeffect ".space 131052", ""()
    ret i64 1

  tail:
    ret i64 0
  }

  define i64 @unaligned_target(i64 %a, i64 %b) {
    %cmp = icmp eq i64 %a, %b
    br i1 %cmp, label %iftrue, label %tail

  iftrue:
    call void asm sideeffect ".space 131052", ""()
    ret i64 1

  tail:
    ret i64 0
  }

...
---
name:            aligned_target
alignment:       8
tracksRegLiveness: true
liveins:
  - { reg: '$r4_64', virtual-reg: '' }
body:             |
  ; CHECK-LABEL: name: aligned_target
  ; CHECK: bb.0 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r4_64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE64 $r4_64, $r0_64, %bb.2, implicit-def $r1 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (%ir-block.0):
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   J %bb.3, implicit-def $r1 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.iftrue:
  ; CHECK-NEXT:   INLINEASM &".space 131052", sideeffect attdialect
  ; CHECK-NEXT:   PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
  ; CHECK-NEXT:     $r2_64 = DADDiu $r0_64, 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.tail (align 16):
  ; CHECK-NEXT:   PseudoReturn64 undef $r31_64, implicit killed $r2_64 {
  ; CHECK-NEXT:     $r2_64 = DADDiu $r0_64, 0
  ; CHECK-NEXT:   }
  bb.0 (%ir-block.0):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4_64

    BEQ64 killed renamable $r4_64, $r0_64, %bb.2, implicit-def $r1

  bb.1.iftrue:
    INLINEASM &".space 131052", sideeffect attdialect
    $r2_64 = DADDiu $r0_64, 1
    PseudoReturn64 undef $r31_64, implicit killed $r2_64

  bb.2.tail (align 16):
    $r2_64 = DADDiu $r0_64, 0
    PseudoReturn64 undef $r31_64, implicit killed $r2_64

...

# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 \
# RUN:   -run-pass=post-ra-pseudos -verify-machineinstrs -o - %s | FileCheck %s

# The VU0 ACC is a register class of its own; the register allocator can move
# an ACC value to a VF register and back (MipsSEInstrInfo::copyPhysReg):
# VMULAw.xyzw acc, s, vf0w (1.0 in ft is exact) and VMSUBx.xyzw d, vf0, vf0x.

---
name: copies
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1

    ; CHECK-LABEL: name: copies
    ; CHECK: liveins: $vf1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vu0acc = VMULAbcw_V 15, killed $vf1, $vf0
    ; CHECK-NEXT: $vf2 = VMSUBbcx_V killed $vu0acc, 15, $vf0, $vf0
    ; CHECK-NEXT: PseudoReturn64 undef $r31_64, implicit $vf2
    $vu0acc = COPY killed $vf1
    $vf2 = COPY killed $vu0acc
    RetRA implicit $vf2
...

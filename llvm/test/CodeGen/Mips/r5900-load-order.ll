; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 < %s | FileCheck %s

; The R5900 fills a missing cache line in the order of its words, so the
; loads from the same base are kept in ascending offset order. A scalarized
; vector load would otherwise be read descending.

define void @saxpy8(ptr %x, ptr %y, float %a) {
; CHECK-LABEL: saxpy8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    sll $2, $5, 0
; CHECK-NEXT:    lwc1 $f1, 0($1)
; CHECK-NEXT:    lwc1 $f2, 4($1)
; CHECK-NEXT:    lwc1 $f3, 8($1)
; CHECK-NEXT:    lwc1 $f4, 12($1)
; CHECK-NEXT:    lwc1 $f5, 16($1)
; CHECK-NEXT:    lwc1 $f6, 20($1)
; CHECK-NEXT:    lwc1 $f0, 24($1)
; CHECK-NEXT:    lwc1 $f7, 28($1)
; CHECK-NEXT:    mul.s $f6, $f14, $f6
; CHECK-NEXT:    mul.s $f7, $f14, $f7
; CHECK-NEXT:    mul.s $f5, $f14, $f5
; CHECK-NEXT:    mul.s $f4, $f14, $f4
; CHECK-NEXT:    mul.s $f0, $f14, $f0
; CHECK-NEXT:    mul.s $f1, $f14, $f1
; CHECK-NEXT:    mul.s $f2, $f14, $f2
; CHECK-NEXT:    mul.s $f3, $f14, $f3
; CHECK-NEXT:    lwc1 $f15, 0($2)
; CHECK-NEXT:    lwc1 $f13, 4($2)
; CHECK-NEXT:    lwc1 $f12, 8($2)
; CHECK-NEXT:    lwc1 $f11, 12($2)
; CHECK-NEXT:    lwc1 $f10, 16($2)
; CHECK-NEXT:    lwc1 $f9, 20($2)
; CHECK-NEXT:    lwc1 $f16, 24($2)
; CHECK-NEXT:    lwc1 $f8, 28($2)
; CHECK-NEXT:    add.s $f0, $f0, $f16
; CHECK-NEXT:    add.s $f1, $f1, $f15
; CHECK-NEXT:    add.s $f2, $f2, $f13
; CHECK-NEXT:    add.s $f7, $f7, $f8
; CHECK-NEXT:    add.s $f6, $f6, $f9
; CHECK-NEXT:    add.s $f5, $f5, $f10
; CHECK-NEXT:    add.s $f4, $f4, $f11
; CHECK-NEXT:    add.s $f3, $f3, $f12
; CHECK-NEXT:    swc1 $f7, 28($2)
; CHECK-NEXT:    swc1 $f6, 20($2)
; CHECK-NEXT:    swc1 $f5, 16($2)
; CHECK-NEXT:    swc1 $f4, 12($2)
; CHECK-NEXT:    swc1 $f3, 8($2)
; CHECK-NEXT:    swc1 $f2, 4($2)
; CHECK-NEXT:    swc1 $f1, 0($2)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    swc1 $f0, 24($2)
  %vx = load <8 x float>, ptr %x, align 4
  %vy = load <8 x float>, ptr %y, align 4
  %ins = insertelement <8 x float> poison, float %a, i32 0
  %va = shufflevector <8 x float> %ins, <8 x float> poison, <8 x i32> zeroinitializer
  %m = fmul nnan ninf <8 x float> %va, %vx
  %r = fadd nnan ninf <8 x float> %m, %vy
  store <8 x float> %r, ptr %y, align 4
  ret void
}

; The load of offset 0 defines the base register, so it stays after the other
; loads, which are ascending.
define i32 @sum4(ptr %p) {
; CHECK-LABEL: sum4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    lw $4, 4($1)
; CHECK-NEXT:    lw $3, 8($1)
; CHECK-NEXT:    lw $2, 12($1)
; CHECK-NEXT:    lw $1, 0($1)
; CHECK-NEXT:    addu $2, $2, $3
; CHECK-NEXT:    addu $1, $4, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $2, $1
  %p1 = getelementptr i8, ptr %p, i32 4
  %p2 = getelementptr i8, ptr %p, i32 8
  %p3 = getelementptr i8, ptr %p, i32 12
  %a = load i32, ptr %p3
  %b = load i32, ptr %p2
  %c = load i32, ptr %p1
  %d = load i32, ptr %p
  %s1 = add i32 %a, %b
  %s2 = add i32 %c, %d
  %s = add i32 %s1, %s2
  ret i32 %s
}

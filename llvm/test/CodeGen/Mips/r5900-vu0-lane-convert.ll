; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; VU0: the conversion to an integer of fields of a vector after ops with
; constants, as the channels of a color, is the same ops and VFTOI0 on the
; vector (one VMINI, VMUL and VFTOI0 for the three fields) and the integers
; from QMFC2, instead of each field through the FPU.

define i32 @pack_rgb(<4 x float> %c) {
; CHECK-LABEL: pack_rgb:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, %hi(.LCPI0_0)
; CHECK-NEXT:    lqc2 $vf1, %lo(.LCPI0_0)($1)
; CHECK-NEXT:    lui $1, %hi(.LCPI0_1)
; CHECK-NEXT:    vmini.xyzw $vf1, $vf12, $vf1
; CHECK-NEXT:    lqc2 $vf2, %lo(.LCPI0_1)($1)
; CHECK-NEXT:    vmul.xyzw $vf1, $vf1, $vf2
; CHECK-NEXT:    vftoi0.xyzw $vf1, $vf1
; CHECK-NEXT:    qmfc2 $1, $vf1
; CHECK-NEXT:    dsrl $2, $1, 32
; CHECK-NEXT:    sll $3, $1, 0
; CHECK-NEXT:    sll $2, $2, 0
; CHECK-NEXT:    pcpyud $1, $1, $1
; CHECK-NEXT:    sll $2, $2, 8
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    or $2, $3, $2
; CHECK-NEXT:    sll $1, $1, 16
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    or $2, $2, $1
  %r = extractelement <4 x float> %c, i64 0
  %rm = call fast float @llvm.minnum.f32(float %r, float 1.0)
  %rs = fmul fast float %rm, 128.0
  %ri = fptoui float %rs to i32
  %g = extractelement <4 x float> %c, i64 1
  %gm = call fast float @llvm.minnum.f32(float %g, float 1.0)
  %gs = fmul fast float %gm, 128.0
  %gi = fptoui float %gs to i32
  %b = extractelement <4 x float> %c, i64 2
  %bm = call fast float @llvm.minnum.f32(float %b, float 1.0)
  %bs = fmul fast float %bm, 128.0
  %bi = fptoui float %bs to i32
  %g8 = shl i32 %gi, 8
  %b16 = shl i32 %bi, 16
  %o1 = or i32 %ri, %g8
  %o2 = or i32 %o1, %b16
  ret i32 %o2
}

; One field, an fsub and an fadd with the constant first.
define i32 @one_field(<4 x float> %v) {
; CHECK-LABEL: one_field:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, %hi(.LCPI1_0)
; CHECK-NEXT:    lqc2 $vf1, %lo(.LCPI1_0)($1)
; CHECK-NEXT:    vadd.xyzw $vf1, $vf12, $vf1
; CHECK-NEXT:    vftoi0.xyzw $vf1, $vf1
; CHECK-NEXT:    qmfc2 $1, $vf1
; CHECK-NEXT:    pcpyud $1, $1, $1
; CHECK-NEXT:    dsrl $1, $1, 32
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sll $2, $1, 0
  %x = extractelement <4 x float> %v, i64 3
  %s = fsub fast float %x, 2.0
  %a = fadd fast float 0.5, %s
  %i = fptosi float %a to i32
  ret i32 %i
}

; The value of an op used twice: through the FPU.
define i32 @two_uses(<4 x float> %v, ptr %p) {
; CHECK-LABEL: two_uses:
; CHECK:       # %bb.0:
; CHECK-NEXT:    qmfc2 $1, $vf12
; CHECK-NEXT:    dsrl32 $1, $1, 0
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    lui $1, %hi(.LCPI2_0)
; CHECK-NEXT:    lwc1 $f1, %lo(.LCPI2_0)($1)
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    mul.s $f0, $f0, $f1
; CHECK-NEXT:    cvt.w.s $f1, $f0
; CHECK-NEXT:    mfc1 $2, $f1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    swc1 $f0, 0($1)
  %x = extractelement <4 x float> %v, i64 1
  %m = fmul fast float %x, 3.0
  store float %m, ptr %p
  %i = fptosi float %m to i32
  ret i32 %i
}

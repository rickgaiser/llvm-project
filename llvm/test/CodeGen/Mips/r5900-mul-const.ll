; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; The R5900 MULT writes its GPR directly: a multiply by a constant becomes
; shifts and adds only for at most 4 of them.

; 10 = 8 + 2: shifts and an add.
define i32 @mul10(i32 %x) {
; CHECK-LABEL: mul10:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    sll $2, $1, 1
; CHECK-NEXT:    sll $1, $1, 3
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $1, $2
  %r = mul i32 %x, 10
  ret i32 %r
}

; 100 = 64 + 32 + 4 takes 5 steps: MULT.
define i32 @mul100(i32 %x) {
; CHECK-LABEL: mul100:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    addiu $2, $zero, 100
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    mult $2, $1, $2
  %r = mul i32 %x, 100
  ret i32 %r
}

; The FNV prime 16777619 = 2^24 + 403 takes more steps: MULT.
define i32 @fnv(i32 %h, i32 %w) {
; CHECK-LABEL: fnv:
; CHECK:       # %bb.0:
; CHECK-NEXT:    xor $1, $4, $5
; CHECK-NEXT:    lui $2, 256
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    ori $2, $2, 403
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    mult $2, $1, $2
  %x = xor i32 %h, %w
  %r = mul i32 %x, 16777619
  ret i32 %r
}

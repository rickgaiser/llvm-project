; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; Independent multiplies without loads or stores are limited by the pipe 0
; multiplier, so some of them use the pipe 1 multiplier (MULT1).
define i32 @mults(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: mults:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $4, $7, 0
; CHECK-NEXT:    sll $5, $6, 0
; CHECK-NEXT:    mult $3, $2, $1
; CHECK-NEXT:    mult1 $2, $2, $5
; CHECK-NEXT:    mult $6, $5, $4
; CHECK-NEXT:    mult $1, $1, $4
; CHECK-NEXT:    xor $3, $3, $6
; CHECK-NEXT:    xor $1, $2, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    xor $2, $3, $1
  %m0 = mul i32 %a, %b
  %m1 = mul i32 %c, %d
  %m2 = mul i32 %a, %c
  %m3 = mul i32 %b, %d
  %s0 = xor i32 %m0, %m1
  %s1 = xor i32 %m2, %m3
  %s = xor i32 %s0, %s1
  ret i32 %s
}

; With a load and a store for each multiply, pipe 1 is the limit and all
; multiplies stay in pipe 0.
define void @scale(ptr noalias %o, ptr noalias %p, i32 %s) {
; CHECK-LABEL: scale:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $3, $6, 0
; CHECK-NEXT:    lw $2, 0($1)
; CHECK-NEXT:    lw $5, 4($1)
; CHECK-NEXT:    lw $1, 8($1)
; CHECK-NEXT:    mult $2, $2, $3
; CHECK-NEXT:    mult $5, $5, $3
; CHECK-NEXT:    mult $1, $1, $3
; CHECK-NEXT:    sll $3, $4, 0
; CHECK-NEXT:    sw $2, 0($3)
; CHECK-NEXT:    sw $5, 4($3)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sw $1, 8($3)
  %p1 = getelementptr i32, ptr %p, i32 1
  %p2 = getelementptr i32, ptr %p, i32 2
  %o1 = getelementptr i32, ptr %o, i32 1
  %o2 = getelementptr i32, ptr %o, i32 2
  %a = load i32, ptr %p
  %b = load i32, ptr %p1
  %c = load i32, ptr %p2
  %x = mul i32 %a, %s
  %y = mul i32 %b, %s
  %z = mul i32 %c, %s
  store i32 %x, ptr %o
  store i32 %y, ptr %o1
  store i32 %z, ptr %o2
  ret void
}

; Two sums of products, each accumulated in HI and LO: the second one moves
; to HI1 and LO1 (MULT1, MADD1), so the two run in parallel.
define void @two_sums(ptr noalias %p, i32 %s, ptr noalias %r) {
; CHECK-LABEL: two_sums:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    sll $5, $5, 0
; CHECK-NEXT:    lw $2, 0($1)
; CHECK-NEXT:    lw $3, 4($1)
; CHECK-NEXT:    lw $4, 8($1)
; CHECK-NEXT:    lw $7, 12($1)
; CHECK-NEXT:    mult $zero, $2, $5
; CHECK-NEXT:    mult1 $zero, $3, $5
; CHECK-NEXT:    sll $3, $6, 0
; CHECK-NEXT:    lw $8, 16($1)
; CHECK-NEXT:    lw $1, 20($1)
; CHECK-NEXT:    madd $zero, $4, $5
; CHECK-NEXT:    madd1 $zero, $7, $5
; CHECK-NEXT:    madd $2, $8, $5
; CHECK-NEXT:    madd1 $1, $1, $5
; CHECK-NEXT:    sw $2, 0($3)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sw $1, 4($3)
  %p1 = getelementptr i8, ptr %p, i32 4
  %p2 = getelementptr i8, ptr %p, i32 8
  %p3 = getelementptr i8, ptr %p, i32 12
  %p4 = getelementptr i8, ptr %p, i32 16
  %p5 = getelementptr i8, ptr %p, i32 20
  %a0 = load i32, ptr %p
  %b0 = load i32, ptr %p1
  %a1 = load i32, ptr %p2
  %b1 = load i32, ptr %p3
  %a2 = load i32, ptr %p4
  %b2 = load i32, ptr %p5
  %ma0 = mul i32 %a0, %s
  %ma1 = mul i32 %a1, %s
  %ma2 = mul i32 %a2, %s
  %mb0 = mul i32 %b0, %s
  %mb1 = mul i32 %b1, %s
  %mb2 = mul i32 %b2, %s
  %sa1 = add i32 %ma0, %ma1
  %sa = add i32 %sa1, %ma2
  %sb1 = add i32 %mb0, %mb1
  %sb = add i32 %sb1, %mb2
  store i32 %sa, ptr %r
  %r1 = getelementptr i8, ptr %r, i32 4
  store i32 %sb, ptr %r1
  ret void
}

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; A v4f32 division divides x and y with DIV.S and z and w through VDIV, which
; runs in parallel with DIV.S: VDIV, VWAITQ (reads of Q are not interlocked)
; and a VADDQ of the field into a vector of z and w (all fields for z, from
; VF0), then x and y as a pair in a GPR and VMOVE.xy.

define <4 x float> @div(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: div:
; CHECK:       # %bb.0:
; CHECK-NEXT:    qmfc2 $1, $vf13
; CHECK-NEXT:    vdiv $Q, $vf12z, $vf13z
; CHECK-NEXT:    qmfc2 $2, $vf12
; CHECK-NEXT:    lui $3, %hi(.LCPI0_0)
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    dsrl32 $1, $1, 0
; CHECK-NEXT:    mtc1 $2, $f1
; CHECK-NEXT:    lqc2 $vf2, %lo(.LCPI0_0)($3)
; CHECK-NEXT:    div.s $f0, $f1, $f0
; CHECK-NEXT:    mtc1 $1, $f1
; CHECK-NEXT:    dsrl32 $1, $2, 0
; CHECK-NEXT:    vwaitq
; CHECK-NEXT:    mtc1 $1, $f2
; CHECK-NEXT:    vaddq.xyzw $vf1, $vf0, $Q
; CHECK-NEXT:    vdiv $Q, $vf12w, $vf13w
; CHECK-NEXT:    div.s $f1, $f2, $f1
; CHECK-NEXT:    mfc1 $1, $f0
; CHECK-NEXT:    vwaitq
; CHECK-NEXT:    mfc1 $2, $f1
; CHECK-NEXT:    vaddq.w $vf1, $vf2, $Q
; CHECK-NEXT:    pextlw $1, $2, $1
; CHECK-NEXT:    pcpyld $1, $1, $1
; CHECK-NEXT:    qmtc2 $1, $vf2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vmove.xy $vf1, $vf2
  %r = fdiv fast <4 x float> %a, %b
  ret <4 x float> %r
}

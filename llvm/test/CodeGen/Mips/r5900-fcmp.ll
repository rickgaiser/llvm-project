; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 < %s | FileCheck %s

; The R5900 FPU only has the C.F, C.EQ, C.LT and C.LE compares, the other
; condition fields are undefined. It has no NaNs, so an unordered condition is
; the same as the ordered one, and the others branch or move on the inverse of
; one of the four.

define i32 @select_false(float %a, float %b, i32 %x, i32 %y) {
; CHECK-LABEL: select_false:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sll $2, $7, 0
  %c = fcmp false float %a, %b
  %s = select i1 %c, i32 %x, i32 %y
  ret i32 %s
}


; Shuffles of 128-bit integer vectors that are MMI instructions: the even and
; odd elements (unzip), the interleaved low and high halves (zip), the low
; and high halves of two vectors, and the word permutations of PEXEW, PEXCW,
; PROT3W and a swap of the halves.

define void @even_b(ptr %pa, ptr %pb, ptr %pr) {
; CHECK-LABEL: even_b:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    sll $2, $5, 0
; CHECK-NEXT:    lq $1, 0($1)
; CHECK-NEXT:    sll $3, $6, 0
; CHECK-NEXT:    lq $2, 0($2)
; CHECK-NEXT:    ppacb $1, $2, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sq $1, 0($3)
  %a = load <16 x i8>, ptr %pa, align 16
  %b = load <16 x i8>, ptr %pb, align 16
  %r = shufflevector <16 x i8> %a, <16 x i8> %b, <16 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14, i32 16, i32 18, i32 20, i32 22, i32 24, i32 26, i32 28, i32 30>
  store <16 x i8> %r, ptr %pr, align 16
  ret void
}


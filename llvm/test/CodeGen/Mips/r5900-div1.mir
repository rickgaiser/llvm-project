# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -run-pass=mips-r5900-div1 -verify-machineinstrs -o - %s | FileCheck %s

# A divide that is independent of the previous one moves to the pipe 1
# divider, unless HI1/LO1 are written before its result is read or the result
# is read in another block.

---
name:            independent
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    ; CHECK-LABEL: name: independent
    ; CHECK: liveins: $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r7
    ; CHECK-NEXT: [[PseudoSDIV:%[0-9]+]]:acc64 = PseudoSDIV [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[PseudoMFLO:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV]]
    ; CHECK-NEXT: [[PseudoUDIV1_:%[0-9]+]]:acc64_1 = PseudoUDIV1 [[COPY2]], [[COPY3]]
    ; CHECK-NEXT: [[PseudoMFHI1_:%[0-9]+]]:gpr32 = PseudoMFHI1 [[PseudoUDIV1_]]
    ; CHECK-NEXT: [[PseudoMFLO1_:%[0-9]+]]:gpr32 = PseudoMFLO1 [[PseudoUDIV1_]]
    ; CHECK-NEXT: [[ADDu:%[0-9]+]]:gpr32 = ADDu [[PseudoMFLO]], [[PseudoMFHI1_]]
    ; CHECK-NEXT: [[ADDu1:%[0-9]+]]:gpr32 = ADDu [[ADDu]], [[PseudoMFLO1_]]
    ; CHECK-NEXT: $r2 = COPY [[ADDu1]]
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = COPY $r6
    %3:gpr32 = COPY $r7
    %4:acc64 = PseudoSDIV %0, %1
    %5:gpr32 = PseudoMFLO %4
    %6:acc64 = PseudoUDIV %2, %3
    %7:gpr32 = PseudoMFHI %6
    %8:gpr32 = PseudoMFLO %6
    %9:gpr32 = ADDu %5, %7
    %10:gpr32 = ADDu %9, %8
    $r2 = COPY %10
    RetRA implicit $r2
...
---
name:            dependent
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6

    ; CHECK-LABEL: name: dependent
    ; CHECK: liveins: $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
    ; CHECK-NEXT: [[PseudoSDIV:%[0-9]+]]:acc64 = PseudoSDIV [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[PseudoMFLO:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV]]
    ; CHECK-NEXT: [[ADDiu:%[0-9]+]]:gpr32 = ADDiu [[PseudoMFLO]], 1
    ; CHECK-NEXT: [[PseudoSDIV1:%[0-9]+]]:acc64 = PseudoSDIV [[ADDiu]], [[COPY2]]
    ; CHECK-NEXT: [[PseudoMFLO1:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV1]]
    ; CHECK-NEXT: $r2 = COPY [[PseudoMFLO1]]
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = COPY $r6
    %3:acc64 = PseudoSDIV %0, %1
    %4:gpr32 = PseudoMFLO %3
    %5:gpr32 = ADDiu %4, 1
    %6:acc64 = PseudoSDIV %5, %2
    %7:gpr32 = PseudoMFLO %6
    $r2 = COPY %7
    RetRA implicit $r2
...
---
name:            hi1_written
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    ; CHECK-LABEL: name: hi1_written
    ; CHECK: liveins: $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r7
    ; CHECK-NEXT: [[PseudoSDIV:%[0-9]+]]:acc64 = PseudoSDIV [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[PseudoMFLO:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV]]
    ; CHECK-NEXT: [[PseudoSDIV1:%[0-9]+]]:acc64 = PseudoSDIV [[COPY2]], [[COPY3]]
    ; CHECK-NEXT: MTHI1 [[COPY]], implicit-def $hi1
    ; CHECK-NEXT: [[PseudoMFLO1:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV1]]
    ; CHECK-NEXT: [[ADDu:%[0-9]+]]:gpr32 = ADDu [[PseudoMFLO]], [[PseudoMFLO1]]
    ; CHECK-NEXT: $r2 = COPY [[ADDu]]
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = COPY $r6
    %3:gpr32 = COPY $r7
    %4:acc64 = PseudoSDIV %0, %1
    %5:gpr32 = PseudoMFLO %4
    %6:acc64 = PseudoSDIV %2, %3
    MTHI1 %0, implicit-def $hi1
    %7:gpr32 = PseudoMFLO %6
    %8:gpr32 = ADDu %5, %7
    $r2 = COPY %8
    RetRA implicit $r2
...
---
name:            other_block
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: other_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5, $r6, $r7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $r4
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr32 = COPY $r7
  ; CHECK-NEXT:   [[PseudoSDIV:%[0-9]+]]:acc64 = PseudoSDIV [[COPY]], [[COPY1]]
  ; CHECK-NEXT:   [[PseudoMFLO:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV]]
  ; CHECK-NEXT:   [[PseudoSDIV1:%[0-9]+]]:acc64 = PseudoSDIV [[COPY2]], [[COPY3]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[PseudoMFLO1:%[0-9]+]]:gpr32 = PseudoMFLO [[PseudoSDIV1]]
  ; CHECK-NEXT:   [[ADDu:%[0-9]+]]:gpr32 = ADDu [[PseudoMFLO]], [[PseudoMFLO1]]
  ; CHECK-NEXT:   $r2 = COPY [[ADDu]]
  ; CHECK-NEXT:   RetRA implicit $r2
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = COPY $r6
    %3:gpr32 = COPY $r7
    %4:acc64 = PseudoSDIV %0, %1
    %5:gpr32 = PseudoMFLO %4
    %6:acc64 = PseudoSDIV %2, %3

  bb.1:
    %7:gpr32 = PseudoMFLO %6
    %8:gpr32 = ADDu %5, %7
    $r2 = COPY %8
    RetRA implicit $r2
...

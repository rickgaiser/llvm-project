; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi=n32 < %s | FileCheck %s

; VF registers named in an inline asm clobber list ($vf0-$vf31): a value that
; lives across the asm is kept in memory. Code that starts a VU0 micro program
; inline says so this way, since the program shares the VF registers.

define <4 x float> @live_across(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: live_across:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    vmul.xyzw $vf1, $vf12, $vf13
; CHECK-NEXT:    vadd.xyzw $vf1, $vf1, $vf1
; CHECK-NEXT:    sqc2 $vf1, 0($sp) # 16-byte Folded Spill
; CHECK-NEXT:    #APP
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    lqc2 $vf1, 0($sp) # 16-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addiu $sp, $sp, 16
  %c = fmul <4 x float> %a, %b
  call void asm sideeffect "", "~{$vf1},~{$vf2},~{$vf3},~{$vf4},~{$vf5},~{$vf6},~{$vf7},~{$vf8},~{$vf9},~{$vf10},~{$vf11},~{$vf12},~{$vf13},~{$vf14},~{$vf15},~{$vf16},~{$vf17},~{$vf18},~{$vf19},~{$vf20},~{$vf21},~{$vf22},~{$vf23},~{$vf24},~{$vf25},~{$vf26},~{$vf27},~{$vf28},~{$vf29},~{$vf30},~{$vf31},~{memory}"()
  %d = fadd <4 x float> %c, %c
  ret <4 x float> %d
}

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 < %s | FileCheck %s

; The R5900 MIN.S and MAX.S do not handle NaN: they are used for
; llvm.minnum/maxnum with nnan, the libcalls otherwise.

define float @test_max(float %a, float %b) {
; CHECK-LABEL: test_max:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    max.s $f0, $f12, $f13
  %r = call nnan float @llvm.maxnum.f32(float %a, float %b)
  ret float %r
}

define float @test_min(float %a, float %b) {
; CHECK-LABEL: test_min:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    min.s $f0, $f12, $f13
  %r = call nnan float @llvm.minnum.f32(float %a, float %b)
  ret float %r
}

define float @test_max_nan(float %a, float %b) {
; CHECK-LABEL: test_max_nan:
; CHECK:       # %bb.0:
; CHECK-NEXT:    daddiu $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    jal fmaxf
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddiu $sp, $sp, 16
  %r = call float @llvm.maxnum.f32(float %a, float %b)
  ret float %r
}

define float @test_min_nan(float %a, float %b) {
; CHECK-LABEL: test_min_nan:
; CHECK:       # %bb.0:
; CHECK-NEXT:    daddiu $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    jal fminf
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddiu $sp, $sp, 16
  %r = call float @llvm.minnum.f32(float %a, float %b)
  ret float %r
}

; A fast-math clamp
define float @clamp(float %x) {
; CHECK-LABEL: clamp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, %highest(.LCPI4_0)
; CHECK-NEXT:    daddiu $1, $1, %higher(.LCPI4_0)
; CHECK-NEXT:    dsll $1, $1, 16
; CHECK-NEXT:    daddiu $1, $1, %hi(.LCPI4_0)
; CHECK-NEXT:    dsll $1, $1, 16
; CHECK-NEXT:    lwc1 $f0, %lo(.LCPI4_0)($1)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    min.s $f0, $f12, $f0
  %c = fcmp fast ogt float %x, 1.0
  %r = select fast i1 %c, float 1.0, float %x
  ret float %r
}

declare float @llvm.maxnum.f32(float, float)
declare float @llvm.minnum.f32(float, float)

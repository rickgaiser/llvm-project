    ; CHECK-NEXT: [[ADDu:%[0-9]+]]:gpr32 = ADDu [[R5900_MULT]], [[R5900_MULT1]]
    ; CHECK-NEXT: [[ADDu1:%[0-9]+]]:gpr32 = ADDu [[R5900_MULT2]], [[ADDu]]
    ; CHECK-NEXT: [[ADDu2:%[0-9]+]]:gpr32 = ADDu [[ADDu1]], [[PseudoMFLO1_]]

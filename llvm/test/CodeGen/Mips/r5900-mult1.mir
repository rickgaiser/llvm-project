# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -run-pass=mips-r5900-mult1 -verify-machineinstrs -o - %s | FileCheck %s

# 3-operand multiplies with dead HI/LO results move to the pipe 1 multiplier
# when that lowers the resource bound of the block.

---
name:            mult_bound
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    ; CHECK-LABEL: name: mult_bound
    ; CHECK: liveins: $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r7
    ; CHECK-NEXT: [[R5900_MULT:%[0-9]+]]:gpr32 = R5900_MULT [[COPY]], [[COPY1]], implicit-def dead $hi0, implicit-def dead $lo0
    ; CHECK-NEXT: [[MULT1_:%[0-9]+]]:gpr32 = MULT1 [[COPY2]], [[COPY3]], implicit-def dead $hi1, implicit-def dead $lo1
    ; CHECK-NEXT: [[R5900_MULT1:%[0-9]+]]:gpr32 = R5900_MULT [[COPY]], [[COPY2]], implicit-def dead $hi0, implicit-def dead $lo0
    ; CHECK-NEXT: [[MULTU1_:%[0-9]+]]:gpr32 = MULTU1 [[COPY1]], [[COPY3]], implicit-def dead $hi1, implicit-def dead $lo1
    ; CHECK-NEXT: [[ADDu:%[0-9]+]]:gpr32 = ADDu [[R5900_MULT]], [[MULT1_]]
    ; CHECK-NEXT: [[ADDu1:%[0-9]+]]:gpr32 = ADDu [[R5900_MULT1]], [[MULTU1_]]
    ; CHECK-NEXT: [[ADDu2:%[0-9]+]]:gpr32 = ADDu [[ADDu]], [[ADDu1]]
    ; CHECK-NEXT: $r2 = COPY [[ADDu2]]
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = COPY $r6
    %3:gpr32 = COPY $r7
    %4:gpr32 = R5900_MULT %0, %1, implicit-def dead $hi0, implicit-def dead $lo0
    %5:gpr32 = R5900_MULT %2, %3, implicit-def dead $hi0, implicit-def dead $lo0
    %6:gpr32 = R5900_MULT %0, %2, implicit-def dead $hi0, implicit-def dead $lo0
    %7:gpr32 = R5900_MULTU %1, %3, implicit-def dead $hi0, implicit-def dead $lo0
    %8:gpr32 = ADDu %4, %5
    %9:gpr32 = ADDu %6, %7
    %10:gpr32 = ADDu %8, %9
    $r2 = COPY %10
    RetRA implicit $r2
...
---
name:            load_store_bound
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: load_store_bound
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[LW:%[0-9]+]]:gpr32 = LW [[COPY]], 0 :: (load (s32))
    ; CHECK-NEXT: [[LW1:%[0-9]+]]:gpr32 = LW [[COPY]], 4 :: (load (s32))
    ; CHECK-NEXT: [[LW2:%[0-9]+]]:gpr32 = LW [[COPY]], 8 :: (load (s32))
    ; CHECK-NEXT: [[LW3:%[0-9]+]]:gpr32 = LW [[COPY]], 12 :: (load (s32))
    ; CHECK-NEXT: [[R5900_MULT:%[0-9]+]]:gpr32 = R5900_MULT [[LW]], [[COPY1]], implicit-def dead $hi0, implicit-def dead $lo0
    ; CHECK-NEXT: [[R5900_MULT1:%[0-9]+]]:gpr32 = R5900_MULT [[LW1]], [[COPY1]], implicit-def dead $hi0, implicit-def dead $lo0
    ; CHECK-NEXT: SW [[R5900_MULT]], [[COPY]], 16 :: (store (s32))
    ; CHECK-NEXT: SW [[R5900_MULT1]], [[COPY]], 20 :: (store (s32))
    ; CHECK-NEXT: SW [[LW2]], [[COPY]], 24 :: (store (s32))
    ; CHECK-NEXT: SW [[LW3]], [[COPY]], 28 :: (store (s32))
    ; CHECK-NEXT: RetRA
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = LW %0, 0 :: (load (s32))
    %3:gpr32 = LW %0, 4 :: (load (s32))
    %4:gpr32 = LW %0, 8 :: (load (s32))
    %5:gpr32 = LW %0, 12 :: (load (s32))
    %6:gpr32 = R5900_MULT %2, %1, implicit-def dead $hi0, implicit-def dead $lo0
    %7:gpr32 = R5900_MULT %3, %1, implicit-def dead $hi0, implicit-def dead $lo0
    SW %6, %0, 16 :: (store (s32))
    SW %7, %0, 20 :: (store (s32))
    SW %4, %0, 24 :: (store (s32))
    SW %5, %0, 28 :: (store (s32))
    RetRA
...
---
name:            hilo_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: hilo_read
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr32 = COPY $r5
    ; CHECK-NEXT: [[R5900_MULT:%[0-9]+]]:gpr32 = R5900_MULT [[COPY]], [[COPY1]], implicit-def $hi0, implicit-def $lo0
    ; CHECK-NEXT: [[MFHI:%[0-9]+]]:gpr32 = MFHI implicit $ac0
    ; CHECK-NEXT: [[MULT1_:%[0-9]+]]:gpr32 = MULT1 [[COPY]], [[COPY]], implicit-def dead $hi1, implicit-def dead $lo1
    ; CHECK-NEXT: [[R5900_MULT1:%[0-9]+]]:gpr32 = R5900_MULT [[COPY1]], [[COPY1]], implicit-def dead $hi0, implicit-def dead $lo0
    ; CHECK-NEXT: [[MULT1_1:%[0-9]+]]:gpr32 = MULT1 [[COPY1]], [[MFHI]], implicit-def dead $hi1, implicit-def dead $lo1
    ; CHECK-NEXT: [[ADDu:%[0-9]+]]:gpr32 = ADDu [[R5900_MULT]], [[MFHI]]
    ; CHECK-NEXT: [[ADDu1:%[0-9]+]]:gpr32 = ADDu [[ADDu]], [[MULT1_]]
    ; CHECK-NEXT: [[ADDu2:%[0-9]+]]:gpr32 = ADDu [[ADDu1]], [[R5900_MULT1]]
    ; CHECK-NEXT: [[ADDu3:%[0-9]+]]:gpr32 = ADDu [[ADDu2]], [[MULT1_1]]
    ; CHECK-NEXT: $r2 = COPY [[ADDu3]]
    ; CHECK-NEXT: RetRA implicit $r2
    %0:gpr32 = COPY $r4
    %1:gpr32 = COPY $r5
    %2:gpr32 = R5900_MULT %0, %1, implicit-def $hi0, implicit-def $lo0
    %3:gpr32 = MFHI implicit $ac0
    %4:gpr32 = R5900_MULT %0, %0, implicit-def dead $hi0, implicit-def dead $lo0
    %5:gpr32 = R5900_MULT %1, %1, implicit-def dead $hi0, implicit-def dead $lo0
    %6:gpr32 = R5900_MULT %1, %3, implicit-def dead $hi0, implicit-def dead $lo0
    %7:gpr32 = ADDu %2, %3
    %8:gpr32 = ADDu %7, %4
    %9:gpr32 = ADDu %8, %5
    %10:gpr32 = ADDu %9, %6
    $r2 = COPY %10
    RetRA implicit $r2
...

  bb.0:
    liveins: $r4, $r5, $r6, $r7

    ; CHECK-LABEL: name: pipe1_accumulator_used
    ; CHECK: liveins: $r4, $r5, $r6, $r7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr32 = COPY $r4

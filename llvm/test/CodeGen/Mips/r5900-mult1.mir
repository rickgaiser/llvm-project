    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr32 = COPY $r6
    ; CHECK-NEXT: [[COPY3:%[0-9]+]]:gpr32 = COPY $r7
    ; CHECK-NEXT: [[PseudoSDIV1_:%[0-9]+]]:acc64_1 = PseudoSDIV1 [[COPY]], [[COPY1]]
    ; CHECK-NEXT: [[PseudoMFLO1_:%[0-9]+]]:gpr32 = PseudoMFLO1 [[PseudoSDIV1_]]
    ; CHECK-NEXT: [[R5900_MULT:%[0-9]+]]:gpr32 = R5900_MULT [[COPY]], [[COPY1]], implicit-def dead $hi0, implicit-def dead $lo0

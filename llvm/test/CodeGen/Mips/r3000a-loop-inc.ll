}

; The stored value is the pointer: it cannot be changed to the new one.
define void @stores_pointer(ptr %d, ptr %e) optsize {
; CHECK-LABEL: stores_pointer:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .insn
; CHECK-NEXT:  $BB2_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1

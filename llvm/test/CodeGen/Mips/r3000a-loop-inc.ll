; CHECK-NEXT:    addiu $4, $4, 4
; CHECK-NEXT:    bne $4, $5, $BB2_1
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.2: # %end
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
entry:
  br label %loop
loop:
  %p = phi ptr [ %d, %entry ], [ %p1, %loop ]

; CHECK-NEXT:    bne $4, $5, $BB1_1
; CHECK-NEXT:    sw $1, -4($4)
; CHECK-NEXT:  # %bb.2: # %end
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop

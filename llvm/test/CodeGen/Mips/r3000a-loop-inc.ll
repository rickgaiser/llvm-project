; RUN: llc -mtriple=mipsel-none-elf -mcpu=r3000a -O2 < %s | FileCheck %s

; A pointer's increment goes behind the last load through it, into that load's
; delay slot, and the store behind it uses the new value: no move at the end of
; the loop, no nop.

define void @copy(ptr %d, ptr %s, i32 %n) optsize {
; CHECK-LABEL: copy:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    .insn
; CHECK-NEXT:  $BB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    lw $1, 0($5)
; CHECK-NEXT:    addiu $4, $4, 4
; CHECK-NEXT:    addiu $5, $5, 4
; CHECK-NEXT:    addiu $6, $6, -1
; CHECK-NEXT:    bnez $6, $BB0_1
; CHECK-NEXT:    sw $1, -4($4)
; CHECK-NEXT:  # %bb.2: # %end
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
entry:
  br label %loop
loop:
  %p = phi ptr [ %d, %entry ], [ %p1, %loop ]
  %q = phi ptr [ %s, %entry ], [ %q1, %loop ]
  %i = phi i32 [ %n, %entry ], [ %i1, %loop ]
  %q1 = getelementptr i32, ptr %q, i32 1
  %v = load i32, ptr %q
  %p1 = getelementptr i32, ptr %p, i32 1
  store i32 %v, ptr %p
  %i1 = add i32 %i, -1
  %c = icmp ne i32 %i1, 0
  br i1 %c, label %loop, label %end
end:
  ret void
}


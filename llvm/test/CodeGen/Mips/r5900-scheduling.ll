; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el-none-elf -mcpu=r5900 -O2 < %s | FileCheck %s

; Test that FPU operations are properly scheduled on R5900.
; The R5900 has a 2-way superscalar pipeline where loads (LS pipe) can
; dual-issue with FPU operations (C1 pipe).

; This test uses the R5900 FPU accumulator chain (mula.s/madda.s/madd.s)
; for dot products, which is automatically generated.
define void @dot_product_interleave(ptr %a, ptr %b, ptr %out) {
; CHECK-LABEL: dot_product_interleave:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lwc1 $f0, 0($4)
; CHECK-NEXT:    lwc1 $f4, 0($5)
; CHECK-NEXT:    lwc1 $f1, 4($4)
; CHECK-NEXT:    lwc1 $f2, 8($4)
; CHECK-NEXT:    lwc1 $f5, 4($5)
; CHECK-NEXT:    lwc1 $f6, 8($5)
; CHECK-NEXT:    lwc1 $f3, 12($4)
; CHECK-NEXT:    lwc1 $f7, 12($5)
; CHECK-NEXT:    mula.s $f0, $f4
; CHECK-NEXT:    madd.s $f0, $f1, $f5
; CHECK-NEXT:    mula.s $f2, $f6
; CHECK-NEXT:    madd.s $f1, $f3, $f7
; CHECK-NEXT:    add.s $f0, $f0, $f1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    swc1 $f0, 0($6)
; R5900 uses accumulator instructions for dot products
  %a0.ptr = getelementptr float, ptr %a, i32 0
  %a1.ptr = getelementptr float, ptr %a, i32 1
  %a2.ptr = getelementptr float, ptr %a, i32 2
  %a3.ptr = getelementptr float, ptr %a, i32 3

  %b0.ptr = getelementptr float, ptr %b, i32 0
  %b1.ptr = getelementptr float, ptr %b, i32 1
  %b2.ptr = getelementptr float, ptr %b, i32 2
  %b3.ptr = getelementptr float, ptr %b, i32 3

  %a0 = load float, ptr %a0.ptr
  %a1 = load float, ptr %a1.ptr
  %a2 = load float, ptr %a2.ptr
  %a3 = load float, ptr %a3.ptr

  %b0 = load float, ptr %b0.ptr
  %b1 = load float, ptr %b1.ptr
  %b2 = load float, ptr %b2.ptr
  %b3 = load float, ptr %b3.ptr

  ; Compute dot product: a0*b0 + a1*b1 + a2*b2 + a3*b3
  %m0 = fmul nnan ninf float %a0, %b0
  %m1 = fmul nnan ninf float %a1, %b1
  %m2 = fmul nnan ninf float %a2, %b2
  %m3 = fmul nnan ninf float %a3, %b3

  %s0 = fadd nnan ninf float %m0, %m1
  %s1 = fadd nnan ninf float %m2, %m3
  %result = fadd nnan ninf float %s0, %s1

  store float %result, ptr %out
  ret void
}

; Test: integer ALU can dual-issue with loads
; ALU uses R5900EitherSlot (Slot0 or Slot1), Load uses Slot1
; When load goes to Slot1, ALU can use Slot0 for dual-issue
define i32 @int_dual_alu_load(ptr %p, i32 %a, i32 %b) {
; CHECK-LABEL: int_dual_alu_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $6, 0
; CHECK-NEXT:    sll $2, $5, 0
; CHECK-NEXT:    lw $3, 0($4)
; CHECK-NEXT:    addu $1, $2, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $3, $1
  %v = load i32, ptr %p
  %sum = add i32 %a, %b
  %result = add i32 %v, %sum
  ret i32 %result
}

; Test: integer multiply (Slot0/MAC0) can dual-issue with load (Slot1)
define i32 @int_dual_mul_load(ptr %p, i32 %a, i32 %b) {
; CHECK-LABEL: int_dual_mul_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $6, 0
; CHECK-NEXT:    sll $2, $5, 0
; CHECK-NEXT:    mult $1, $2, $1
; CHECK-NEXT:    lw $2, 0($4)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $2, $1
  %v = load i32, ptr %p
  %m = mul i32 %a, %b
  %result = add i32 %v, %m
  ret i32 %result
}

; Test: two independent multiplies
; The MachineScheduler loads all values first, then performs multiplies.
define void @two_muls(ptr %a, ptr %b, ptr %c, ptr %d, ptr %out1, ptr %out2) {
; CHECK-LABEL: two_muls:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lwc1 $f0, 0($4)
; CHECK-NEXT:    lwc1 $f1, 0($5)
; CHECK-NEXT:    lwc1 $f2, 0($6)
; CHECK-NEXT:    lwc1 $f3, 0($7)
; CHECK-NEXT:    mul.s $f0, $f0, $f1
; CHECK-NEXT:    mul.s $f1, $f2, $f3
; CHECK-NEXT:    swc1 $f0, 0($8)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    swc1 $f1, 0($9)
; All loads first
; Then both multiplies
; Then stores
  %va = load float, ptr %a
  %vb = load float, ptr %b
  %vc = load float, ptr %c
  %vd = load float, ptr %d

  %m1 = fmul nnan ninf float %va, %vb
  %m2 = fmul nnan ninf float %vc, %vd

  store float %m1, ptr %out1
  store float %m2, ptr %out2
  ret void
}

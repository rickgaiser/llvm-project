define i32 @acyclic(ptr %table, i32 %value) {
; R5900-ASM-LABEL: acyclic:
; R5900-ASM:       # %bb.0: # %entry
; R5900-ASM-NEXT:    sll $1, $4, 0
; R5900-ASM-NEXT:    lw $2, 0($1)
; R5900-ASM-NEXT:    jr $2
; R5900-ASM-NEXT:    sll $1, $5, 0
; R5900-ASM-NEXT:  .LBB0_1: # %one
; R5900-ASM-NEXT:    jr $ra
; R5900-ASM-NEXT:    addiu $2, $1, 1
; R5900-ASM-NEXT:  .LBB0_2: # %two
; R5900-ASM-NEXT:    jr $ra
; R5900-ASM-NEXT:    addiu $2, $1, -1
;
; MIPS3-ASM-LABEL: acyclic:
; MIPS3-ASM:       # %bb.0: # %entry
; MIPS3-ASM-NEXT:    sll $1, $4, 0
; MIPS3-ASM-NEXT:    lw $2, 0($1)
; MIPS3-ASM-NEXT:    jr $2
; MIPS3-ASM-NEXT:    sll $1, $5, 0
; MIPS3-ASM-NEXT:  .LBB0_1: # %one
; MIPS3-ASM-NEXT:    jr $ra
; MIPS3-ASM-NEXT:    addiu $2, $1, 1
; MIPS3-ASM-NEXT:  .LBB0_2: # %two
; MIPS3-ASM-NEXT:    jr $ra
; MIPS3-ASM-NEXT:    addiu $2, $1, -1
entry:
  %dest = load ptr, ptr %table, align 4
  indirectbr ptr %dest, [label %one, label %two]
one:
  %a = add i32 %value, 1
  ret i32 %a
two:
  %b = sub i32 %value, 1
  ret i32 %b
}


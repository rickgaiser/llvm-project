; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 < %s | FileCheck %s

; A freeze of an FPU operation with nnan and ninf must not be pushed through
; it: that drops the flags, and the R5900 then uses the libcall.

define float @freeze_fadd(float %a, float %b, float %c) {
; CHECK-LABEL: freeze_fadd:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mul.s $f0, $f12, $f13
; CHECK-NEXT:    add.s $f0, $f0, $f14
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    mul.s $f0, $f0, $f14
  %x = fmul nnan ninf float %a, %b
  %y = fadd nnan ninf float %x, %c
  %f = freeze float %y
  %z = fmul nnan ninf float %f, %c
  ret float %z
}

define float @freeze_fsqrt(float %a) {
; CHECK-LABEL: freeze_fsqrt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sqrt.s $f0, $f12
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    add.s $f0, $f0, $f12
  %x = call nnan ninf float @llvm.sqrt.f32(float %a)
  %f = freeze float %x
  %z = fadd nnan ninf float %f, %a
  ret float %z
}

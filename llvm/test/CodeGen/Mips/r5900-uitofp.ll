; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi=n32 < %s | FileCheck %s

; The R5900 FPU does not handle NaN and infinity, so FP operations without
; nnan and ninf are libcalls. The doubling in the expansion of uitofp is of a
; non-negative integer, never NaN or infinity, so it uses add.s. There is no
; conversion from i64 in the FPU: an unsigned one is a single libcall.

define float @uitofp_i32(i32 %x) {
; CHECK-LABEL: uitofp_i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    slti $1, $2, 0
; CHECK-NEXT:    bnez $1, .LBB0_2
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mtc1 $2, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    cvt.s.w $f0, $f0
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    srl $1, $2, 1
; CHECK-NEXT:    andi $2, $2, 1
; CHECK-NEXT:    or $1, $2, $1
; CHECK-NEXT:    mtc1 $1, $f0
; CHECK-NEXT:    cvt.s.w $f0, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    add.s $f0, $f0, $f0
  %r = uitofp i32 %x to float
  ret float %r
}

define float @uitofp_i64(i64 %x) {
; CHECK-LABEL: uitofp_i64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    jal __floatundisf
; CHECK-NEXT:    nop
; CHECK-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addiu $sp, $sp, 16
  %r = uitofp i64 %x to float
  ret float %r
}

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi=n32 < %s | FileCheck %s

; The R5900 FPU does not handle NaN and infinity, so FP operations without
; nnan and ninf are libcalls. The subtraction in the expansion of fptoui is
; exact where the result is defined, so it uses sub.s.

define i32 @fptoui(float %x) {
; CHECK-LABEL: fptoui:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, %hi(.LCPI0_0)
; CHECK-NEXT:    lwc1 $f0, %lo(.LCPI0_0)($1)
; CHECK-NEXT:    c.lt.s $f12, $f0
; CHECK-NEXT:    bc1t .LBB0_2
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    sub.s $f0, $f12, $f0
; CHECK-NEXT:    lui $2, 32768
; CHECK-NEXT:    cvt.w.s $f0, $f0
; CHECK-NEXT:    mfc1 $1, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    xor $2, $1, $2
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    cvt.w.s $f0, $f12
; CHECK-NEXT:    mfc1 $2, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %r = fptoui float %x to i32
  ret i32 %r
}

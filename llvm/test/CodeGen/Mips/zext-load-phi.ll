; An i32 any extending load of an i8 or i16 is selected as lbu or lhu. It is
; made a zero extending load, so that the zero high bits also reach the zero
; extension of the zeroext return value after the phi in the return block.

@ram = external global [65536 x i8]
@ram16 = external global [65536 x i16]

declare zeroext i8 @slow8(i32 signext)
declare zeroext i16 @slow16(i32 signext)

define zeroext i8 @phi_load_i8(i32 signext %a) nounwind {
; MIPS32-LABEL: phi_load_i8:
; MIPS32:       # %bb.0: # %entry
; MIPS32-NEXT:    srl $1, $4, 20
; MIPS32-NEXT:    addiu $2, $zero, 1
; MIPS32-NEXT:    bne $1, $2, $BB0_2
; MIPS32-NEXT:    nop
; MIPS32-NEXT:  # %bb.1: # %ram
; MIPS32-NEXT:    andi $1, $4, 65535
; MIPS32-NEXT:    lui $2, %hi(ram)
; MIPS32-NEXT:    addiu $2, $2, %lo(ram)
; MIPS32-NEXT:    addu $1, $2, $1
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    lbu $2, 0($1)
; MIPS32-NEXT:  $BB0_2: # %slow
; MIPS32-NEXT:    addiu $sp, $sp, -24
; MIPS32-NEXT:    sw $ra, 20($sp) # 4-byte Folded Spill
; MIPS32-NEXT:    jal slow8
; MIPS32-NEXT:    nop
; MIPS32-NEXT:    lw $ra, 20($sp) # 4-byte Folded Reload
; MIPS32-NEXT:    jr $ra
; MIPS32-NEXT:    addiu $sp, $sp, 24
;
; R5900-LABEL: phi_load_i8:
; R5900:       # %bb.0: # %entry
; R5900-NEXT:    srl $1, $4, 20
; R5900-NEXT:    addiu $2, $zero, 1
; R5900-NEXT:    bne $1, $2, .LBB0_2
; R5900-NEXT:    nop
; R5900-NEXT:  # %bb.1: # %ram
; R5900-NEXT:    lui $1, %hi(ram)
; R5900-NEXT:    andi $2, $4, 65535
; R5900-NEXT:    addiu $1, $1, %lo(ram)
; R5900-NEXT:    addu $1, $1, $2
; R5900-NEXT:    jr $ra
; R5900-NEXT:    lbu $2, 0($1)
; R5900-NEXT:  .LBB0_2: # %slow
; R5900-NEXT:    addiu $sp, $sp, -16
; R5900-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; R5900-NEXT:    jal slow8
; R5900-NEXT:    sll $4, $4, 0
; R5900-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; R5900-NEXT:    jr $ra
; R5900-NEXT:    addiu $sp, $sp, 16
entry:
  %hi = lshr i32 %a, 20
  %fast = icmp eq i32 %hi, 1
  br i1 %fast, label %ram, label %slow, !prof !0

ram:
  %idx = and i32 %a, 65535
  %p = getelementptr inbounds [65536 x i8], ptr @ram, i32 0, i32 %idx
  %v = load i8, ptr %p, align 1
  br label %return

slow:
  %s = call zeroext i8 @slow8(i32 signext %a)
  br label %return

return:
  %r = phi i8 [ %v, %ram ], [ %s, %slow ]
  ret i8 %r
}


; RUN: llc -mtriple=mips64el -mcpu=r5900 -O2 -verify-machineinstrs < %s | FileCheck %s

; Test that multiply-add chains are optimized to use the FPU accumulator.
; The R5900 FPU is used for float operations without NaNs and infinities
; (nnan ninf); otherwise they are library calls.

; Simple 2-element dot product: a0*b0 + a1*b1
define float @dot2(float %a0, float %b0, float %a1, float %b1) {
; CHECK-LABEL: dot2:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mula.s $f14, $f15
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    madd.s $f0, $f12, $f13
entry:
  %m0 = fmul nnan ninf float %a0, %b0
  %m1 = fmul nnan ninf float %a1, %b1
  %sum = fadd nnan ninf float %m0, %m1
  ret float %sum
}

; 3-element dot product: a0*b0 + a1*b1 + a2*b2
define float @dot3(float %a0, float %b0, float %a1, float %b1, float %a2, float %b2) {
; CHECK-LABEL: dot3:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mula.s $f16, $f17
; CHECK-NEXT:    madda.s $f14, $f15
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    madd.s $f0, $f12, $f13
entry:
  %m0 = fmul nnan ninf float %a0, %b0
  %m1 = fmul nnan ninf float %a1, %b1
  %m2 = fmul nnan ninf float %a2, %b2
  %s0 = fadd nnan ninf float %m0, %m1
  %s1 = fadd nnan ninf float %s0, %m2
  ret float %s1
}

; 4-element dot product: a0*b0 + a1*b1 + a2*b2 + a3*b3
define float @dot4(float %a0, float %b0, float %a1, float %b1, float %a2, float %b2, float %a3, float %b3) {
; CHECK-LABEL: dot4:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mula.s $f18, $f19
; CHECK-NEXT:    madda.s $f16, $f17
; CHECK-NEXT:    madda.s $f14, $f15
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    madd.s $f0, $f12, $f13
entry:
  %m0 = fmul nnan ninf float %a0, %b0
  %m1 = fmul nnan ninf float %a1, %b1
  %m2 = fmul nnan ninf float %a2, %b2
  %m3 = fmul nnan ninf float %a3, %b3
  %s0 = fadd nnan ninf float %m0, %m1
  %s1 = fadd nnan ninf float %s0, %m2
  %s2 = fadd nnan ninf float %s1, %m3
  ret float %s2
}

; 4-element dot product with memory loads.
; This test verifies that register allocation correctly assigns different
; registers to each loaded value - a previous bug caused registers to be reused
; before their values were consumed.
; The MachineScheduler interleaves loads with the ACC chain for better performance.
define void @dot4_mem(ptr %a, ptr %b, ptr %out) {
; CHECK-LABEL: dot4_mem:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lwc1 $f0, 0($4)
; CHECK-NEXT:    lwc1 $f4, 0($5)
; CHECK-NEXT:    lwc1 $f1, 4($4)
; CHECK-NEXT:    lwc1 $f5, 4($5)
; CHECK-NEXT:    lwc1 $f2, 8($4)
; CHECK-NEXT:    lwc1 $f6, 8($5)
; CHECK-NEXT:    mula.s $f0, $f4
; CHECK-NEXT:    lwc1 $f3, 12($4)
; CHECK-NEXT:    lwc1 $f7, 12($5)
; CHECK-NEXT:    madda.s $f1, $f5
; CHECK-NEXT:    madda.s $f2, $f6
; CHECK-NEXT:    madd.s $f0, $f3, $f7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    swc1 $f0, 0($6)
entry:
  %a0 = load float, ptr %a
  %a1.ptr = getelementptr float, ptr %a, i32 1
  %a1 = load float, ptr %a1.ptr
  %a2.ptr = getelementptr float, ptr %a, i32 2
  %a2 = load float, ptr %a2.ptr
  %a3.ptr = getelementptr float, ptr %a, i32 3
  %a3 = load float, ptr %a3.ptr

  %b0 = load float, ptr %b
  %b1.ptr = getelementptr float, ptr %b, i32 1
  %b1 = load float, ptr %b1.ptr
  %b2.ptr = getelementptr float, ptr %b, i32 2
  %b2 = load float, ptr %b2.ptr
  %b3.ptr = getelementptr float, ptr %b, i32 3
  %b3 = load float, ptr %b3.ptr

  %m0 = fmul nnan ninf float %a0, %b0
  %m1 = fmul nnan ninf float %a1, %b1
  %m2 = fmul nnan ninf float %a2, %b2
  %m3 = fmul nnan ninf float %a3, %b3

  %s0 = fadd nnan ninf float %m0, %m1
  %s1 = fadd nnan ninf float %s0, %m2
  %s2 = fadd nnan ninf float %s1, %m3

  store float %s2, ptr %out
  ret void
}

; One term that is not a product starts the chain as MULA.S c0, 1.0 (1.0 as
; the second operand, which the R5900 multiplier keeps exact). The product
; with the operand defined last (y * x3, y comes from the previous step)
; is the final MADD.S, so the chain does not wait for it.
define float @poly_step(float %y, float %x, float %c0, float %c1, float %c2) {
; CHECK-LABEL: poly_step:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mul.s $f0, $f13, $f13
; CHECK-NEXT:    lui $1, 16256
; CHECK-NEXT:    mtc1 $1, $f1
; CHECK-NEXT:    mul.s $f3, $f12, $f12
; CHECK-NEXT:    mula.s $f14, $f1
; CHECK-NEXT:    mul.s $f2, $f0, $f13
; CHECK-NEXT:    madda.s $f15, $f13
; CHECK-NEXT:    madda.s $f16, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    madd.s $f0, $f3, $f2
entry:
  %x2 = fmul nnan ninf float %x, %x
  %x3 = fmul nnan ninf float %x2, %x
  %y2 = fmul nnan ninf float %y, %y
  %m1 = fmul nnan ninf float %c1, %x
  %m2 = fmul nnan ninf float %c2, %x2
  %m3 = fmul nnan ninf float %y2, %x3
  %s0 = fadd nnan ninf float %c0, %m1
  %s1 = fadd nnan ninf float %s0, %m2
  %s2 = fadd nnan ninf float %m3, %s1
  ret float %s2
}

; Two plain terms: not a chain.
define float @two_plain(float %a, float %b, float %c, float %d) {
; CHECK-LABEL: two_plain:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mul.s $f0, $f14, $f15
; CHECK-NEXT:    add.s $f1, $f12, $f13
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    add.s $f0, $f1, $f0
entry:
  %m0 = fmul nnan ninf float %c, %d
  %s0 = fadd nnan ninf float %a, %b
  %s1 = fadd nnan ninf float %s0, %m0
  ret float %s1
}

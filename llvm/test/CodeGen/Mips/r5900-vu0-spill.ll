; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 < %s | FileCheck %s

; The VF registers are not preserved across calls, a value that lives across
; one is spilled with SQC2 and reloaded with LQC2. The R5900 has no MSA, so
; ST.W and LD.W would be LQ instructions.

declare void @f()

define void @spill(ptr %p, ptr %q) {
; CHECK-LABEL: spill:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $sp, $sp, -48
; CHECK-NEXT:    .cfi_def_cfa_offset 48
; CHECK-NEXT:    sd $ra, 40($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd $16, 32($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    .cfi_offset 16, -16
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    lqc2 $vf1, 0($1)
; CHECK-NEXT:    sll $16, $5, 0
; CHECK-NEXT:    vmul.xyzw $vf2, $vf1, $vf1
; CHECK-NEXT:    sqc2 $vf1, 0($sp) # 16-byte Folded Spill
; CHECK-NEXT:    jal f
; CHECK-NEXT:    sqc2 $vf2, 16($sp)
; CHECK-NEXT:    lqc2 $vf2, 0($sp) # 16-byte Folded Reload
; CHECK-NEXT:    ld $ra, 40($sp) # 8-byte Folded Reload
; CHECK-NEXT:    lqc2 $vf1, 16($sp) # 16-byte Folded Reload
; CHECK-NEXT:    vadd.xyzw $vf1, $vf1, $vf2
; CHECK-NEXT:    sqc2 $vf1, 0($16)
; CHECK-NEXT:    ld $16, 32($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addiu $sp, $sp, 48
  %v = load <4 x float>, ptr %p, align 16
  %w = fmul <4 x float> %v, %v
  call void @f()
  %x = fadd <4 x float> %w, %v
  store <4 x float> %x, ptr %q, align 16
  ret void
}

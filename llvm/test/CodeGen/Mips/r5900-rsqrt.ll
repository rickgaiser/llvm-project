; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; With approximate functions, x / sqrt(y) is one R5900 RSQRT.S (fd = fs /
; sqrt(ft)), like gcc with -ffast-math.

define float @div_sqrt(float %x, float %y) {
; CHECK-LABEL: div_sqrt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    rsqrt.s $f0, $f12, $f13
  %s = call nnan ninf afn float @llvm.sqrt.f32(float %y)
  %r = fdiv nnan ninf afn float %x, %s
  ret float %r
}

define float @recip_sqrt(float %y) {
; CHECK-LABEL: recip_sqrt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui $1, %hi(.LCPI1_0)
; CHECK-NEXT:    lwc1 $f0, %lo(.LCPI1_0)($1)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    rsqrt.s $f0, $f0, $f12
  %s = call nnan ninf afn float @llvm.sqrt.f32(float %y)
  %r = fdiv nnan ninf afn float 1.0, %s
  ret float %r
}

; Without approximate functions, the square root and the division are kept.
define float @div_sqrt_exact(float %x, float %y) {
; CHECK-LABEL: div_sqrt_exact:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sqrt.s $f0, $f13
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    div.s $f0, $f12, $f0
  %s = call nnan ninf float @llvm.sqrt.f32(float %y)
  %r = fdiv nnan ninf float %x, %s
  ret float %r
}

; The square root is also used otherwise, so DIV.S after it is faster.
define float @sqrt_used(float %x, float %y) {
; CHECK-LABEL: sqrt_used:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sqrt.s $f0, $f13
; CHECK-NEXT:    div.s $f1, $f12, $f0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    add.s $f0, $f1, $f0
  %s = call nnan ninf afn float @llvm.sqrt.f32(float %y)
  %r = fdiv nnan ninf afn float %x, %s
  %a = fadd nnan ninf afn float %r, %s
  ret float %a
}

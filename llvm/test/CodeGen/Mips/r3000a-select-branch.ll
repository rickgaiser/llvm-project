; RUN: llc -mtriple=mipsel-none-elf -mcpu=r3000a -O2 < %s | FileCheck %s

; Without conditional moves a select is a branch: it compares directly, and
; branches over the constant, so the other value stays in its register.

define i32 @wrap(i32 %x, i32 %n) {
; CHECK-LABEL: wrap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $2, $4, 1
; CHECK-NEXT:    bne $2, $5, $BB0_2
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    addiu $2, $zero, 0
; CHECK-NEXT:  $BB0_2:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %y = add i32 %x, 1
  %c = icmp eq i32 %y, %n
  %r = select i1 %c, i32 0, i32 %y
  ret i32 %r
}

define i32 @wrap_imm(i32 %x) {
; CHECK-LABEL: wrap_imm:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $2, $4, 1
; CHECK-NEXT:    addiu $1, $zero, 2048
; CHECK-NEXT:    bne $2, $1, $BB1_2
; CHECK-NEXT:    nop
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    addiu $2, $zero, 0
; CHECK-NEXT:  $BB1_2:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %y = add i32 %x, 1
  %c = icmp eq i32 %y, 2048
  %r = select i1 %c, i32 0, i32 %y
  ret i32 %r
}


; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; A field of one vector into fields of another is one masked VADDbc, 0 + v.k,
; that writes the fields directly: VF0 has 0.0 in x, y and z, a zero vector
; is used for w. Before, a zero (VSUB v, v), a broadcast (VADDbc) and a
; VMOVE of the fields.

; z of %b into w of %a
define <4 x float> @z_to_w(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: z_to_w:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmove.xyzw $vf1, $vf12
; CHECK-NEXT:    lui $1, %hi(.LCPI0_0)
; CHECK-NEXT:    lqc2 $vf2, %lo(.LCPI0_0)($1)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddz.w $vf1, $vf2, $vf13
  %t = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 poison, i32 poison, i32 poison, i32 2>
  %r = shufflevector <4 x float> %a, <4 x float> %t, <4 x i32> <i32 0, i32 1, i32 2, i32 7>
  ret <4 x float> %r
}

; y of %b into x of %a
define <4 x float> @y_to_x(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: y_to_x:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmove.xyzw $vf1, $vf12
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddy.x $vf1, $vf0, $vf13
  %t = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 1, i32 poison, i32 poison, i32 poison>
  %r = shufflevector <4 x float> %t, <4 x float> %a, <4 x i32> <i32 0, i32 5, i32 6, i32 7>
  ret <4 x float> %r
}

; x of %b into y and z of %a
define <4 x float> @x_to_yz(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: x_to_yz:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmove.xyzw $vf1, $vf12
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddx.yz $vf1, $vf0, $vf13
  %t = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 poison, i32 0, i32 0, i32 poison>
  %r = shufflevector <4 x float> %a, <4 x float> %t, <4 x i32> <i32 0, i32 5, i32 6, i32 3>
  ret <4 x float> %r
}

; an extracted field inserted into another vector
define <4 x float> @insert_extract(<4 x float> %a, <4 x float> %b) {
; CHECK-LABEL: insert_extract:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmove.xyzw $vf1, $vf12
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddz.y $vf1, $vf0, $vf13
  %e = extractelement <4 x float> %b, i32 2
  %r = insertelement <4 x float> %a, float %e, i32 1
  ret <4 x float> %r
}

; An unaligned 128-bit MMI load is the two quadwords around it (LQ ignores the
; low 4 address bits: LQ 0(p) and 15(p)) and QFSRV with SA = p & 15 (MTSAB);
; from a 16-byte aligned base plus a constant, the aligned quadwords, which
; nearby loads share, and an MTSAB of the constant. With an unknown base and
; an offset that is not a multiple of 16, and when 8-byte aligned, it is two
; doubleword loads (LDL/LDR, or LD) joined with PCPYLD. An unaligned store is
; PCPYUD and two doubleword stores: SDL/SDR, or SD when 8-byte aligned.

define <4 x i32> @load_align4(ptr %p) {
; CHECK-LABEL: load_align4:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    lq $2, 0($1)
; CHECK-NEXT:    lq $1, 15($1)
; CHECK-NEXT:    mtsab $4, 0
; CHECK-NEXT:    qfsrv $2, $1, $2
; CHECK-NEXT:    # kill: def $r2_64 killed $r2_64 killed $r2_128
; CHECK-NEXT:    # kill: def $r3_64 killed $r3_64 killed $r3_128
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    pcpyud $3, $2, $2
  %v = load <4 x i32>, ptr %p, align 4
  ret <4 x i32> %v
}


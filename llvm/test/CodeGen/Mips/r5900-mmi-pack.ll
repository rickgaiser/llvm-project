; Vector truncations to v8i16 and v16i8 pack the low halfwords or bytes of
; two registers with PPACH and PPACB, and to v4i16 and v4i8 of one.

define void @trunc_v8i32_v8i16(ptr %p, ptr %q) {
; CHECK-LABEL: trunc_v8i32_v8i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    sll $3, $5, 0
; CHECK-NEXT:    lq $2, 0($1)
; CHECK-NEXT:    lq $1, 16($1)
; CHECK-NEXT:    ppach $1, $1, $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sq $1, 0($3)
  %v = load <8 x i32>, ptr %p, align 32
  %t = trunc <8 x i32> %v to <8 x i16>
  store <8 x i16> %t, ptr %q, align 16
  ret void
}


;===----------------------------------------------------------------------===;
; MULHS/MULHU Tests (get high 32 bits of 64-bit product)
;===----------------------------------------------------------------------===;

; MULHS - get high 32 bits of signed multiply
define i32 @test_mulhs(i32 signext %a, i32 signext %b) {
; CHECK-LABEL: test_mulhs:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mult $4, $5
; CHECK-NEXT:    mfhi $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %a_ext = sext i32 %a to i64
  %b_ext = sext i32 %b to i64
  %mul = mul i64 %a_ext, %b_ext
  %hi = lshr i64 %mul, 32
  %result = trunc i64 %hi to i32
  ret i32 %result
}

; MULHU - get high 32 bits of unsigned multiply
define i32 @test_mulhu(i32 zeroext %a, i32 zeroext %b) {
; CHECK-LABEL: test_mulhu:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    multu $2, $1
; CHECK-NEXT:    mfhi $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %a_ext = zext i32 %a to i64
  %b_ext = zext i32 %b to i64
  %mul = mul i64 %a_ext, %b_ext
  %hi = lshr i64 %mul, 32
  %result = trunc i64 %hi to i32
  ret i32 %result
}

;===----------------------------------------------------------------------===;
; Negative Tests - DMULT/DMULTU must NOT be generated for R5900
;===----------------------------------------------------------------------===;

; 64-bit multiply must NOT use DMULT on R5900
; R5900 doesn't support DMULT - must expand to 32-bit operations
define i64 @test_mul64(i64 %a, i64 %b) {
; CHECK-LABEL: test_mul64:
; CHECK:       # %bb.0:
; CHECK-NEXT:    daddiu $sp, $sp, -16
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    dsrl $1, $5, 32
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    sll $3, $5, 0
; CHECK-NEXT:    mult $1, $2, $1
; CHECK-NEXT:    multu $2, $3
; CHECK-NEXT:    pmfhl.lw $2
; CHECK-NEXT:    sd $2, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    dsrl $2, $4, 32
; CHECK-NEXT:    sll $2, $2, 0
; CHECK-NEXT:    mult $2, $2, $3
; CHECK-NEXT:    ld $3, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    pmthl.lw $3
; CHECK-NEXT:    mfhi $3
; CHECK-NEXT:    mflo $4
; CHECK-NEXT:    addu $1, $3, $1
; CHECK-NEXT:    addu $1, $1, $2
; CHECK-NEXT:    dsll $2, $4, 32
; CHECK-NEXT:    dsll $1, $1, 32
; CHECK-NEXT:    dsrl $2, $2, 32
; CHECK-NEXT:    or $2, $2, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    daddiu $sp, $sp, 16
  %result = mul i64 %a, %b
  ret i64 %result
}


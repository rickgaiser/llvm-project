;===----------------------------------------------------------------------===;
; Widening Multiplication Tests (32x32 = 64-bit result)
;===----------------------------------------------------------------------===;

; Signed widening multiply: PMULTW writes the 64-bit product to rd
define i64 @test_smul_wide(i32 signext %a, i32 signext %b) {
; CHECK-LABEL: test_smul_wide:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    pmultw $2, $4, $5
  %a_ext = sext i32 %a to i64
  %b_ext = sext i32 %b to i64
  %result = mul i64 %a_ext, %b_ext
  ret i64 %result
}

; Unsigned widening multiply
define i64 @test_umul_wide(i32 zeroext %a, i32 zeroext %b) {
; CHECK-LABEL: test_umul_wide:
; CHECK:       # %bb.0:
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    pmultuw $2, $4, $5
  %a_ext = zext i32 %a to i64
  %b_ext = zext i32 %b to i64
  %result = mul i64 %a_ext, %b_ext
  ret i64 %result
}

;===----------------------------------------------------------------------===;
; Widening multiply of loaded values, and compares of two products
;===----------------------------------------------------------------------===;

define i64 @test_smul_wide_load(ptr %p, ptr %q) {
; CHECK-LABEL: test_smul_wide_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw $1, 0($4)
; CHECK-NEXT:    lw $2, 0($5)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    pmultw $2, $1, $2
  %a = load i32, ptr %p
  %b = load i32, ptr %q
  %a_ext = sext i32 %a to i64
  %b_ext = sext i32 %b to i64
  %result = mul nsw i64 %a_ext, %b_ext
  ret i64 %result
}

; The sign of a 2D cross product: PMULTW and PMSUBW
define i1 @test_cross_sgt(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: test_cross_sgt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pmultw $1, $4, $5
; CHECK-NEXT:    pmsubw $1, $6, $7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    slt $2, $zero, $1
  %a6 = sext i32 %a to i64
  %b6 = sext i32 %b to i64
  %c6 = sext i32 %c to i64
  %d6 = sext i32 %d to i64
  %m1 = mul nsw i64 %a6, %b6
  %m2 = mul nsw i64 %c6, %d6
  %r = icmp sgt i64 %m1, %m2
  ret i1 %r
}

define i1 @test_cross_eq(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: test_cross_eq:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pmultw $1, $4, $5
; CHECK-NEXT:    pmsubw $1, $6, $7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sltiu $2, $1, 1
  %a6 = sext i32 %a to i64
  %b6 = sext i32 %b to i64
  %c6 = sext i32 %c to i64
  %d6 = sext i32 %d to i64
  %m1 = mul nsw i64 %a6, %b6
  %m2 = mul nsw i64 %c6, %d6
  %r = icmp eq i64 %m1, %m2
  ret i1 %r
}

; An unsigned compare is not kept by the difference of the products
define i1 @test_cross_ult(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: test_cross_ult:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pmultw $1, $4, $5
; CHECK-NEXT:    pmultw $2, $6, $7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sltu $2, $1, $2
  %a6 = sext i32 %a to i64
  %b6 = sext i32 %b to i64
  %c6 = sext i32 %c to i64
  %d6 = sext i32 %d to i64
  %m1 = mul nsw i64 %a6, %b6
  %m2 = mul nsw i64 %c6, %d6
  %r = icmp ult i64 %m1, %m2
  ret i1 %r
}


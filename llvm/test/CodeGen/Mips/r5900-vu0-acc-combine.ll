; With -mips-vu0-acc-combine, the MachineCombiner turns an add of a single
; product into an ACC chain, VMULAw acc, c, vf0w and VMADD d, a, b, when the
; scheduling model finds the critical path shorter (4 instead of 8 cycles
; from a and b here). It is off: the ACC chains were slower on the PS2.

define <4 x float> @madd(<4 x float> %a, <4 x float> %b, <4 x float> %c) {
; OFF-LABEL: madd:
; OFF:       # %bb.0:
; OFF-NEXT:    vmul.xyzw $vf1, $vf12, $vf13
; OFF-NEXT:    jr $ra
; OFF-NEXT:    vadd.xyzw $vf1, $vf1, $vf14
;
; ON-LABEL: madd:
; ON:       # %bb.0:
; ON-NEXT:    vmulaw.xyzw $acc, $vf14, $vf0
; ON-NEXT:    jr $ra
; ON-NEXT:    vmadd.xyzw $vf1, $vf12, $vf13
  %m = fmul fast <4 x float> %a, %b
  %r = fadd fast <4 x float> %m, %c
  ret <4 x float> %r
}

define <4 x float> @madd_bc(<4 x float> %a, <4 x float> %b, <4 x float> %c) {
; OFF-LABEL: madd_bc:
; OFF:       # %bb.0:
; OFF-NEXT:    vmulz.xyzw $vf1, $vf12, $vf13
; OFF-NEXT:    jr $ra
; OFF-NEXT:    vadd.xyzw $vf1, $vf14, $vf1
;
; ON-LABEL: madd_bc:
; ON:       # %bb.0:
; ON-NEXT:    vmulaw.xyzw $acc, $vf14, $vf0
; ON-NEXT:    jr $ra
; ON-NEXT:    vmaddz.xyzw $vf1, $vf12, $vf13
  %bz = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %m = fmul fast <4 x float> %a, %bz
  %r = fadd fast <4 x float> %c, %m
  ret <4 x float> %r
}

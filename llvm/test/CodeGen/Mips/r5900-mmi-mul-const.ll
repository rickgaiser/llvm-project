; R5900 MMI multiplies by a splat constant of the form +-2^a +- 2^b are
; shifts (PSLLW, PSLLH) and an add or subtract (PADDW, PSUBW); other
; constants are multiplied element by element.

define <4 x i32> @mul3(<4 x i32> %a) {
; CHECK-LABEL: mul3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    # kill: def $r5_64 killed $r5_64 def $r5_128
; CHECK-NEXT:    # kill: def $r4_64 killed $r4_64 def $r4_128
; CHECK-NEXT:    pcpyld $1, $5, $4
; CHECK-NEXT:    psllw $2, $1, 1
; CHECK-NEXT:    paddw $2, $2, $1
; CHECK-NEXT:    # kill: def $r2_64 killed $r2_64 killed $r2_128
; CHECK-NEXT:    # kill: def $r3_64 killed $r3_64 killed $r3_128
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    pcpyud $3, $2, $2
  %m = mul <4 x i32> %a, splat (i32 3)
  ret <4 x i32> %m
}


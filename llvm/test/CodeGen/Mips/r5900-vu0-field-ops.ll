; An operation on two broadcasts is one on a field, broadcast:
; c + a.y * b.z is VMULz t, a, b and VADDy d, c, t.
define <4 x float> @bcast_pair(<4 x float> %a, <4 x float> %b, <4 x float> %c) {
;
; CHECK-LABEL: bcast_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vmulz.xyzw $vf1, $vf12, $vf13
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    vaddy.xyzw $vf1, $vf14, $vf1
;
; OFF-LABEL: bcast_pair:
; OFF:       # %bb.0:
; OFF-NEXT:    vsub.xyzw $vf1, $vf12, $vf12
; OFF-NEXT:    vaddy.xyzw $vf1, $vf1, $vf12
; OFF-NEXT:    vmulz.xyzw $vf1, $vf1, $vf13
; OFF-NEXT:    jr $ra
; OFF-NEXT:    vadd.xyzw $vf1, $vf14, $vf1
  %sa = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %sb = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %p = fmul <4 x float> %sa, %sb
  %r = fadd <4 x float> %c, %p
  ret <4 x float> %r
}


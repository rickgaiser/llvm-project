; The 32-bit operations sign extend their result to 64 bits, so the zero
; extension of an i32 whose sign bit is known to be zero is selected like a
; sign extension (nneg). After a set on less than, clz or andi, bits 32-63
; are zero already and no instruction is needed.

declare void @ext16(i32 signext, i16 zeroext)
declare i32 @llvm.ctlz.i32(i32, i1)

; A narrow unsigned argument: the srl result needs no extension.
define void @narrow_arg(i32 signext %a, i32 signext %x) nounwind {
; R5900-LABEL: narrow_arg:
; R5900:       # %bb.0:
; R5900-NEXT:    j ext16
; R5900-NEXT:    srl $5, $5, 16
;
; MIPS64R2-LABEL: narrow_arg:
; MIPS64R2:       # %bb.0:
; MIPS64R2-NEXT:    daddiu $sp, $sp, -16
; MIPS64R2-NEXT:    sd $ra, 8($sp) # 8-byte Folded Spill
; MIPS64R2-NEXT:    jal ext16
; MIPS64R2-NEXT:    srl $5, $5, 16
; MIPS64R2-NEXT:    ld $ra, 8($sp) # 8-byte Folded Reload
; MIPS64R2-NEXT:    jr $ra
; MIPS64R2-NEXT:    daddiu $sp, $sp, 16
  %s = lshr i32 %x, 16
  %t = trunc i32 %s to i16
  tail call void @ext16(i32 signext %a, i16 zeroext %t)
  ret void
}

define i64 @setcc_zext(i64 %a, i64 %b) nounwind {
; R5900-LABEL: setcc_zext:
; R5900:       # %bb.0:
; R5900-NEXT:    jr $ra
; R5900-NEXT:    sltu $2, $4, $5
;
; MIPS64R2-LABEL: setcc_zext:
; MIPS64R2:       # %bb.0:
; MIPS64R2-NEXT:    jr $ra
; MIPS64R2-NEXT:    sltu $2, $4, $5
  %c = icmp ult i64 %a, %b
  %r = zext i1 %c to i64
  ret i64 %r
}


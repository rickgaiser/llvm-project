# RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi=n32 -run-pass=mips-r5900-issue \
# RUN:   -mips-r5900-issue-nop-limit=8 -pass-remarks-analysis=mips-r5900-issue %s \
# RUN:   -o /dev/null 2>&1 | FileCheck %s --check-prefix=LIMIT

# The R5900 issues two instructions together only if they are in the same
# aligned 8-byte block.

# A load and its use in one block, then two independent additions (T3 in the
# bench): 4 cycles per repetition (measured). Interleaving the repetitions
# pairs each load with an addition.
# REMARK: t3 %bb.1, slot 0: 9 -> 5 cycles, 0 nops
--- |
  define void @t3() { ret void }
  define void @anti_dep() { ret void }
  define void @sum_pf0() { ret void }
  define void @sum_no_loop() { ret void }
  define void @sum_optsize() optsize { ret void }
...
---
name: t3
alignment: 8
body: |
  ; CHECK-LABEL: name: t3
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 8):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r9 = LW $r24, 0 :: (load (s32))
  ; CHECK-NEXT:   $r12 = ADDu $r13, $r14
  ; CHECK-NEXT:   $r2 = LW $r24, 4 :: (load (s32))
  ; CHECK-NEXT:   $r15 = ADDu $r13, $r14
  ; CHECK-NEXT:   $r10 = ADDu $r9, $r11
  ; CHECK-NEXT:   $r5 = ADDu $r13, $r14
  ; CHECK-NEXT:   $r3 = ADDu $r2, $r11
  ; CHECK-NEXT:   $r6 = ADDu $r13, $r14
  ; CHECK-NEXT:   BNE $r7, $r0, %bb.1, implicit-def $r1 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoReturn $r31 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1

  bb.1 (align 8):
    successors: %bb.1, %bb.2

    $r9 = LW $r24, 0 :: (load (s32))
    $r10 = ADDu $r9, $r11
    $r12 = ADDu $r13, $r14
    $r15 = ADDu $r13, $r14
    $r2 = LW $r24, 4 :: (load (s32))
    $r3 = ADDu $r2, $r11
    $r5 = ADDu $r13, $r14
    $r6 = ADDu $r13, $r14
    BNE $r7, $r0, %bb.1, implicit-def $r1 {
      $r0 = SLL $r0, 0
    }

  bb.2:
    PseudoReturn $r31 {
      $r0 = SLL $r0, 0
    }
...

# The load of $r9 must stay after the addition that reads the old $r9, even
# though it would be faster to start it first.
# REMARK: anti_dep %bb.1, slot 0: 7 -> 7 cycles, 0 nops
---
name: anti_dep
alignment: 8
body: |
  ; CHECK-LABEL: name: anti_dep
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (align 8):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}

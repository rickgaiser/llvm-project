  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PseudoReturn $r31 {
  ; CHECK-NEXT:     $r0 = SLL $r0, 0
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1

  bb.1 (align 8):
    successors: %bb.1, %bb.2

    $r11 = LW $r24, 8 :: (load (s32))
    $r10 = ADDu $r9, $r11
    $r9 = LW $r24, 0 :: (load (s32))
    $r12 = ADDu $r9, $r14
    BNE $r7, $r0, %bb.1, implicit-def $r1 {
      $r0 = SLL $r0, 0
    }

  bb.2:
    PseudoReturn $r31 {
      $r0 = SLL $r0, 0
    }

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=+vu0 -target-abi n32 < %s | FileCheck %s

; v4f32 to and from v4i32 in a 128-bit GPR: VFTOI0 and QMFC2, QMTC2 and
; VITOF0. An unsigned conversion to v4i32 also converts X - 2^31 and selects
; that result with the sign bit set where it is not negative.

define void @fptosi(ptr %p, ptr %q) {
; CHECK-LABEL: fptosi:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    lqc2 $$vf1, 0($1)
; CHECK-NEXT:    vftoi0.xyzw $$vf1, $$vf1
; CHECK-NEXT:    qmfc2 $1, $$vf1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sq $1, 0($2)
  %v = load <4 x float>, ptr %q, align 16
  %c = fptosi <4 x float> %v to <4 x i32>
  store <4 x i32> %c, ptr %p, align 16
  ret void
}

define void @sitofp(ptr %p, ptr %q) {
; CHECK-LABEL: sitofp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    lq $1, 0($1)
; CHECK-NEXT:    qmtc2 $1, $$vf1
; CHECK-NEXT:    sll $1, $4, 0
; CHECK-NEXT:    vitof0.xyzw $$vf1, $$vf1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sqc2 $$vf1, 0($1)
  %v = load <4 x i32>, ptr %q, align 16
  %c = sitofp <4 x i32> %v to <4 x float>
  store <4 x float> %c, ptr %p, align 16
  ret void
}

define void @fptoui(ptr %p, ptr %q) {
; CHECK-LABEL: fptoui:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    lqc2 $$vf1, 0($1)
; CHECK-NEXT:    lui $1, %hi(.LCPI2_0)
; CHECK-NEXT:    lqc2 $$vf2, %lo(.LCPI2_0)($1)
; CHECK-NEXT:    pnor $2, $zero, $zero
; CHECK-NEXT:    vsub.xyzw $$vf2, $$vf1, $$vf2
; CHECK-NEXT:    vftoi0.xyzw $$vf1, $$vf1
; CHECK-NEXT:    vftoi0.xyzw $$vf2, $$vf2
; CHECK-NEXT:    qmfc2 $5, $$vf1
; CHECK-NEXT:    qmfc2 $1, $$vf2
; CHECK-NEXT:    pcgtw $3, $1, $2
; CHECK-NEXT:    pxor $1, $1, $5
; CHECK-NEXT:    psllw $2, $2, 31
; CHECK-NEXT:    pxor $1, $1, $2
; CHECK-NEXT:    pand $1, $1, $3
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    pxor $1, $5, $1
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sq $1, 0($2)
  %v = load <4 x float>, ptr %q, align 16
  %c = fptoui <4 x float> %v to <4 x i32>
  store <4 x i32> %c, ptr %p, align 16
  ret void
}

; RUN: llc -mtriple=mips64el -mcpu=r5900 -mattr=-fix-r5900 < %s | FileCheck %s

; Disabling the short loop erratum fix must not disable the rest of the R5900
; support: the multiply still uses the R5900 3-operand MULT.

define i32 @mul(i32 %a, i32 %b) {
; CHECK-LABEL: mul:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    mult $2, $2, $1
  %r = mul i32 %a, %b
  ret i32 %r
}

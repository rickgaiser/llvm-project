; The R5900 dual-issues only the two instructions of an aligned 8-byte block,
; so loop headers are aligned to 8 bytes.

define i32 @sum(ptr %p, i32 %n) {
; R5900-LABEL: sum:
; R5900:       # %bb.0: # %entry
; R5900-NEXT:    sll $2, $5, 0
; R5900-NEXT:    blez $2, .LBB0_4
; R5900-NEXT:    nop
; R5900-NEXT:  # %bb.1: # %loop.preheader
; R5900-NEXT:    sll $3, $4, 0
; R5900-NEXT:    sll $1, $2, 2
; R5900-NEXT:    addiu $2, $zero, 0
; R5900-NEXT:    addu $4, $3, $1
; R5900-NEXT:    .p2align 3
; R5900-NEXT:  .LBB0_2: # %loop
; R5900-NEXT:    # =>This Inner Loop Header: Depth=1
; R5900-NEXT:    lw $1, 0($3)
; R5900-NEXT:    addiu $3, $3, 4
; R5900-NEXT:    addu $2, $2, $1
; R5900-NEXT:    bne $3, $4, .LBB0_2
; R5900-NEXT:    nop
; R5900-NEXT:  # %bb.3: # %exit
; R5900-NEXT:    jr $ra
; R5900-NEXT:    nop
; R5900-NEXT:  .LBB0_4:
; R5900-NEXT:    jr $ra
; R5900-NEXT:    addiu $2, $zero, 0
;
; MIPS3-LABEL: sum:
; MIPS3:       # %bb.0: # %entry
; MIPS3-NEXT:    sll $2, $5, 0
; MIPS3-NEXT:    blez $2, .LBB0_4
; MIPS3-NEXT:    nop
; MIPS3-NEXT:  # %bb.1: # %loop.preheader
; MIPS3-NEXT:    sll $3, $4, 0
; MIPS3-NEXT:    sll $1, $2, 2
; MIPS3-NEXT:    addu $4, $3, $1
; MIPS3-NEXT:    addiu $2, $zero, 0
; MIPS3-NEXT:  .LBB0_2: # %loop
; MIPS3-NEXT:    # =>This Inner Loop Header: Depth=1
; MIPS3-NEXT:    lw $1, 0($3)
; MIPS3-NEXT:    addiu $3, $3, 4
; MIPS3-NEXT:    bne $3, $4, .LBB0_2
; MIPS3-NEXT:    addu $2, $2, $1
; MIPS3-NEXT:  # %bb.3: # %exit
; MIPS3-NEXT:    jr $ra
; MIPS3-NEXT:    nop
; MIPS3-NEXT:  .LBB0_4:
; MIPS3-NEXT:    jr $ra
; MIPS3-NEXT:    addiu $2, $zero, 0
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  %gep = getelementptr inbounds i32, ptr %p, i32 %i
  %v = load i32, ptr %gep
  %s.next = add i32 %s, %v
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  %r = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  ret i32 %r
}

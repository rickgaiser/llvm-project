; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; Scalar i32 operations selected as MMI instructions work on each 32-bit word
; of the 64-bit register. An i32 must stay sign-extended, because 64-bit
; instructions like SLTIU read the whole register. PABSW of a negative value
; gives 1 in the upper word, and the saturating operations can give other
; upper words, so their results are sign-extended with SLL 0. PMAXW and PMINW
; keep sign-extended inputs sign-extended.

; |d| < 5 for d = -1: without the SLL, the upper word was 1 and SLTIU failed.
define i1 @abs_ult(i32 %a, i32 %b) {
; CHECK-LABEL: abs_ult:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    subu $1, $2, $1
; CHECK-NEXT:    pabsw $1, $1
; CHECK-NEXT:    sll $1, $1, 0
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sltiu $2, $1, 5
  %d = sub i32 %a, %b
  %abs = call i32 @llvm.abs.i32(i32 %d, i1 false)
  %r = icmp ult i32 %abs, 5
  ret i1 %r
}


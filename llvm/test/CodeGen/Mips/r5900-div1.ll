; RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -verify-machineinstrs < %s | FileCheck %s

; The R5900 pipe 1 divider runs in parallel with the pipe 0 one, so a divide
; that is independent of the previous one uses DIV1/DIVU1 and MFLO1/MFHI1.

define void @two(i32 %a, i32 %b, i32 %c, i32 %d, ptr %p) {
; CHECK-LABEL: two:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    div $zero, $2, $1
; CHECK-NEXT:    sll $2, $7, 0
; CHECK-NEXT:    sll $3, $6, 0
; CHECK-NEXT:    sll $4, $8, 0
; CHECK-NEXT:    div1 $zero, $3, $2
; CHECK-NEXT:    teq $1, $zero, 7
; CHECK-NEXT:    mflo $3
; CHECK-NEXT:    mflo1 $1
; CHECK-NEXT:    teq $2, $zero, 7
; CHECK-NEXT:    sw $3, 0($4)
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    sw $1, 4($4)
  %x = sdiv i32 %a, %b
  %y = sdiv i32 %c, %d
  store i32 %x, ptr %p
  %q = getelementptr i32, ptr %p, i32 1
  store i32 %y, ptr %q
  ret void
}

define i32 @divrem(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: divrem:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $7, 0
; CHECK-NEXT:    sll $3, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    sll $4, $6, 0
; CHECK-NEXT:    divu $zero, $2, $3
; CHECK-NEXT:    divu1 $zero, $4, $1
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    mfhi1 $4
; CHECK-NEXT:    teq $3, $zero, 7
; CHECK-NEXT:    addu $2, $2, $4
; CHECK-NEXT:    teq $1, $zero, 7
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %x = udiv i32 %a, %b
  %y = urem i32 %c, %d
  %r = add i32 %x, %y
  ret i32 %r
}

; The dividers alternate: the third divide waits for the first.
define i32 @three(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e, i32 %f) {
; CHECK-LABEL: three:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    div $zero, $2, $1
; CHECK-NEXT:    sll $4, $7, 0
; CHECK-NEXT:    sll $2, $6, 0
; CHECK-NEXT:    sll $3, $9, 0
; CHECK-NEXT:    sll $6, $8, 0
; CHECK-NEXT:    div1 $zero, $2, $4
; CHECK-NEXT:    mflo $5
; CHECK-NEXT:    div $zero, $6, $3
; CHECK-NEXT:    mflo1 $2
; CHECK-NEXT:    teq $1, $zero, 7
; CHECK-NEXT:    addu $2, $5, $2
; CHECK-NEXT:    teq $4, $zero, 7
; CHECK-NEXT:    teq $3, $zero, 7
; CHECK-NEXT:    mflo $6
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addu $2, $2, $6
  %x = sdiv i32 %a, %b
  %y = sdiv i32 %c, %d
  %z = sdiv i32 %e, %f
  %s = add i32 %x, %y
  %t = add i32 %s, %z
  ret i32 %t
}

; A divide of the result of the previous one keeps the pipe 0 divider.
define i32 @chain(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: chain:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sll $1, $5, 0
; CHECK-NEXT:    sll $2, $4, 0
; CHECK-NEXT:    div $zero, $2, $1
; CHECK-NEXT:    sll $3, $6, 0
; CHECK-NEXT:    teq $1, $zero, 7
; CHECK-NEXT:    teq $3, $zero, 7
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    addiu $2, $2, 1
; CHECK-NEXT:    div $zero, $2, $3
; CHECK-NEXT:    mflo $2
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    nop
  %x = sdiv i32 %a, %b
  %s = add i32 %x, 1
  %y = sdiv i32 %s, %c
  ret i32 %y
}

; The results are read before the call, which clobbers HI1/LO1.
declare void @f()

define i32 @call_after(i32 %a, i32 %b, i32 %c, i32 %d) {
; CHECK-LABEL: call_after:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addiu $sp, $sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    sd $ra, 24($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd $17, 16($sp) # 8-byte Folded Spill
; CHECK-NEXT:    sd $16, 8($sp) # 8-byte Folded Spill
; CHECK-NEXT:    .cfi_offset 31, -8
; CHECK-NEXT:    .cfi_offset 17, -16
; CHECK-NEXT:    .cfi_offset 16, -24
; CHECK-NEXT:    sll $1, $7, 0
; CHECK-NEXT:    sll $2, $5, 0
; CHECK-NEXT:    sll $3, $4, 0
; CHECK-NEXT:    sll $4, $6, 0
; CHECK-NEXT:    div $zero, $3, $2
; CHECK-NEXT:    teq $2, $zero, 7
; CHECK-NEXT:    div1 $zero, $4, $1
; CHECK-NEXT:    teq $1, $zero, 7
; CHECK-NEXT:    mflo $16
; CHECK-NEXT:    mflo1 $17
; CHECK-NEXT:    jal f
; CHECK-NEXT:    nop
; CHECK-NEXT:    addu $2, $16, $17
; CHECK-NEXT:    ld $16, 8($sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld $17, 16($sp) # 8-byte Folded Reload
; CHECK-NEXT:    ld $ra, 24($sp) # 8-byte Folded Reload
; CHECK-NEXT:    jr $ra
; CHECK-NEXT:    addiu $sp, $sp, 32
  %x = sdiv i32 %a, %b
  %y = sdiv i32 %c, %d
  call void @f()
  %s = add i32 %x, %y
  ret i32 %s
}


; A mask of 16 compares of floats and its byte and word zero extensions: the
; mask as words (sext, and for the select), the extensions its low bits.
define <16 x i32> @word_mask(<16 x float> %a, <16 x float> %b, <16 x float> %c, ptr %out) {
; CHECK-LABEL: define <16 x i32> @word_mask(
; CHECK-SAME: <16 x float> [[A:%.*]], <16 x float> [[B:%.*]], <16 x float> [[C:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[M1:%.*]] = fcmp fast uge <16 x float> [[A]], [[B]]
; CHECK-NEXT:    [[M2:%.*]] = fcmp fast uge <16 x float> [[C]], [[B]]
; CHECK-NEXT:    [[TMP1:%.*]] = sext <16 x i1> [[M1]] to <16 x i32>
; CHECK-NEXT:    [[TMP2:%.*]] = sext <16 x i1> [[M2]] to <16 x i32>
; CHECK-NEXT:    [[TMP3:%.*]] = and <16 x i32> [[TMP1]], [[TMP2]]
; CHECK-NEXT:    [[W:%.*]] = and <16 x i32> [[TMP3]], splat (i32 1)
; CHECK-NEXT:    [[Z:%.*]] = trunc <16 x i32> [[W]] to <16 x i8>
; CHECK-NEXT:    store <16 x i8> [[Z]], ptr [[OUT]], align 16
; CHECK-NEXT:    ret <16 x i32> [[W]]
;
  %m1 = fcmp fast uge <16 x float> %a, %b
  %m2 = fcmp fast uge <16 x float> %c, %b
  %m = select <16 x i1> %m1, <16 x i1> %m2, <16 x i1> zeroinitializer
  %w = zext <16 x i1> %m to <16 x i32>
  %z = zext <16 x i1> %m to <16 x i8>
  store <16 x i8> %z, ptr %out, align 16
  ret <16 x i32> %w
}

; CHECK-NEXT:    [[L2:%.*]] = load <8 x i16>, ptr [[TMP5]], align 4
; CHECK-NEXT:    [[X2:%.*]] = sext <8 x i16> [[L2]] to <8 x i32>
; CHECK-NEXT:    [[M2:%.*]] = mul nsw <8 x i32> [[C2]], [[X2]]
; CHECK-NEXT:    [[TMP6:%.*]] = add <8 x i32> [[M2]], [[TMP4]]
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 6
; CHECK-NEXT:    [[L3:%.*]] = load <8 x i16>, ptr [[TMP7]], align 2

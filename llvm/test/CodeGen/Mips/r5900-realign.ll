  %s1 = add nsw <8 x i32> %m1, %c0
  %p2 = getelementptr i8, ptr @buf, i32 4
  %l2 = load <8 x i16>, ptr %p2, align 4
  %x2 = sext <8 x i16> %l2 to <8 x i32>

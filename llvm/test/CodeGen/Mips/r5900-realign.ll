; Unaligned 128-bit loads at a constant offset from a 16-byte aligned pointer
; are rebased on llvm.ptrmask of it, so that the SelectionDAG sees the
; alignment; at a multiple of 16 bytes they are aligned. A pointer with more
; than 2 shift amounts (offset & 15) in a block, or of unknown alignment, is
; left alone.

target datalayout = "e-m:e-p:32:32-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "mips64el-unknown-unknown-gnuabin32"

@buf = global [64 x i16] zeroinitializer, align 16

define <8 x i16> @two_shifts() {
; CHECK-LABEL: define <8 x i16> @two_shifts(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[BUF_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr @buf, i32 -16)
; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 2
; CHECK-NEXT:    [[A:%.*]] = load <8 x i16>, ptr [[TMP1]], align 2
; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 18
; CHECK-NEXT:    [[B:%.*]] = load <8 x i16>, ptr [[TMP2]], align 2
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 4
; CHECK-NEXT:    [[C:%.*]] = load <8 x i16>, ptr [[TMP3]], align 4
; CHECK-NEXT:    [[S:%.*]] = add <8 x i16> [[A]], [[B]]
; CHECK-NEXT:    [[T:%.*]] = add <8 x i16> [[S]], [[C]]
; CHECK-NEXT:    ret <8 x i16> [[T]]
;
  %p = getelementptr i8, ptr @buf, i32 2
  %q = getelementptr i8, ptr @buf, i32 18
  %r = getelementptr i8, ptr @buf, i32 4
  %a = load <8 x i16>, ptr %p, align 2
  %b = load <8 x i16>, ptr %q, align 2
  %c = load <8 x i16>, ptr %r, align 4
  %s = add <8 x i16> %a, %b
  %t = add <8 x i16> %s, %c
  ret <8 x i16> %t
}


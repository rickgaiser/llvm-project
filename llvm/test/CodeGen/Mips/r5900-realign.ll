; CHECK-NEXT:    [[TMP1:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 2
; CHECK-NEXT:    [[L1:%.*]] = load <8 x i16>, ptr [[TMP1]], align 2
; CHECK-NEXT:    [[X1:%.*]] = sext <8 x i16> [[L1]] to <8 x i32>
; CHECK-NEXT:    [[M1:%.*]] = mul nsw <8 x i32> [[C1]], [[X1]]
; CHECK-NEXT:    [[TMP2:%.*]] = add <8 x i32> [[M1]], [[C0]]
; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[BUF_ALIGNED]], i32 18
; CHECK-NEXT:    [[L4:%.*]] = load <8 x i16>, ptr [[TMP3]], align 2
; CHECK-NEXT:    [[X4:%.*]] = sext <8 x i16> [[L4]] to <8 x i32>
; CHECK-NEXT:    [[M4:%.*]] = mul nsw <8 x i32> [[C4]], [[X4]]

# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=mips64el -mcpu=r5900 -target-abi n32 -run-pass=prolog-epilog -verify-machineinstrs -o - %s | FileCheck %s

# Spills and copies of the R5900 pipe 1 accumulator go through MFHI1/MFLO1
# and MTHI1/MTLO1.

---
name:            spill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: spill
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r29 = ADDiu $r29, -16
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 16
    ; CHECK-NEXT: DIV1 $r4, $r5, implicit-def $hi1, implicit-def $lo1
    ; CHECK-NEXT: $r1 = PseudoMFLO1 $ac1
    ; CHECK-NEXT: SW killed $r1, $r29, 8 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: $r1 = PseudoMFHI1 killed $ac1
    ; CHECK-NEXT: SW killed $r1, $r29, 12 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: $r1 = LW $r29, 8 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: $lo1 = COPY killed $r1
    ; CHECK-NEXT: $r1 = LW $r29, 12 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: $hi1 = COPY killed $r1
    ; CHECK-NEXT: $r2 = PseudoMFLO1 killed $ac1
    ; CHECK-NEXT: $r29 = ADDiu $r29, 16
    ; CHECK-NEXT: RetRA implicit $r2
    DIV1 $r4, $r5, implicit-def $hi1, implicit-def $lo1
    STORE_ACC64_1 killed $ac1, %stack.0, 0
    $ac1 = LOAD_ACC64_1 %stack.0, 0
    $r2 = PseudoMFLO1 killed $ac1
    RetRA implicit $r2
...
---
name:            copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: copy
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r29 = ADDiu $r29, -16
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 16
    ; CHECK-NEXT: DIV1 $r4, $r5, implicit-def $hi1, implicit-def $lo1
    ; CHECK-NEXT: $r1 = PseudoMFLO1 $ac1
    ; CHECK-NEXT: $lo0 = COPY killed $r1
    ; CHECK-NEXT: $r1 = PseudoMFHI1 killed $ac1
    ; CHECK-NEXT: $hi0 = COPY killed $r1
    ; CHECK-NEXT: $r1 = PseudoMFLO $ac0
    ; CHECK-NEXT: $lo1 = COPY killed $r1
    ; CHECK-NEXT: $r1 = PseudoMFHI killed $ac0
    ; CHECK-NEXT: $hi1 = COPY killed $r1
    ; CHECK-NEXT: $r2 = PseudoMFLO1 killed $ac1
    ; CHECK-NEXT: $r29 = ADDiu $r29, 16
    ; CHECK-NEXT: RetRA implicit $r2
    DIV1 $r4, $r5, implicit-def $hi1, implicit-def $lo1
    $ac0 = COPY killed $ac1
    $ac1 = COPY killed $ac0
    $r2 = PseudoMFLO1 killed $ac1
    RetRA implicit $r2
...

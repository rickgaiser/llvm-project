; RUN: llc -mtriple=vu -verify-machineinstrs -debug-only=pipeliner < %s \
; RUN:   -o /dev/null 2>&1 | FileCheck %s
; REQUIRES: asserts

; A point light: a square root and two divisions per vertex, all through Q,
; which is not renamed between iterations. A schedule in which an iteration
; writes Q while the value of another iteration is still needed is rejected.

; CHECK: Invalid schedule: $q is live from cycle

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq.mask(<4 x float>, i16, i32)
declare float @llvm.maxnum.f32(float, float)
declare float @llvm.sqrt.f32(float)

define void @point_light() {
entry:
  %lpos = call <4 x float> @llvm.vu.lq(i16 0)
  %att = call <4 x float> @llvm.vu.lq(i16 1)
  %lcol = call <4 x float> @llvm.vu.lq(i16 2)
  %amb = call <4 x float> @llvm.vu.lq(i16 3)
  %k0 = extractelement <4 x float> %att, i32 0
  %k1 = extractelement <4 x float> %att, i32 1
  %k2 = extractelement <4 x float> %att, i32 2
  br label %loop

loop:
  %i = phi i16 [ 10, %entry ], [ %i.next, %loop ]
  %pos = call <4 x float> @llvm.vu.lq(i16 %i)
  %i1 = add i16 %i, 1
  %nrm = call <4 x float> @llvm.vu.lq(i16 %i1)
  %d = fsub <4 x float> %lpos, %pos
  %dd = fmul <4 x float> %d, %d
  %ddx = extractelement <4 x float> %dd, i32 0
  %ddy = extractelement <4 x float> %dd, i32 1
  %ddz = extractelement <4 x float> %dd, i32 2
  %ddyz = fadd float %ddy, %ddz
  %dist2 = fadd float %ddyz, %ddx
  %dist = call float @llvm.sqrt.f32(float %dist2)
  %a1 = fmul float %k1, %dist
  %a2 = fmul float %k2, %dist2
  %a01 = fadd float %k0, %a1
  %den = fadd float %a01, %a2
  %atten = fdiv float 1.0, %den
  %rdist = fdiv float 1.0, %dist
  %sr = insertelement <4 x float> poison, float %rdist, i32 0
  %br = shufflevector <4 x float> %sr, <4 x float> poison, <4 x i32> zeroinitializer
  %dir = fmul <4 x float> %d, %br
  %t = fmul <4 x float> %dir, %nrm
  %tx = extractelement <4 x float> %t, i32 0
  %ty = extractelement <4 x float> %t, i32 1
  %tz = extractelement <4 x float> %t, i32 2
  %tyz = fadd float %ty, %tz
  %dot = fadd float %tyz, %tx
  %ndl = call float @llvm.maxnum.f32(float %dot, float 0.0)
  %sk = insertelement <4 x float> poison, float %ndl, i32 0
  %bk = shufflevector <4 x float> %sk, <4 x float> poison, <4 x i32> zeroinitializer
  %c1 = fmul <4 x float> %lcol, %bk
  %c = fadd <4 x float> %c1, %amb
  %sa = insertelement <4 x float> poison, float %atten, i32 0
  %ba = shufflevector <4 x float> %sa, <4 x float> poison, <4 x i32> zeroinitializer
  %add = fmul <4 x float> %c, %ba
  %o = add i16 %i, 300
  %old = call <4 x float> @llvm.vu.lq(i16 %o)
  %new = fadd <4 x float> %old, %add
  call void @llvm.vu.sq.mask(<4 x float> %new, i16 %o, i32 14)
  %i.next = add i16 %i, 3
  %done = icmp eq i16 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

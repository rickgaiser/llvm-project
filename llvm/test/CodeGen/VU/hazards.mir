# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-hazards -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Q is valid 7 words after DIV or SQRT. A read that may come earlier, on any
# path, gets a WAITQ: in its own word if the lower half is free, otherwise in
# a word before it.

---
# The word of the read is a bundle with a free lower half already: the read in
# a delay slot.
name: bundled_word
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: bundled_word
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.1
  ; CHECK-NEXT:   BUNDLE implicit-def $q, implicit-def $vf3, implicit $q, implicit $vf2 {
  ; CHECK-NEXT:     WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:     $vf3 = MULq 15, $vf2, internal $q
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vi1
    $q = DIV $vf1, 3, $vf1, 3
    IBNE $vi1, $vi0, %bb.1
    BUNDLE implicit-def $vf3, implicit $vf2, implicit $q {
      $vf3 = MULq 15, $vf2, $q
      DELAY_SLOT
    }
  bb.1:
    PROGRAM_END
...

---
# The DIV of the previous iteration is only 2 words before the read.
name: loop_carried
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: loop_carried
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $q, implicit-def $vf3, implicit $q, implicit $vf2 {
  ; CHECK-NEXT:     WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:     $vf3 = MULq 15, $vf2, internal $q
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vi1, $q
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf2, $vi1, $q
    $vf3 = MULq 15, $vf2, $q
    $vi1 = IADDI $vi1, -1
    $q = DIV $vf1, 3, $vf1, 3
    IBNE $vi1, $vi0, %bb.1
  bb.2:
    PROGRAM_END
...
---
# 7 words later, Q is ready.
name: far_enough
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: far_enough
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = DIV $vf1, 3, $vf1, 3
    ; CHECK-NEXT: $vf4 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf5 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf6 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf7 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf8 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf9 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf3 = MULq 15, $vf2, $q
    ; CHECK-NEXT: PROGRAM_END
    $q = DIV $vf1, 3, $vf1, 3
    $vf4 = ADD 15, $vf2, $vf2
    $vf5 = ADD 15, $vf2, $vf2
    $vf6 = ADD 15, $vf2, $vf2
    $vf7 = ADD 15, $vf2, $vf2
    $vf8 = ADD 15, $vf2, $vf2
    $vf9 = ADD 15, $vf2, $vf2
    $vf3 = MULq 15, $vf2, $q
    PROGRAM_END
...
---
# The lower half of the reading word is in use.
name: own_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: own_word
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = SQRT $vf1, 0
    ; CHECK-NEXT: WAITQ implicit-def $q, implicit $q
    ; CHECK-NEXT: BUNDLE {
    ; CHECK-NEXT:   $vf3 = ADDq 8, $vf0, $q
    ; CHECK-NEXT:   $vf4 = LQ 15, 0, $vi0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    $q = SQRT $vf1, 0
    BUNDLE {
      $vf3 = ADDq 8, $vf0, $q
      $vf4 = LQ 15, 0, $vi0
    }
    PROGRAM_END
...

# The read is in a delay slot. No word may come between the branch and its
# delay slot, so the WAITQ goes in a word before the branch.
---
name: delay_slot
body: |
  ; CHECK-LABEL: name: delay_slot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.0(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.0
  ; CHECK-NEXT:   BUNDLE {
  ; CHECK-NEXT:     $vf3 = MULq 15, $vf2, $q
  ; CHECK-NEXT:     $vf4 = LQ 15, 0, $vi0
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $vf1, $vf2, $vi1

    $q = DIV $vf1, 3, $vf1, 3
    $vi1 = IADDI $vi1, -1
    NOP
    IBNE $vi1, $vi0, %bb.0
    BUNDLE {
      $vf3 = MULq 15, $vf2, $q
      $vf4 = LQ 15, 0, $vi0
      DELAY_SLOT
    }

  bb.1:
    PROGRAM_END
...

---
# The loop's own DIV is far enough from the read, the one before the loop is
# not: the loop waits once, in a block of its own on the way in.
name: entry_fallthrough
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: entry_fallthrough
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vf3 = MULq 15, $vf2, $q
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vi1, $vi2
    $q = DIV $vf1, 3, $vf1, 3
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf2, $vi1, $vi2, $q
    $vf3 = MULq 15, $vf2, $q
    $q = DIV $vf1, 3, $vf1, 3
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi1 = IADDI $vi1, -1
    IBNE $vi1, $vi0, %bb.1
  bb.2:
    PROGRAM_END
...

---
# The same, entered by a jump: the WAITQ goes before the branch.
name: entry_jump
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: entry_jump
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vf3 = MULq 15, $vf2, $q
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $vf1, $vf2, $vi1, $vi2
    $q = DIV $vf1, 3, $vf1, 3
    IBNE $vi1, $vi0, %bb.2
  bb.1:
    PROGRAM_END
  bb.2:
    successors: %bb.2, %bb.3
    liveins: $vf1, $vf2, $vi1, $vi2, $q
    $vf3 = MULq 15, $vf2, $q
    $q = DIV $vf1, 3, $vf1, 3
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi1 = IADDI $vi1, -1
    IBNE $vi1, $vi0, %bb.2
  bb.3:
    PROGRAM_END
...

---
# A DIV in the delay slot of the branch into the loop: a WAITQ before the
# branch would not cover it, so the loop waits.
name: entry_delay_slot
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: entry_delay_slot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.2
  ; CHECK-NEXT:   BUNDLE implicit-def $q, implicit $vf1 {
  ; CHECK-NEXT:     $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $vi2, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $q, implicit-def $vf3, implicit $q, implicit $vf2 {
  ; CHECK-NEXT:     WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:     $vf3 = MULq 15, $vf2, internal $q
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi2 = IADDI $vi2, 1
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $vf1, $vf2, $vi1, $vi2
    IBNE $vi1, $vi0, %bb.2
    BUNDLE implicit-def $q, implicit $vf1 {
      $q = DIV $vf1, 3, $vf1, 3
      DELAY_SLOT
    }
  bb.1:
    PROGRAM_END
  bb.2:
    successors: %bb.2, %bb.3
    liveins: $vf1, $vf2, $vi1, $vi2, $q
    $vf3 = MULq 15, $vf2, $q
    $q = DIV $vf1, 3, $vf1, 3
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi2 = IADDI $vi2, 1
    $vi1 = IADDI $vi1, -1
    IBNE $vi1, $vi0, %bb.2
  bb.3:
    PROGRAM_END
...

# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-hazards -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Q is valid 7 words after DIV or SQRT. A read that may come earlier, on any
# path, gets a WAITQ: in its own word if the lower half is free, otherwise in
# a word before it.

---
# The DIV of the previous iteration is only 2 words before the read.
name: loop_carried
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: loop_carried
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vi1, $q
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $q, implicit-def $vf3, implicit $q, implicit $vf2 {
  ; CHECK-NEXT:     WAITQ implicit-def $q, implicit $q
  ; CHECK-NEXT:     $vf3 = MULq 15, $vf2, internal $q
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   $q = DIV $vf1, 3, $vf1, 3
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vi1, $q
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf2, $vi1, $q
    $vf3 = MULq 15, $vf2, $q
    $vi1 = IADDI $vi1, -1
    $q = DIV $vf1, 3, $vf1, 3
    IBNE $vi1, $vi0, %bb.1
  bb.2:
    PROGRAM_END
...
---
# 7 words later, Q is ready.
name: far_enough
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: far_enough
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = DIV $vf1, 3, $vf1, 3
    ; CHECK-NEXT: $vf4 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf5 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf6 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf7 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf8 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf9 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf3 = MULq 15, $vf2, $q
    ; CHECK-NEXT: PROGRAM_END
    $q = DIV $vf1, 3, $vf1, 3
    $vf4 = ADD 15, $vf2, $vf2
    $vf5 = ADD 15, $vf2, $vf2
    $vf6 = ADD 15, $vf2, $vf2
    $vf7 = ADD 15, $vf2, $vf2
    $vf8 = ADD 15, $vf2, $vf2
    $vf9 = ADD 15, $vf2, $vf2
    $vf3 = MULq 15, $vf2, $q
    PROGRAM_END
...
---
# The lower half of the reading word is in use.
name: own_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: own_word
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = SQRT $vf1, 0
    ; CHECK-NEXT: WAITQ implicit-def $q, implicit $q
    ; CHECK-NEXT: BUNDLE {
    ; CHECK-NEXT:   $vf3 = ADDq 8, $vf0, $q
    ; CHECK-NEXT:   $vf4 = LQ 15, 0, $vi0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    $q = SQRT $vf1, 0
    BUNDLE {
      $vf3 = ADDq 8, $vf0, $q
      $vf4 = LQ 15, 0, $vi0
    }
    PROGRAM_END
...

  %pos = call <4 x float> @llvm.vu.lq(i16 %pi), !alias.scope !3, !noalias !4
  %pc = add i16 %pi, 1
  %col = call <4 x float> @llvm.vu.lq(i16 %pc), !alias.scope !3, !noalias !4
  %x = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> zeroinitializer
  %y = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %z = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %t0 = fmul fast <4 x float> %m0, %x
  %t1 = fmul fast <4 x float> %m1, %y
  %t2 = fmul fast <4 x float> %m2, %z
  %s0 = fadd fast <4 x float> %t0, %t1
  %s1 = fadd fast <4 x float> %s0, %t2
  %p = fadd fast <4 x float> %s1, %m3
  %w = extractelement <4 x float> %p, i32 3
  %q = fdiv fast float 1.0, %w
  %qs = insertelement <4 x float> poison, float %q, i32 0
  %qv = shufflevector <4 x float> %qs, <4 x float> poison, <4 x i32> zeroinitializer
  %pq = fmul fast <4 x float> %p, %qv
  %fx = fmul fast <4 x float> %pq, <float 16.0, float 16.0, float 16.0, float 16.0>
  %ix = fptosi <4 x float> %fx to <4 x i32>
  %xyz = bitcast <4 x i32> %ix to <4 x float>

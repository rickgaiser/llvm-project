entry:
  %top = call i16 @llvm.vu.xtop()
  %nl = call i16 @llvm.vu.ilw(i16 %top, i32 0)
  %n = and i16 %nl, 32767
  %tag = call <4 x float> @llvm.vu.lq(i16 %top)
  %a1 = add i16 %top, 1
  %m0 = call <4 x float> @llvm.vu.lq(i16 %a1)
  %a2 = add i16 %top, 2
  %m1 = call <4 x float> @llvm.vu.lq(i16 %a2)
  %a3 = add i16 %top, 3
  %m2 = call <4 x float> @llvm.vu.lq(i16 %a3)
  %a4 = add i16 %top, 4
  %m3 = call <4 x float> @llvm.vu.lq(i16 %a4)
  %in = add i16 %top, 5
  %out = add i16 %in, 240
  call void @llvm.vu.sq(<4 x float> %tag, i16 %out)
  %o1 = add i16 %out, 1
  %empty = icmp eq i16 %n, 0
  br i1 %empty, label %done, label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i1, %loop ]

; A value that lives longer than one iteration is copied in every iteration,
; with a MOVE in the lower slot, unless the kernel is unrolled for it (modulo
; variable expansion). A schedule is only used if its instructions and the
; branch, and the copies if they stay, fit in II words: the load, the store,
; the increment and the branch do not fit in 3 words, and at II 4 the product
; lives longer than an iteration, so the kernel is unrolled.
; CHECK: Minimal Initiation Interval: 3 (ResMII 3, RecMII 2)
; CHECK: Schedule found with Initiation Interval: 4
; NOREDUCE: Schedule found with Initiation Interval: 4
; STAGES3: Schedule found with Initiation Interval: 4
; COPIES: VU: II 3 needs 1 upper and 4 lower words, unrolled for 2 copies
; COPIES: VU: II 4 needs 1 upper and 4 lower words, unrolled for 1 copies

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

define void @scale_loop() {
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %v = call <4 x float> @llvm.vu.lq(i16 %i)
  %s = fmul <4 x float> %v, <float 3.0, float 3.0, float 3.0, float 3.0>
  call void @llvm.vu.sq(<4 x float> %s, i16 %i)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; The second load is only needed at the end of the chain. As early as
; possible, it lives for two iterations, and the sum lives longer than one
; as the store has no free lower slot. The pipeliner moves the load next to
; its use and the store next to the sum, each time with the increment out of
; the way. Without that, the kernel is unrolled for the copies.
; CHECK: Minimal Initiation Interval: 4 (ResMII 4, RecMII 2)
; CHECK: Schedule found with Initiation Interval: 5, MaxStageCount: 3
; NOREDUCE: Schedule found with Initiation Interval: 5
; STAGES3: Schedule found with Initiation Interval: 5, MaxStageCount: 3
; COPIES: VU: II 4 needs 4 upper and 5 lower words, unrolled for 2 copies
; COPIES: VU: II 5 needs 4 upper and 5 lower words{{$}}
define void @late_load() {
entry:
  %k = call <4 x float> @llvm.vu.lq(i16 0)
  br label %loop

loop:
  %i = phi i16 [ 1, %entry ], [ %i.next, %loop ]
  %v = call <4 x float> @llvm.vu.lq(i16 %i)
  %t = fmul <4 x float> %v, %k
  %u = fmul <4 x float> %t, %t
  %w = fmul <4 x float> %u, %u
  %o = add i16 %i, 200
  %old = call <4 x float> @llvm.vu.lq(i16 %o)
  %new = fadd <4 x float> %old, %w
  call void @llvm.vu.sq(<4 x float> %new, i16 %o)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; A chain of five products takes more than 20 cycles; at II 5, that is more
; stages than the default limit of other targets allows.
; CHECK: Minimal Initiation Interval: 5 (ResMII 5, RecMII 2)
; CHECK: Schedule found with Initiation Interval: 5, MaxStageCount: 5
; STAGES3: Schedule found with Initiation Interval: 7, MaxStageCount: 3
define void @long_chain() {
entry:
  br label %loop

loop:
  %i = phi i16 [ 1, %entry ], [ %i.next, %loop ]
  %v = call <4 x float> @llvm.vu.lq(i16 %i)
  %a = fmul <4 x float> %v, %v
  %b = fmul <4 x float> %a, %a
  %c = fmul <4 x float> %b, %b
  %d = fmul <4 x float> %c, %c
  %e = fmul <4 x float> %d, %d
  %o = add i16 %i, 200
  call void @llvm.vu.sq(<4 x float> %e, i16 %o)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

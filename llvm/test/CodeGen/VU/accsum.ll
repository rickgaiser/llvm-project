; CHECK-NEXT:    nop lq.xyzw vf2, 4(vi0)
; CHECK-NEXT:    nop lq.xyzw vf3, 1(vi0)
; CHECK-NEXT:    nop lq.xyzw vf4, 2(vi0)
; CHECK-NEXT:    nop lq.xyzw vf5, 3(vi0)
; CHECK-NEXT:    mulax.xyzw acc, vf1, vf2x nop
; CHECK-NEXT:    madday.xyzw acc, vf3, vf2y nop
; CHECK-NEXT:    maddaz.xyzw acc, vf4, vf2z nop
; CHECK-NEXT:    maddw.xyzw vf1, vf5, vf0w nop
; CHECK-NEXT:    nop sq.xyzw vf1, 5(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %m0 = call <4 x float> @llvm.vu.lq(i16 0)
  %m1 = call <4 x float> @llvm.vu.lq(i16 1)
  %m2 = call <4 x float> @llvm.vu.lq(i16 2)
  %m3 = call <4 x float> @llvm.vu.lq(i16 3)
  %v = call <4 x float> @llvm.vu.lq(i16 4)
  %bx = shufflevector <4 x float> %v, <4 x float> poison, <4 x i32> zeroinitializer
  %by = shufflevector <4 x float> %v, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %bz = shufflevector <4 x float> %v, <4 x float> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %t0 = fmul <4 x float> %m0, %bx
  %t1 = fmul <4 x float> %by, %m1
  %t2 = fmul <4 x float> %m2, %bz
  %s0 = fadd <4 x float> %t0, %t1
  %s1 = fadd <4 x float> %s0, %t2
  %r = fadd <4 x float> %s1, %m3
  call void @llvm.vu.sq(<4 x float> %r, i16 5)
  ret void
}


; Sums of products are computed through ACC (MULA, MADDA/MSUBA, MADD/MSUB),
; with broadcasts from any field, and plain terms as c * vf0.w.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

define void @mat4_vec() {
; CHECK-LABEL: mat4_vec:

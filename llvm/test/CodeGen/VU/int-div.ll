; CHECK-NEXT:    nop iaddiu vi2, vi0, 1020
; CHECK-NEXT:    nop loi 0x3e800000
; CHECK-NEXT:    addi.x vf2, vf0, i nop
; CHECK-NEXT:    nop iand vi1, vi1, vi2
; CHECK-NEXT:    nop mfir.x vf1, vi1
; CHECK-NEXT:    itof0.x vf1, vf1 nop
; CHECK-NEXT:    mulx.xyzw vf1, vf1, vf2x nop
; CHECK-NEXT:    ftoi0.x vf1, vf1 nop
; CHECK-NEXT:    nop mtir vi1, vf1x
; CHECK-NEXT:    nop isw.x vi1, 1(vi0)

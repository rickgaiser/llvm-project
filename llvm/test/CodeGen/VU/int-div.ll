; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; 16-bit shifts right and divisions by constants: there is no shifter and no
; divider, so they are a multiplication in VF truncated by FTOI0.

declare i16 @llvm.vu.ilw(i16, i32)
declare void @llvm.vu.isw(i16, i16, i32)

; x * 2^-2, + 2^13 to round down, - 2^13.
define void @ashr() {
; CHECK-LABEL: ashr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop ilw.x vi1, 0(vi0)
; CHECK-NEXT:    nop loi 0x3e800000
; CHECK-NEXT:    addi.x vf2, vf0, i loi 0x46000000
; CHECK-NEXT:    addi.x vf3, vf0, i nop
; CHECK-NEXT:    nop mfir.x vf1, vi1
; CHECK-NEXT:    itof0.x vf1, vf1 nop
; CHECK-NEXT:    mulx.xyzw vf1, vf1, vf2x nop
; CHECK-NEXT:    addx.xyzw vf1, vf1, vf3x nop
; CHECK-NEXT:    ftoi0.x vf1, vf1 nop
; CHECK-NEXT:    nop mtir vi1, vf1x
; CHECK-NEXT:    nop isubiu vi1, vi1, 8192
; CHECK-NEXT:    nop isw.x vi1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %r = ashr i16 %a, 2
  call void @llvm.vu.isw(i16 %r, i16 1, i32 0)
  ret void
}


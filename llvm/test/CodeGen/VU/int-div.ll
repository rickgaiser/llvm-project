; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %a = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %r = lshr i16 %a, 4
  call void @llvm.vu.isw(i16 %r, i16 1, i32 0)
  ret void
}


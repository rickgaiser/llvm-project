# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-loop-scheduler -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Five upper instructions and two lower ones take five words. The field move
# ADDy.x d, vf0, s is MR32.x d, s in the lower pipe: four words.

# With a flag test in the loop the move stays an ADD, which writes the flags.
---
name: move_to_lower
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: move_to_lower
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf7, implicit-def $vi3, implicit $vf1, implicit killed $vi3 {
  ; CHECK-NEXT:     dead $vf7 = MUL 15, $vf1, $vf1
  ; CHECK-NEXT:     $vi3 = IADDI killed $vi3, 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf8, implicit-def $vf5, implicit $vf2, implicit $vf6, implicit killed $vf5 {
  ; CHECK-NEXT:     dead $vf8 = MUL 15, $vf2, $vf2
  ; CHECK-NEXT:     $vf5 = MR32 8, $vf6, implicit killed $vf5
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf9, implicit $vf3, implicit $vi3, implicit $vi6 {
  ; CHECK-NEXT:     dead $vf9 = MUL 15, $vf3, $vf3
  ; CHECK-NEXT:     IBNE $vi3, $vi6, %bb.1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf10, implicit $vf4 {
  ; CHECK-NEXT:     dead $vf10 = MUL 15, $vf4, $vf4
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6

    $vf7 = MUL 15, $vf1, $vf1
    $vf8 = MUL 15, $vf2, $vf2
    $vf9 = MUL 15, $vf3, $vf3
    $vf10 = MUL 15, $vf4, $vf4
    $vf5 = ADDy 8, $vf0, $vf6, implicit $vf5
    $vi3 = IADDI $vi3, 1
    NOP
    IBNE $vi3, $vi6, %bb.1
    DSNOP

  bb.2:
    PROGRAM_END
...
---
name: flags
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: flags
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf7, implicit-def $vi3, implicit $vf1, implicit killed $vi3 {
  ; CHECK-NEXT:     dead $vf7 = MUL 15, $vf1, $vf1
  ; CHECK-NEXT:     $vi3 = IADDI killed $vi3, 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf8, implicit-def dead $vi7, implicit $vf2 {
  ; CHECK-NEXT:     dead $vf8 = MUL 15, $vf2, $vf2
  ; CHECK-NEXT:     dead $vi7 = FSAND 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   dead $vf9 = MUL 15, $vf3, $vf3
  ; CHECK-NEXT:   BUNDLE implicit-def dead $vf10, implicit $vf4, implicit $vi3, implicit $vi6 {
  ; CHECK-NEXT:     dead $vf10 = MUL 15, $vf4, $vf4
  ; CHECK-NEXT:     IBNE $vi3, $vi6, %bb.1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $vf5, implicit $vf0, implicit $vf6, implicit killed $vf5 {
  ; CHECK-NEXT:     $vf5 = ADDy 8, $vf0, $vf6, implicit killed $vf5
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf2, $vf3, $vf4, $vf5, $vf6, $vi3, $vi6

    $vf7 = MUL 15, $vf1, $vf1
    $vf8 = MUL 15, $vf2, $vf2
    $vf9 = MUL 15, $vf3, $vf3
    $vf10 = MUL 15, $vf4, $vf4
    $vf5 = ADDy 8, $vf0, $vf6, implicit $vf5
    $vi3 = IADDI $vi3, 1
    $vi7 = FSAND 1
    IBNE $vi3, $vi6, %bb.1
    DSNOP

  bb.2:
    PROGRAM_END
...

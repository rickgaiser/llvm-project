# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -mcpu=vu1 -run-pass=vu-invariant-fields -verify-machineinstrs -o - %s | FileCheck %s

# A merge of fields of a vector loaded in the loop loads them again into the
# register (LQ.w with the tied implicit use), so the loaded vector is not
# kept to the end of the iteration (the strip restart flag in mscei).

---
name:            flag
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: flag
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[IADDIU:%[0-9]+]]:vi = IADDIU $vi0, 0
  ; CHECK-NEXT:   [[ILW:%[0-9]+]]:vi = ILW 8, 0, $vi0 :: (load (s128))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vi = PHI [[IADDIU]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[LQ:%[0-9]+]]:vf = LQ 15, 8, [[PHI]] :: (load (s128))
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:vf = MUL 15, [[LQ]], [[LQ]]
  ; CHECK-NEXT:   SQ 15, [[MUL]], 100, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[LQ1:%[0-9]+]]:vf = LQ 1, 8, [[PHI]], implicit [[MUL]](tied-def 0) :: (load (s128))
  ; CHECK-NEXT:   SQ 15, [[LQ1]], 200, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[IADDI:%[0-9]+]]:vi = IADDI [[PHI]], 1
  ; CHECK-NEXT:   IBNE [[ILW]], [[IADDI]], %bb.1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    %3:vi = IADDIU $vi0, 0
    %0:vi = ILW 8, 0, $vi0 :: (load (s128))

  bb.1:
    successors: %bb.1, %bb.2
    %1:vi = PHI %3, %bb.0, %2, %bb.1
    %4:vf = LQ 15, 8, %1 :: (load (s128))
    %5:vf = MUL 15, %4, %4
    SQ 15, %5, 100, %1 :: (store (s128))
    %6:vf = MERGE_FIELDS %5, %4, 1
    SQ 15, %6, 200, %1 :: (store (s128))
    %2:vi = IADDI %1, 1
    IBNE %0, %2, %bb.1
    B %bb.2

  bb.2:
    PROGRAM_END
...
---
# The merge reads nothing else of the load: one LQ.w instead of LQ and MOVE.w.
name:            only_reader
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: only_reader
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[IADDIU:%[0-9]+]]:vi = IADDIU $vi0, 0
  ; CHECK-NEXT:   [[ILW:%[0-9]+]]:vi = ILW 8, 0, $vi0 :: (load (s128))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vi = PHI [[IADDIU]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[LQ:%[0-9]+]]:vf = LQ 15, 9, [[PHI]] :: (load (s128))
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:vf = MUL 15, [[LQ]], [[LQ]]
  ; CHECK-NEXT:   [[LQ1:%[0-9]+]]:vf = LQ 1, 8, [[PHI]], implicit [[MUL]](tied-def 0) :: (load (s128))
  ; CHECK-NEXT:   SQ 15, [[LQ1]], 200, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[IADDI:%[0-9]+]]:vi = IADDI [[PHI]], 1
  ; CHECK-NEXT:   IBNE [[ILW]], [[IADDI]], %bb.1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    %3:vi = IADDIU $vi0, 0
    %0:vi = ILW 8, 0, $vi0 :: (load (s128))

  bb.1:
    successors: %bb.1, %bb.2
    %1:vi = PHI %3, %bb.0, %2, %bb.1
    %4:vf = LQ 15, 8, %1 :: (load (s128))
    %7:vf = LQ 15, 9, %1 :: (load (s128))
    %5:vf = MUL 15, %7, %7
    %6:vf = MERGE_FIELDS %5, %4, 1
    SQ 15, %6, 200, %1 :: (store (s128))
    %2:vi = IADDI %1, 1
    IBNE %0, %2, %bb.1
    B %bb.2

  bb.2:
    PROGRAM_END
...
---
# A store to the loaded quadword between the two: the MOVE stays.
name:            store_between
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: store_between
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[IADDIU:%[0-9]+]]:vi = IADDIU $vi0, 0
  ; CHECK-NEXT:   [[ILW:%[0-9]+]]:vi = ILW 8, 0, $vi0 :: (load (s128))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vi = PHI [[IADDIU]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[LQ:%[0-9]+]]:vf = LQ 15, 8, [[PHI]] :: (load (s128))
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:vf = MUL 15, [[LQ]], [[LQ]]
  ; CHECK-NEXT:   SQ 15, [[MUL]], 8, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[MERGE_FIELDS:%[0-9]+]]:vf = MERGE_FIELDS [[MUL]], [[LQ]], 1
  ; CHECK-NEXT:   SQ 15, [[MERGE_FIELDS]], 200, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[IADDI:%[0-9]+]]:vi = IADDI [[PHI]], 1
  ; CHECK-NEXT:   IBNE [[ILW]], [[IADDI]], %bb.1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    %3:vi = IADDIU $vi0, 0
    %0:vi = ILW 8, 0, $vi0 :: (load (s128))

  bb.1:
    successors: %bb.1, %bb.2
    %1:vi = PHI %3, %bb.0, %2, %bb.1
    %4:vf = LQ 15, 8, %1 :: (load (s128))
    %5:vf = MUL 15, %4, %4
    SQ 15, %5, 8, %1 :: (store (s128))
    %6:vf = MERGE_FIELDS %5, %4, 1
    SQ 15, %6, 200, %1 :: (store (s128))
    %2:vi = IADDI %1, 1
    IBNE %0, %2, %bb.1
    B %bb.2

  bb.2:
    PROGRAM_END
...

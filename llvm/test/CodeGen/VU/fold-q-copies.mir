# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-fold-q-copies -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# A value of Q kept in vf1 is copied back with DIV q, vf1.x, vf0.w. Its readers
# read vf1.x instead, and the divider is free.
---
name: fold
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: fold
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf3 = MULx 15, $vf2, $vf1
    ; CHECK-NEXT: $vf1 = ADDx 8, $vf0, $vf1
    ; CHECK-NEXT: SQ 15, $vf3, 0, $vi0
    ; CHECK-NEXT: SQ 15, $vf1, 1, $vi0
    ; CHECK-NEXT: PROGRAM_END
    $q = DIV $vf1, 0, $vf0, 3
    $vf3 = MULq 15, $vf2, $q
    $vf1 = ADDq 8, $vf0, $q
    SQ 15, $vf3, 0, $vi0
    SQ 15, $vf1, 1, $vi0
    PROGRAM_END
...

# vf1 changes before the second read.
---
name: changed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: changed
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = DIV $vf1, 0, $vf0, 3
    ; CHECK-NEXT: $vf1 = ADD 15, $vf2, $vf2
    ; CHECK-NEXT: $vf3 = MULq 15, $vf2, $q
    ; CHECK-NEXT: SQ 15, $vf3, 0, $vi0
    ; CHECK-NEXT: SQ 15, $vf1, 1, $vi0
    ; CHECK-NEXT: PROGRAM_END
    $q = DIV $vf1, 0, $vf0, 3
    $vf1 = ADD 15, $vf2, $vf2
    $vf3 = MULq 15, $vf2, $q
    SQ 15, $vf3, 0, $vi0
    SQ 15, $vf1, 1, $vi0
    PROGRAM_END
...

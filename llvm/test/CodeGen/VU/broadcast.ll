; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Operations on broadcast fields keep the result in one field, which later
; instructions read by their broadcast field, instead of splatting each
; value with two instructions.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare <4 x float> @llvm.maxnum.v4f32(<4 x float>, <4 x float>)

; d = max(a.x * b.x + a.y * b.y + a.z * b.z, 0); c * d
define void @dot_max() {
; CHECK-LABEL: dot_max:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop lq.xyzw vf3, 2(vi0)
; CHECK-NEXT:    mul.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    addy.xyzw vf2, vf1, vf1y nop
; CHECK-NEXT:    addz.xyzw vf1, vf2, vf1z nop
; CHECK-NEXT:    sub.xyzw vf2, vf0, vf0 nop
; CHECK-NEXT:    max.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    mulx.xyzw vf1, vf3, vf1x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 3(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %c = call <4 x float> @llvm.vu.lq(i16 2)
  %m = fmul fast <4 x float> %a, %b
  %mx = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> zeroinitializer
  %my = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %mz = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 2, i32 2, i32 2, i32 2>
  %s = fadd fast <4 x float> %mx, %my
  %t = fadd fast <4 x float> %s, %mz
  %d = call fast <4 x float> @llvm.maxnum.v4f32(<4 x float> %t, <4 x float> zeroinitializer)
  %r = fmul fast <4 x float> %c, %d
  call void @llvm.vu.sq(<4 x float> %r, i16 3)
  ret void
}

; amb + col * max(dot, 0): the maximum is a broadcast term of the sum.
define void @dot_light() {
; CHECK-LABEL: dot_light:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop lq.xyzw vf3, 3(vi0)
; CHECK-NEXT:    nop lq.xyzw vf4, 2(vi0)
; CHECK-NEXT:    mul.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    sub.xyzw vf2, vf0, vf0 nop
; CHECK-NEXT:    mulaw.xyzw acc, vf3, vf0w nop
; CHECK-NEXT:    addy.xyzw vf1, vf1, vf1y nop
; CHECK-NEXT:    max.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    maddx.xyzw vf1, vf4, vf1x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %col = call <4 x float> @llvm.vu.lq(i16 2)
  %amb = call <4 x float> @llvm.vu.lq(i16 3)
  %m = fmul fast <4 x float> %a, %b
  %mx = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> zeroinitializer
  %my = shufflevector <4 x float> %m, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %s = fadd fast <4 x float> %mx, %my
  %d = call fast <4 x float> @llvm.maxnum.v4f32(<4 x float> %s, <4 x float> zeroinitializer)
  %l = fmul fast <4 x float> %col, %d
  %r = fadd fast <4 x float> %amb, %l
  call void @llvm.vu.sq(<4 x float> %r, i16 4)
  ret void
}

; (s * q, t * q, q): Q goes straight into the z field.
define void @insert_q() {
; CHECK-LABEL: insert_q:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop div q, vf0w, vf1w
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    mulq.xyzw vf1, vf1, q waitq
; CHECK-NEXT:    addq.z vf1, vf0, q nop
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %p = call <4 x float> @llvm.vu.lq(i16 1)
  %w = extractelement <4 x float> %p, i32 3
  %q = fdiv fast float 1.0, %w
  %qs = insertelement <4 x float> poison, float %q, i32 0
  %qv = shufflevector <4 x float> %qs, <4 x float> poison, <4 x i32> zeroinitializer
  %vq = fmul fast <4 x float> %v, %qv
  %r = insertelement <4 x float> %vq, float %q, i32 2
  call void @llvm.vu.sq(<4 x float> %r, i16 2)
  ret void
}

; v with w = p.w * k.x + k.y: the field of the broadcast sum is inserted
; from where it is.
define void @insert_field_of_broadcast() {
; CHECK-LABEL: insert_field_of_broadcast:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    addy.xyz vf3, vf0, vf1y nop
; CHECK-NEXT:    mulaw.xyzw acc, vf1, vf2w lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop mr32.w vf3, vf3
; CHECK-NEXT:    maddw.xyzw vf2, vf3, vf0w nop
; CHECK-NEXT:    nop mr32.w vf1, vf2
; CHECK-NEXT:    nop sq.xyzw vf1, 3(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %p = call <4 x float> @llvm.vu.lq(i16 1)
  %k = call <4 x float> @llvm.vu.lq(i16 2)
  %pw = shufflevector <4 x float> %p, <4 x float> poison, <4 x i32> <i32 3, i32 3, i32 3, i32 3>
  %kx = shufflevector <4 x float> %k, <4 x float> poison, <4 x i32> zeroinitializer
  %ky = shufflevector <4 x float> %k, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %m = fmul fast <4 x float> %pw, %kx
  %f = fadd fast <4 x float> %m, %ky
  %fx = extractelement <4 x float> %f, i32 0
  %r = insertelement <4 x float> %v, float %fx, i32 3
  call void @llvm.vu.sq(<4 x float> %r, i16 3)
  ret void
}

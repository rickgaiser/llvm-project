# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-packetizer,vu-delay-slot-filler \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Pairing rules for the upper and lower halves of a micro instruction word.

---
name: independent
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3
    ; CHECK-LABEL: name: independent
    ; CHECK: liveins: $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $vf1, implicit-def $vf4, implicit $vf2, implicit $vf3, implicit $vi0 {
    ; CHECK-NEXT:   $vf1 = ADD 15, $vf2, $vf3
    ; CHECK-NEXT:   $vf4 = LQ 15, 0, $vi0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = ADD 15, $vf2, $vf3
    $vf4 = LQ 15, 0, $vi0
    PROGRAM_END
...
---
# Both halves read their operands before either writes a result.
name: true_dep
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3
    ; CHECK-LABEL: name: true_dep
    ; CHECK: liveins: $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf1 = ADD 15, $vf2, $vf3
    ; CHECK-NEXT: SQ 15, $vf1, 0, $vi0
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = ADD 15, $vf2, $vf3
    SQ 15, $vf1, 0, $vi0
    PROGRAM_END
...
---
name: anti_dep
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3
    ; CHECK-LABEL: name: anti_dep
    ; CHECK: liveins: $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $vf1, implicit-def $vf2, implicit $vf2, implicit $vf3, implicit $vi0 {
    ; CHECK-NEXT:   $vf1 = ADD 15, $vf2, $vf3
    ; CHECK-NEXT:   $vf2 = LQ 15, 0, $vi0
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = ADD 15, $vf2, $vf3
    $vf2 = LQ 15, 0, $vi0
    PROGRAM_END
...
---
# The result of the lower instruction would be discarded.
name: output_dep
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3, $vf4
    ; CHECK-LABEL: name: output_dep
    ; CHECK: liveins: $vf2, $vf3, $vf4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf1 = ADD 8, $vf2, $vf3
    ; CHECK-NEXT: $vf1 = MOVE 1, $vf4
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = ADD 8, $vf2, $vf3
    $vf1 = MOVE 1, $vf4
    PROGRAM_END
...
---
name: two_upper
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3, $vf5, $vf6
    ; CHECK-LABEL: name: two_upper
    ; CHECK: liveins: $vf2, $vf3, $vf5, $vf6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf1 = ADD 15, $vf2, $vf3
    ; CHECK-NEXT: $vf4 = ADD 15, $vf5, $vf6
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = ADD 15, $vf2, $vf3
    $vf4 = ADD 15, $vf5, $vf6
    PROGRAM_END
...
---
# The upper half of a LOI word reads the previous I.
name: loi
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: loi
    ; CHECK: LOI 1065353216, implicit-def $i
    ; CHECK-NEXT: BUNDLE implicit-def $vf1, implicit-def $i, implicit $vf0, implicit $i {
    ; CHECK-NEXT:   $vf1 = ADDi 8, $vf0, implicit $i
    ; CHECK-NEXT:   LOI 1073741824, implicit-def $i
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    LOI 1065353216, implicit-def $i
    $vf1 = ADDi 8, $vf0, implicit $i
    LOI 1073741824, implicit-def $i
    PROGRAM_END
...
---
# A word stalls as a whole: the second ADD waits for vf1, so it is not added
# to the word of the second LQ.
name: stall
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf2, $vf3
    ; CHECK-LABEL: name: stall
    ; CHECK: liveins: $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $vf1, implicit-def $vf4, implicit $vi0, implicit $vf2, implicit $vf3 {
    ; CHECK-NEXT:   $vf1 = LQ 15, 0, $vi0
    ; CHECK-NEXT:   $vf4 = ADD 15, $vf2, $vf3
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $vf6 = LQ 15, 1, $vi0
    ; CHECK-NEXT: $vf5 = ADD 15, $vf1, $vf3
    ; CHECK-NEXT: PROGRAM_END
    $vf1 = LQ 15, 0, $vi0
    $vf4 = ADD 15, $vf2, $vf3
    $vf6 = LQ 15, 1, $vi0
    $vf5 = ADD 15, $vf1, $vf3
    PROGRAM_END
...
---
# The delay slot filler keeps a word between a branch and the word that sets
# its VI register.
name: branch_condition
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch_condition
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.0(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vi1, $vf1, $vf2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   IBNE $vi1, $vi0, %bb.0
  ; CHECK-NEXT:   DSNOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $vi1, $vf1, $vf2
    $vi1 = IADDI $vi1, -1
    IBNE $vi1, $vi0, %bb.0
  bb.1:
    PROGRAM_END
...
---
# The upper half of a WAITQ word reads the new Q.
name: waitq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: waitq
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: DIV $vf1, 0, $vf2, 0, implicit-def $q
    ; CHECK-NEXT: BUNDLE implicit-def $q, implicit-def $vf3, implicit $q, implicit $vf0 {
    ; CHECK-NEXT:   WAITQ implicit-def $q, implicit $q
    ; CHECK-NEXT:   $vf3 = ADDq 8, $vf0, implicit internal $q
    ; CHECK-NEXT: }
    ; CHECK-NEXT: PROGRAM_END
    DIV $vf1, 0, $vf2, 0, implicit-def $q
    WAITQ implicit-def $q, implicit $q
    $vf3 = ADDq 8, $vf0, implicit $q
    PROGRAM_END
...
---
# A branch shares its word with an upper instruction, two words after the word
# that sets its VI register.
name: branch
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.0(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $vi1, $vf1, $vf2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $vi1, implicit-def $vf1, implicit $vi1, implicit $vf1, implicit $vf2 {
  ; CHECK-NEXT:     $vi1 = IADDI $vi1, -1
  ; CHECK-NEXT:     $vf1 = ADD 15, $vf1, $vf2
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $vf3 = ADD 15, $vf2, $vf2
  ; CHECK-NEXT:   BUNDLE implicit-def $vf4, implicit $vf2, implicit $vi1, implicit $vi0 {
  ; CHECK-NEXT:     $vf4 = ADD 15, $vf2, $vf2
  ; CHECK-NEXT:     IBNE $vi1, $vi0, %bb.0
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   DSNOP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $vi1, $vf1, $vf2
    $vi1 = IADDI $vi1, -1
    $vf1 = ADD 15, $vf1, $vf2
    $vf3 = ADD 15, $vf2, $vf2
    $vf4 = ADD 15, $vf2, $vf2
    IBNE $vi1, $vi0, %bb.0
  bb.1:
    PROGRAM_END
...


; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; A cross product is OPMULA.xyz acc, a, b and OPMSUB.xyz d, b, a, written
; with shuffles of vectors (field w of the result is replaced or undefined)
; or field by field (HLSL cross). Field w of the result is undefined.

define void @cross_shuffles() {
; CHECK-LABEL: cross_shuffles:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    opmula.xyz acc, vf1, vf2 nop
; CHECK-NEXT:    opmsub.xyz vf1, vf2, vf1 nop
; CHECK-NEXT:    sub.xyzw vf2, vf0, vf0 nop
; CHECK-NEXT:    nop mr32.w vf1, vf2
; CHECK-NEXT:    nop sq.xyzw vf1, 3(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %a1 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 3>
  %b2 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 3>
  %a2 = shufflevector <4 x float> %a, <4 x float> poison, <4 x i32> <i32 2, i32 0, i32 1, i32 3>
  %b1 = shufflevector <4 x float> %b, <4 x float> poison, <4 x i32> <i32 1, i32 2, i32 0, i32 3>
  %m1 = fmul <4 x float> %a1, %b2
  %m2 = fmul <4 x float> %a2, %b1
  %c = fsub <4 x float> %m1, %m2
  %r = insertelement <4 x float> %c, float 0.0, i32 3
  call void @llvm.vu.sq(<4 x float> %r, i16 3)
  ret void
}

define void @cross_fields() {
; CHECK-LABEL: cross_fields:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    opmula.xyz acc, vf1, vf2 nop

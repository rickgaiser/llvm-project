; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %ax = extractelement <4 x float> %a, i32 0
  %ay = extractelement <4 x float> %a, i32 1
  %az = extractelement <4 x float> %a, i32 2
  %bx = extractelement <4 x float> %b, i32 0
  %by = extractelement <4 x float> %b, i32 1
  %bz = extractelement <4 x float> %b, i32 2
  %p0 = fmul float %ay, %bz
  %q0 = fmul float %az, %by
  %c0 = fsub float %p0, %q0
  %p1 = fmul float %bx, %az
  %q1 = fmul float %ax, %bz
  %c1 = fsub float %p1, %q1
  %p2 = fmul float %ax, %by
  %q2 = fmul float %by, %ax
  %q2b = fmul float %ay, %bx
  %c2 = fsub float %p2, %q2b
  %v0 = insertelement <4 x float> poison, float %c0, i32 0
  %v1 = insertelement <4 x float> %v0, float %c1, i32 1
  %v2 = insertelement <4 x float> %v1, float %c2, i32 2
  call void @llvm.vu.sq(<4 x float> %v2, i16 3)
  ret void
}


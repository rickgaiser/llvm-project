  call void @llvm.vu.sq(<4 x float> %r, i16 4)
  ret void
}

; A branch on a comparison: FTOI0 and MTIR of the mask, or of 1 - mask for
; the other way.
define void @branch() {
; CHECK-LABEL: branch:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop loi 0x7f000000
; CHECK-NEXT:    addi.x vf2, vf0, i lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    mulx.xyzw vf2, vf1, vf2x nop
; CHECK-NEXT:    maxx.xyzw vf2, vf2, vf0x nop
; CHECK-NEXT:    miniw.xyzw vf2, vf2, vf0w nop
; CHECK-NEXT:    ftoi0.x vf2, vf2 nop
; CHECK-NEXT:    nop mtir vi1, vf2x
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibeq vi1, vi0, .LBB7_2
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB7_1: ; %t
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:  .LBB7_2: ; %e
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
entry:
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %ax = extractelement <4 x float> %a, i32 0
  %c = fcmp ogt float %ax, 0.0
  br i1 %c, label %t, label %e
t:
  call void @llvm.vu.sq(<4 x float> %a, i16 4)
  br label %e
e:
  ret void
}


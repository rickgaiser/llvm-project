; CHECK-NEXT:    mul.xyzw vf5, vf6, vf5 nop
; CHECK-NEXT:    miniw.xyzw vf4, vf4, vf0w nop
; CHECK-NEXT:    max.xyzw vf4, vf5, vf4 nop
; CHECK-NEXT:    sub.xyzw vf3, vf3, vf4 nop
; CHECK-NEXT:    mula.xyzw acc, vf2, vf4 nop
; CHECK-NEXT:    madd.xyzw vf1, vf1, vf3 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %x = call <4 x float> @llvm.vu.lq(i16 2)
  %c1 = fcmp ogt <4 x float> %a, zeroinitializer
  %c2 = fcmp olt <4 x float> %a, <float 1.0, float 1.0, float 1.0, float 1.0>
  %c3 = fcmp oeq <4 x float> %a, %x
  %and = and <4 x i1> %c1, %c2

; CHECK-NEXT:    maxx.xyzw vf1, vf1, vf0x nop
; CHECK-NEXT:    miniw.xyzw vf1, vf1, vf0w nop
; CHECK-NEXT:    sub.xyzw vf2, vf2, vf1 nop
; CHECK-NEXT:    mula.xyzw acc, vf3, vf1 nop
; CHECK-NEXT:    madd.xyzw vf1, vf4, vf2 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %x = call <4 x float> @llvm.vu.lq(i16 2)
  %y = call <4 x float> @llvm.vu.lq(i16 3)
  %c = fcmp ogt <4 x float> %a, %b
  %r = select <4 x i1> %c, <4 x float> %x, <4 x float> %y
  call void @llvm.vu.sq(<4 x float> %r, i16 4)
  ret void
}


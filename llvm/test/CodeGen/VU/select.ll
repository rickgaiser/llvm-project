; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop loi 0x7f000000
; CHECK-NEXT:    addi.x vf3, vf0, i nop
; CHECK-NEXT:    sub.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    maxw.xyzw vf2, vf0, vf0w nop
; CHECK-NEXT:    mulx.xyzw vf1, vf1, vf3x nop
; CHECK-NEXT:    maxx.xyzw vf1, vf1, vf0x nop
; CHECK-NEXT:    miniw.xyzw vf1, vf1, vf0w nop
; CHECK-NEXT:    sub.xyzw vf1, vf2, vf1 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)

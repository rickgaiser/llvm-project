; CHECK-NEXT:    [[TMP12:%.*]] = shl i16 [[TMP11]], 4
; CHECK-NEXT:    [[TMP13:%.*]] = inttoptr i16 [[TMP12]] to ptr addrspace(3)
; CHECK-NEXT:    [[TMP14:%.*]] = add i16 [[PO]], 1
; CHECK-NEXT:    [[TMP15:%.*]] = shl i16 [[TMP14]], 4
; CHECK-NEXT:    [[TMP16:%.*]] = inttoptr i16 [[TMP15]] to ptr addrspace(3)
; CHECK-NEXT:    [[P:%.*]] = load <3 x float>, ptr addrspace(2) [[TMP7]], align 16, !alias.scope [[META0]], !noalias [[META3]]
; CHECK-NEXT:    [[X:%.*]] = extractelement <3 x float> [[P]], i32 0
; CHECK-NEXT:    [[XS:%.*]] = fmul float [[X]], [[S]]
; CHECK-NEXT:    [[BX:%.*]] = insertelement <4 x float> poison, float [[XS]], i32 0
; CHECK-NEXT:    [[B:%.*]] = shufflevector <4 x float> [[BX]], <4 x float> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[T:%.*]] = fmul <4 x float> [[M0]], [[B]]
; CHECK-NEXT:    [[V]] = fadd <4 x float> [[T]], [[M3]]
; CHECK-NEXT:    [[W:%.*]] = fadd <4 x float> [[V]], [[PREV_0]]
; CHECK-NEXT:    [[I:%.*]] = fptosi <4 x float> [[W]] to <4 x i32>
; CHECK-NEXT:    store <4 x i32> [[I]], ptr addrspace(3) [[TMP16]], align 16, !alias.scope [[META3]], !noalias [[META0]]
; CHECK-NEXT:    [[C:%.*]] = load <4 x i32>, ptr addrspace(2) [[TMP10]], align 16, !alias.scope [[META0]], !noalias [[META3]]
; CHECK-NEXT:    store <4 x i32> [[C]], ptr addrspace(3) [[TMP13]], align 16, !alias.scope [[META3]], !noalias [[META0]]
; CHECK-NEXT:    [[I_NEXT]] = add i16 [[I1]], 1
; CHECK-NEXT:    [[TMP17]] = add i16 [[PI]], 2
; CHECK-NEXT:    [[TMP18]] = add i16 [[PO]], 2
; CHECK-NEXT:    [[LAST:%.*]] = icmp eq i16 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[LAST]], label %[[VU_DONE]], label %[[VU_ITEM]]
; CHECK:       [[VU_DONE]]:
; CHECK-NEXT:    call void @llvm.vu.xgkick(i16 [[OUT]])
; CHECK-NEXT:    ret void
;
  %p = load <3 x float>, ptr addrspace(2) @pos
  %x = extractelement <3 x float> %p, i32 0
  %m0 = load <4 x float>, ptr addrspace(1) @mvp
  %m3p = getelementptr [4 x <4 x float>], ptr addrspace(1) @mvp, i16 0, i16 3
  %m3 = load <4 x float>, ptr addrspace(1) %m3p
  %s = load float, ptr addrspace(1) @scale
  %xs = fmul float %x, %s
  %bx = insertelement <4 x float> poison, float %xs, i32 0
  %b = shufflevector <4 x float> %bx, <4 x float> poison, <4 x i32> zeroinitializer
  %t = fmul <4 x float> %m0, %b
  %v = fadd <4 x float> %t, %m3
  ; the vertex before this one
  %q = load <4 x float>, ptr addrspace(5) @prev
  %w = fadd <4 x float> %v, %q
  store <4 x float> %v, ptr addrspace(5) @prev
  %i = fptosi <4 x float> %w to <4 x i32>
  store <4 x i32> %i, ptr addrspace(3) @xyz2
  %c = load <4 x i32>, ptr addrspace(2) @col
  store <4 x i32> %c, ptr addrspace(3) @rgbaq

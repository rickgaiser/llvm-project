; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; A program is a whole number of quadwords (VIF's MPG sends quadwords): an
; odd number of words gets one more, or the last word, the delay slot of the
; end, would be what another program left there.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

; Four words.
define void @even() {
; CHECK-LABEL: even:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop sq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  call void @llvm.vu.sq(<4 x float> %v, i16 1)
  ret void
}

; Five words and a padding word.
define void @odd() {
; CHECK-LABEL: odd:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    add.xyzw vf1, vf1, vf1 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %w = fadd <4 x float> %v, %v
  call void @llvm.vu.sq(<4 x float> %w, i16 1)
  ret void
}

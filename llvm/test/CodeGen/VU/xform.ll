  %r1 = call <4 x float> @llvm.vu.lq(i16 1)
  %r2 = call <4 x float> @llvm.vu.lq(i16 2)
  %r3 = call <4 x float> @llvm.vu.lq(i16 3)
  %top = call i16 @llvm.vu.xtop()
  %n = call i16 @llvm.vu.ilw(i16 %top, i32 0)
  %in0 = add i16 %top, 2
  %out0 = add i16 %top, 200

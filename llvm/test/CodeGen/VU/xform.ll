  %v = call <4 x float> @llvm.vu.lq(i16 %pin)
  %x = extractelement <4 x float> %v, i32 0
  %y = extractelement <4 x float> %v, i32 1
  %z = extractelement <4 x float> %v, i32 2
  %sx = insertelement <4 x float> poison, float %x, i32 0
  %bx = shufflevector <4 x float> %sx, <4 x float> poison, <4 x i32> zeroinitializer
  %sy = insertelement <4 x float> poison, float %y, i32 0
  %by = shufflevector <4 x float> %sy, <4 x float> poison, <4 x i32> zeroinitializer
  %sz = insertelement <4 x float> poison, float %z, i32 0
  %bz = shufflevector <4 x float> %sz, <4 x float> poison, <4 x i32> zeroinitializer
  %t0 = fmul <4 x float> %r0, %bx
  %t1 = fmul <4 x float> %r1, %by
  %t2 = fmul <4 x float> %r2, %bz
  %s0 = fadd <4 x float> %t0, %t1
  %s1 = fadd <4 x float> %s0, %t2

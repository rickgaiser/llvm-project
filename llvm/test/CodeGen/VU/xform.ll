  %top = call i16 @llvm.vu.xtop()
  %n = call i16 @llvm.vu.ilw(i16 %top, i32 0)
  %in0 = add i16 %top, 2
  %out0 = add i16 %top, 200
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %pin = add i16 %in0, %i
  %pout = add i16 %out0, %i
  %v = call <4 x float> @llvm.vu.lq(i16 %pin)
  %x = extractelement <4 x float> %v, i32 0
  %y = extractelement <4 x float> %v, i32 1
  %z = extractelement <4 x float> %v, i32 2
  %sx = insertelement <4 x float> poison, float %x, i32 0
  %bx = shufflevector <4 x float> %sx, <4 x float> poison, <4 x i32> zeroinitializer
  %sy = insertelement <4 x float> poison, float %y, i32 0
  %by = shufflevector <4 x float> %sy, <4 x float> poison, <4 x i32> zeroinitializer
  %sz = insertelement <4 x float> poison, float %z, i32 0
  %bz = shufflevector <4 x float> %sz, <4 x float> poison, <4 x i32> zeroinitializer
  %t0 = fmul <4 x float> %r0, %bx
  %t1 = fmul <4 x float> %r1, %by
  %t2 = fmul <4 x float> %r2, %bz
  %s0 = fadd <4 x float> %t0, %t1
  %s1 = fadd <4 x float> %s0, %t2
  %clip = fadd <4 x float> %s1, %r3
  %w = extractelement <4 x float> %clip, i32 3
  %q = fdiv float 1.0, %w
  %sq = insertelement <4 x float> poison, float %q, i32 0
  %bq = shufflevector <4 x float> %sq, <4 x float> poison, <4 x i32> zeroinitializer
  %ndc = fmul <4 x float> %clip, %bq
  %scr = fmul <4 x float> %ndc, <float 320.0, float 224.0, float 1.0, float 1.0>
  %off = fadd <4 x float> %scr, <float 2048.0, float 2048.0, float 0.0, float 0.0>
  %fix = fptosi <4 x float> %off to <4 x i32>
  %fixf = bitcast <4 x i32> %fix to <4 x float>
  call void @llvm.vu.sq(<4 x float> %fixf, i16 %pout)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:

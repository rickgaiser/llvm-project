# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-loop-scheduler -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# Each ADD waits 3 words for its MUL: 8 words and 6 stall cycles. Interleaved,
# with the second ADD in the delay slot, the loop takes 6 words that do not
# stall.

# In rename, both products are in vf2, so the second MUL waits for the reads
# of the first product. Renamed to free registers, the products overlap and
# the loop takes 6 words again. The SQ in the word of the second MUL stores
# the first product, as both halves of a word read before they write. It
# moves behind the increment of its base, with the offset one lower.

---
name: interleave
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: interleave
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $vf2, implicit-def $vi3, implicit $vf1, implicit $vi3 {
  ; CHECK-NEXT:     $vf2 = MUL 15, $vf1, $vf1
  ; CHECK-NEXT:     $vi3 = IADDI $vi3, 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $vf5 = MUL 15, $vf6, $vf6
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $vf4, implicit $vf2, implicit $vi3, implicit $vi6 {
  ; CHECK-NEXT:     $vf4 = ADD 15, $vf2, $vf2
  ; CHECK-NEXT:     IBNE $vi3, $vi6, %bb.1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $vf7, implicit $vf5 {
  ; CHECK-NEXT:     $vf7 = ADD 15, $vf5, $vf5
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf6, $vi3, $vi6

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf6, $vi3, $vi6

    $vf2 = MUL 15, $vf1, $vf1
    $vf4 = ADD 15, $vf2, $vf2
    $vf5 = MUL 15, $vf6, $vf6
    $vf7 = ADD 15, $vf5, $vf5
    $vi3 = IADDI $vi3, 1
    NOP
    IBNE $vi3, $vi6, %bb.1
    DSNOP

  bb.2:
    PROGRAM_END
...
---
name: rename
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: rename
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vf1, $vf6, $vi3, $vi6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BUNDLE implicit-def $vf31, implicit-def $vi3, implicit $vf1, implicit $vi3 {
  ; CHECK-NEXT:     $vf31 = MUL 15, $vf1, $vf1
  ; CHECK-NEXT:     $vi3 = IADDI $vi3, 1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   $vf30 = MUL 15, $vf6, $vf6
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   NOP
  ; CHECK-NEXT:   BUNDLE implicit-def $vf4, implicit $vf31, implicit $vi3, implicit $vi6 {
  ; CHECK-NEXT:     $vf4 = ADD 15, $vf31, $vf31
  ; CHECK-NEXT:     IBNE $vi3, $vi6, %bb.1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT:   BUNDLE implicit-def $vf7, implicit $vf30, implicit $vf31, implicit $vi3 {
  ; CHECK-NEXT:     $vf7 = ADD 15, $vf30, $vf30
  ; CHECK-NEXT:     SQ 15, $vf31, -1, $vi3
  ; CHECK-NEXT:     DELAY_SLOT
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0:
    successors: %bb.1
    liveins: $vf1, $vf6, $vi3, $vi6

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $vf1, $vf6, $vi3, $vi6

    $vf2 = MUL 15, $vf1, $vf1
    $vf4 = ADD 15, $vf2, $vf2
    BUNDLE implicit-def $vf2, implicit $vf6, implicit $vf2, implicit $vi3 {
      $vf2 = MUL 15, $vf6, $vf6
      SQ 15, $vf2, 0, $vi3
    }
    $vf7 = ADD 15, $vf2, $vf2
    $vi3 = IADDI $vi3, 1
    NOP
    IBNE $vi3, $vi6, %bb.1
    DSNOP

  bb.2:
    PROGRAM_END
...

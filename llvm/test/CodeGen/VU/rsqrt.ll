; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; a / sqrt(b) with afn is one RSQRT (13 cycles of the divider instead of
; SQRT, WAITQ and DIV); without afn it is SQRT and DIV.

define void @rsqrt_afn() {
; CHECK-LABEL: rsqrt_afn:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop rsqrt q, vf1x, vf2x
; CHECK-NEXT:    addq.x vf1, vf0, q waitq
; CHECK-NEXT:    addx.xyz vf1, vf0, vf1x nop
; CHECK-NEXT:    nop mr32.w vf1, vf1
; CHECK-NEXT:    nop sq.xyzw vf1, 3(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %a.v = call <4 x float> @llvm.vu.lq(i16 0)
  %a = extractelement <4 x float> %a.v, i32 0
  %b.v = call <4 x float> @llvm.vu.lq(i16 1)
  %b = extractelement <4 x float> %b.v, i32 0
  %s = call afn float @llvm.sqrt.f32(float %b)
  %r = fdiv afn float %a, %s
  %r.v = insertelement <4 x float> poison, float %r, i32 0
  call void @llvm.vu.sq(<4 x float> %r.v, i16 3)
  ret void
}


; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Fields taken from the same fields of other vectors (float4(v.xyz, a.w)):
; the vector that gives the most fields is the start, the fields of the
; others are merged by MOVE<mask>, a lower instruction, exact for every value.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

; float4(a.xyz + b.xyz, b.w)
define void @merge_xyz_w() {
; CHECK-LABEL: merge_xyz_w:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    add.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    nop move.w vf1, vf2
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %s = fadd <4 x float> %a, %b
  %m = shufflevector <4 x float> %s, <4 x float> %b, <4 x i32> <i32 0, i32 1, i32 2, i32 7>
  call void @llvm.vu.sq(<4 x float> %m, i16 2)
  ret void
}

; float4(a.x, b.y, a.z, b.w): b is used again
define void @merge_xz_yw() {
; CHECK-LABEL: merge_xz_yw:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop move.yw vf1, vf2
; CHECK-NEXT:    nop sq.xyzw vf2, 3(vi0)
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %m = shufflevector <4 x float> %a, <4 x float> %b, <4 x i32> <i32 0, i32 5, i32 2, i32 7>
  call void @llvm.vu.sq(<4 x float> %m, i16 2)
  call void @llvm.vu.sq(<4 x float> %b, i16 3)
  ret void
}

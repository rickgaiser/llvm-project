# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-loop-copies -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# A loop pipelined into three stages: in[i] is loaded in stage 0, squared in
# stage 1 and stored to in[i + 200] in stage 2. The pointer of each stage is
# the incremented pointer minus a constant, so the loads and stores use it
# with other offsets, and the pointers after the loop are derived from it.
# The square for the next iteration is moved below the store of this one.

--- |
  target datalayout = "e-m:e-p:16:16-i32:32-i64:64-f32:32-v128:128-n16"
  target triple = "vu"

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(read)
  declare <4 x float> @llvm.vu.lq(i16) #0

  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(write)
  declare void @llvm.vu.sq(<4 x float>, i16) #1

  define void @pipelined() {
  entry:
    br label %loop

  loop:                                             ; preds = %loop, %entry
    %i = phi i16 [ 0, %entry ], [ %0, %loop ]
    %v = call <4 x float> @llvm.vu.lq(i16 %i)
    %s = fmul <4 x float> %v, %v
    %out = add i16 %i, 200
    call void @llvm.vu.sq(<4 x float> %s, i16 %out)
    %0 = add i16 %out, -199
    %done = icmp eq i16 %0, 100
    br i1 %done, label %exit, label %loop

  exit:                                             ; preds = %loop
    ret void
  }

  attributes #0 = { nocallback nofree nosync nounwind willreturn memory(read) }
  attributes #1 = { nocallback nofree nosync nounwind willreturn memory(write) }
...
---
name:            pipelined
alignment:       8
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
registers:
  - { id: 0, class: vi }
  - { id: 1, class: vi }
  - { id: 2, class: vi }
  - { id: 3, class: vf }
  - { id: 4, class: vf }
  - { id: 5, class: vi }
  - { id: 6, class: vf }
  - { id: 7, class: vi }
  - { id: 8, class: vf }
  - { id: 9, class: vf }
  - { id: 10, class: vi }
  - { id: 11, class: vi }
  - { id: 12, class: vf }
  - { id: 13, class: vf }
  - { id: 14, class: vi }
  - { id: 15, class: vi }
  - { id: 16, class: vi }
  - { id: 17, class: vf }
  - { id: 18, class: vf }
  - { id: 19, class: vi }
  - { id: 20, class: vi }
  - { id: 21, class: vi }
  - { id: 22, class: vf }
  - { id: 23, class: vf }
  - { id: 24, class: vf }
  - { id: 25, class: vi }
  - { id: 26, class: vi }
  - { id: 27, class: vf }
  - { id: 28, class: vi }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
machineFunctionInfo: {}
body:             |
  ; CHECK-LABEL: name: pipelined
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[IADDIU:%[0-9]+]]:vi = IADDIU $vi0, 0
  ; CHECK-NEXT:   [[IADDIU1:%[0-9]+]]:vi = IADDIU $vi0, 100
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LQ:%[0-9]+]]:vf = LQ 15, 0, [[IADDIU]] :: (load (s128))
  ; CHECK-NEXT:   [[IADDI:%[0-9]+]]:vi = IADDI [[IADDIU]], 1
  ; CHECK-NEXT:   IBEQ [[IADDI]], [[IADDIU1]], %bb.5
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.loop:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MUL:%[0-9]+]]:vf = MUL 15, [[LQ]], [[LQ]]
  ; CHECK-NEXT:   [[LQ1:%[0-9]+]]:vf = LQ 15, 0, [[IADDI]] :: (load (s128))
  ; CHECK-NEXT:   [[IADDI1:%[0-9]+]]:vi = IADDI [[IADDI]], 1
  ; CHECK-NEXT:   IBEQ [[IADDI1]], [[IADDIU1]], %bb.4
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.loop:
  ; CHECK-NEXT:   successors: %bb.4(0x04000000), %bb.3(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vi = PHI [[IADDI1]], %bb.2, %11, %bb.3
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:vf = PHI [[LQ1]], %bb.2, %13, %bb.3
  ; CHECK-NEXT:   [[PHI2:%[0-9]+]]:vf = PHI [[MUL]], %bb.2, %12, %bb.3
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vi = COPY [[PHI]]
  ; CHECK-NEXT:   [[IADDI2:%[0-9]+]]:vi = IADDI [[COPY]], 1
  ; CHECK-NEXT:   SQ 15, [[PHI2]], 197, [[IADDI2]] :: (store (s128))
  ; CHECK-NEXT:   [[MUL1:%[0-9]+]]:vf = MUL 15, [[PHI1]], [[PHI1]]
  ; CHECK-NEXT:   [[LQ2:%[0-9]+]]:vf = LQ 15, -1, [[IADDI2]] :: (load (s128))
  ; CHECK-NEXT:   IBNE [[IADDI2]], [[IADDIU1]], %bb.3
  ; CHECK-NEXT:   B %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI3:%[0-9]+]]:vi = PHI [[IADDI1]], %bb.2, [[IADDI2]], %bb.3
  ; CHECK-NEXT:   [[PHI4:%[0-9]+]]:vf = PHI [[LQ1]], %bb.2, [[LQ2]], %bb.3
  ; CHECK-NEXT:   [[PHI5:%[0-9]+]]:vf = PHI [[MUL]], %bb.2, [[MUL1]], %bb.3
  ; CHECK-NEXT:   [[IADDI3:%[0-9]+]]:vi = IADDI [[PHI3]], -1
  ; CHECK-NEXT:   SQ 15, [[PHI5]], 198, [[PHI3]] :: (store (s128))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.6(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI6:%[0-9]+]]:vi = PHI [[IADDIU]], %bb.1, [[IADDI3]], %bb.4
  ; CHECK-NEXT:   [[PHI7:%[0-9]+]]:vf = PHI [[LQ]], %bb.1, [[PHI4]], %bb.4
  ; CHECK-NEXT:   [[MUL2:%[0-9]+]]:vf = MUL 15, [[PHI7]], [[PHI7]]
  ; CHECK-NEXT:   SQ 15, [[MUL2]], 200, [[PHI6]] :: (store (s128))
  ; CHECK-NEXT:   B %bb.6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6.exit:
  ; CHECK-NEXT:   PROGRAM_END
  bb.0.entry:
    %2:vi = IADDIU $vi0, 0
    %5:vi = IADDIU $vi0, 100

  bb.3.loop:
    successors: %bb.4, %bb.7

    %6:vf = LQ 15, 0, %2 :: (load (s128))
    %7:vi = IADDI %2, 1
    IBEQ %7, %5, %bb.7
    B %bb.4

  bb.4.loop:
    successors: %bb.5, %bb.6

    %8:vf = MUL 15, %6, %6
    %9:vf = LQ 15, 0, %7 :: (load (s128))
    %10:vi = IADDI %7, 1
    IBEQ %10, %5, %bb.6
    B %bb.5

  bb.5.loop:
    successors: %bb.6(0x04000000), %bb.5(0x7c000000)

    %14:vi = PHI %10, %bb.4, %11, %bb.5
    %15:vi = PHI %7, %bb.4, %14, %bb.5
    %16:vi = PHI %2, %bb.4, %15, %bb.5
    %17:vf = PHI %9, %bb.4, %13, %bb.5
    %18:vf = PHI %8, %bb.4, %12, %bb.5
    %28:vi = COPY %14
    %11:vi = IADDI %28, 1
    %12:vf = MUL 15, %17, %17
    %13:vf = LQ 15, 0, %28 :: (load (s128))
    SQ 15, %18, 200, %16 :: (store (s128))
    IBNE %11, %5, %bb.5
    B %bb.6

  bb.6:
    %20:vi = PHI %7, %bb.4, %28, %bb.5
    %21:vi = PHI %2, %bb.4, %15, %bb.5
    %22:vf = PHI %9, %bb.4, %13, %bb.5
    %23:vf = PHI %8, %bb.4, %12, %bb.5
    SQ 15, %23, 200, %21 :: (store (s128))

  bb.7:
    %26:vi = PHI %2, %bb.3, %20, %bb.6
    %27:vf = PHI %6, %bb.3, %22, %bb.6
    %24:vf = MUL 15, %27, %27
    SQ 15, %24, 200, %26 :: (store (s128))
    B %bb.2

  bb.2.exit:
    PROGRAM_END
...

; Fields that the GIF does not read in PACKED mode are undefined in the
; stores of the outputs (w of ST), so nothing computes them. A float vector
; input with more fields than its 32-bit format: the VIF fills the others
; with 1.0 (the header's STMASK; COL is 1.0), and the program loads them:
; float3 st from V2-32 is (s, t, 1), and st * q is (s q, t q, q).

; HDR: #define VU_FIELDS_INPUTS {{[{][{]}}0x8, 0, 12, 0x0}, {0x4, 0, 8, 0x20202020}}

@pos = external addrspace(2) global <3 x float>, !vu.input !0
@st = external addrspace(2) global <3 x float>, !vu.input !1
@gst = external addrspace(3) global <4 x float>, !vu.output !2
@xyz2 = external addrspace(3) global <4 x i32>, !vu.output !3


;
  %p = load <3 x float>, ptr addrspace(2) @pos
  %p4 = shufflevector <3 x float> %p, <3 x float> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 poison>
  %q = extractelement <3 x float> %p, i32 2
  %t = load <3 x float>, ptr addrspace(2) @st
  %bq = insertelement <3 x float> poison, float %q, i32 0
  %sq = shufflevector <3 x float> %bq, <3 x float> poison, <3 x i32> zeroinitializer
  %tq = fmul <3 x float> %t, %sq
  ; float4(st * q, 0): w is not read
  %o = shufflevector <3 x float> %tq, <3 x float> poison, <4 x i32> <i32 0, i32 1, i32 2, i32 poison>
  %o0 = insertelement <4 x float> %o, float 0.0, i32 3

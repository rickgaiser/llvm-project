declare <4 x float> @llvm.minnum.v4f32(<4 x float>, <4 x float>)
declare <4 x float> @llvm.fma.v4f32(<4 x float>, <4 x float>, <4 x float>)
declare float @llvm.sqrt.f32(float)

define void @scalar_ops() {
; CHECK-LABEL: scalar_ops:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    addy.x vf2, vf0, vf1y nop
; CHECK-NEXT:    nop div q, vf1x, vf2x
; CHECK-NEXT:    nop waitq
; CHECK-NEXT:    addq.x vf2, vf0, q nop
; CHECK-NEXT:    nop sqrt q, vf2x
; CHECK-NEXT:    nop waitq
; CHECK-NEXT:    addq.x vf2, vf0, q nop
; CHECK-NEXT:    nop loi 0x3f000000
; CHECK-NEXT:    addi.x vf3, vf0, i nop
; CHECK-NEXT:    mul.xyzw vf2, vf2, vf3 nop
; CHECK-NEXT:    mulx.w vf1, vf0, vf2x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %x = extractelement <4 x float> %v, i32 0
  %y = extractelement <4 x float> %v, i32 1
  %d = fdiv float %x, %y
  %r = call float @llvm.sqrt.f32(float %d)
  %k = fmul float %r, 0.5
  %v2 = insertelement <4 x float> %v, float %k, i32 3
  call void @llvm.vu.sq(<4 x float> %v2, i16 1)
  ret void
}

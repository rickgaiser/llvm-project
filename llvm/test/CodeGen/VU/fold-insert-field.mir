# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -run-pass=vu-fold-insert-field -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s

# The insertion of field f of s into field f of d (ADD<f>.<f> d, vf0, s, or
# MULw.w d, s, vf0w for w) is folded into the upper instruction that writes s, which then
# writes field f of d.

---
# The clamp of a value goes straight into the w field of the vertex.
name: fold_w
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2, $vf3
    ; CHECK-LABEL: name: fold_w
    ; CHECK: liveins: $vf1, $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf3 = MINIx 1, $vf1, $vf2, implicit $vf3
    ; CHECK-NEXT: PROGRAM_END implicit $vf3
    $vf4 = MINIx 15, $vf1, $vf2
    $vf3 = MULw 1, killed $vf4, $vf0, implicit $vf3
    PROGRAM_END implicit $vf3
...
---
# Field z, and a multiply-add through ACC.
name: fold_z_madd
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2, $vf3, $acc
    ; CHECK-LABEL: name: fold_z_madd
    ; CHECK: liveins: $vf1, $vf2, $vf3, $acc
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf3 = MADD killed $acc, 2, $vf1, $vf2, implicit $vf3
    ; CHECK-NEXT: PROGRAM_END implicit $vf3
    $vf4 = MADD killed $acc, 15, $vf1, $vf2
    $vf3 = ADDz 2, $vf0, killed $vf4, implicit $vf3
    PROGRAM_END implicit $vf3
...
---
# s is read again after the insertion: no fold.
name: no_fold_s_used
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2, $vf3
    ; CHECK-LABEL: name: no_fold_s_used
    ; CHECK: liveins: $vf1, $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf4 = MINIx 15, $vf1, $vf2
    ; CHECK-NEXT: $vf3 = MULw 1, $vf4, $vf0, implicit $vf3
    ; CHECK-NEXT: $vf5 = ADD 15, $vf3, killed $vf4
    ; CHECK-NEXT: PROGRAM_END implicit $vf5
    $vf4 = MINIx 15, $vf1, $vf2
    $vf3 = MULw 1, $vf4, $vf0, implicit $vf3
    $vf5 = ADD 15, $vf3, killed $vf4
    PROGRAM_END implicit $vf5
...
---
# d is read between the two: no fold.
name: no_fold_d_read
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2, $vf3
    ; CHECK-LABEL: name: no_fold_d_read
    ; CHECK: liveins: $vf1, $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf4 = MINIx 15, $vf1, $vf2
    ; CHECK-NEXT: $vf5 = ADD 15, $vf3, $vf3
    ; CHECK-NEXT: $vf3 = MULw 1, killed $vf4, $vf0, implicit $vf3
    ; CHECK-NEXT: PROGRAM_END implicit $vf3, implicit $vf5
    $vf4 = MINIx 15, $vf1, $vf2
    $vf5 = ADD 15, $vf3, $vf3
    $vf3 = MULw 1, killed $vf4, $vf0, implicit $vf3
    PROGRAM_END implicit $vf3, implicit $vf5
...
---
# Another field of s is moved (ADDw.x takes w into x): no fold.
name: no_fold_other_field
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2, $vf3
    ; CHECK-LABEL: name: no_fold_other_field
    ; CHECK: liveins: $vf1, $vf2, $vf3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $vf4 = MINIx 15, $vf1, $vf2
    ; CHECK-NEXT: $vf3 = ADDw 8, $vf0, killed $vf4, implicit $vf3
    ; CHECK-NEXT: PROGRAM_END implicit $vf3
    $vf4 = MINIx 15, $vf1, $vf2
    $vf3 = ADDw 8, $vf0, killed $vf4, implicit $vf3
    PROGRAM_END implicit $vf3
...

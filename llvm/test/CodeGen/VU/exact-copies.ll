; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; The PS2's multiplier is 1 ULP low with 1.0 in fs (MULw.w d, vf0, s), so a
; field is never copied that way: into x, y and z by ADD<f>.<f> d, vf0, s,
; into w by MULw.w d, s, vf0w (1.0 in ft) from w and MR32.w d, s from x, and
; a field y or z is moved to x first. A constant ending an ACC chain is added
; by a broadcast ADD, not as ones * c.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

define void @splat_x() {
; CHECK-LABEL: splat_x:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    addx.xyzw vf1, vf2, vf1x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %x = extractelement <4 x float> %a, i32 0
  %i = insertelement <4 x float> poison, float %x, i32 0
  %s = shufflevector <4 x float> %i, <4 x float> poison, <4 x i32> zeroinitializer
  %m = fadd <4 x float> %s, %b
  call void @llvm.vu.sq(<4 x float> %m, i16 2)
  ret void
}


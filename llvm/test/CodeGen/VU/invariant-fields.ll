; RUN: llc -mtriple=vu -mcpu=vu1 -O3 -stop-after=vu-invariant-fields < %s | FileCheck %s

; float4(v.xyz + a.xyz, a.w) in a loop: the ADD writes x, y and z into a
; register that goes around the loop (a PHI, the tied implicit use), whose w
; is a.w from before the loop: no MOVE.w in the iterations.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare i16 @llvm.vu.ilw(i16, i32)

define void @alpha() {
  ; CHECK-LABEL: name: alpha
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ILW:%[0-9]+]]:vi = ILW 8, 0, $vi0 :: (load (s128))
  ; CHECK-NEXT:   [[IADDIU:%[0-9]+]]:vi = IADDIU $vi0, 0
  ; CHECK-NEXT:   [[LQ:%[0-9]+]]:vf = LQ 15, 1, $vi0 :: (load (s128))
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:vi = PHI [[IADDIU]], %bb.0, %3, %bb.1
  ; CHECK-NEXT:   [[PHI1:%[0-9]+]]:vf = PHI [[LQ]], %bb.0, %9, %bb.1
  ; CHECK-NEXT:   [[LQ1:%[0-9]+]]:vf = LQ 15, 8, [[PHI]] :: (load (s128))
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:vf = ADD 14, [[LQ1]], [[LQ]], implicit [[PHI1]](tied-def 0)
  ; CHECK-NEXT:   SQ 15, [[ADD]], 200, [[PHI]] :: (store (s128))
  ; CHECK-NEXT:   [[IADDI:%[0-9]+]]:vi = IADDI [[PHI]], 1
  ; CHECK-NEXT:   IBNE [[ILW]], [[IADDI]], %bb.1
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   PROGRAM_END
entry:
  %n = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %a = call <4 x float> @llvm.vu.lq(i16 1)
  br label %loop
loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %p = add i16 %i, 8
  %v = call <4 x float> @llvm.vu.lq(i16 %p)
  %s = fadd <4 x float> %v, %a
  %m = shufflevector <4 x float> %s, <4 x float> %a, <4 x i32> <i32 0, i32 1, i32 2, i32 7>
  %q = add i16 %i, 200
  call void @llvm.vu.sq(<4 x float> %m, i16 %q)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Division and square root read their operands from any field, use vf0.w for
; 1.0, and their result is read from Q directly. WAITQ is only inserted when Q
; is read less than 7 words after the DIV.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

; q = 1 / v.w; a * q
define void @perspective() {
; CHECK-LABEL: perspective:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop div q, vf0w, vf1w
; CHECK-NEXT:    nop lq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    mulq.xyzw vf1, vf1, q waitq
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %a = call <4 x float> @llvm.vu.lq(i16 1)
  %w = extractelement <4 x float> %v, i32 3
  %q = fdiv float 1.0, %w
  %s = insertelement <4 x float> poison, float %q, i32 0
  %bq = shufflevector <4 x float> %s, <4 x float> poison, <4 x i32> zeroinitializer
  %r = fmul <4 x float> %a, %bq
  call void @llvm.vu.sq(<4 x float> %r, i16 2)
  ret void
}

; Enough independent work hides the latency: no WAITQ.
define void @hidden_latency() {
; CHECK-LABEL: hidden_latency:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 0(vi0)
; CHECK-NEXT:    mul.xyzw vf1, vf1, vf1 nop
; CHECK-NEXT:    nop div q, vf0w, vf2w
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    mul.xyzw vf1, vf1, vf1 nop
; CHECK-NEXT:    mulq.xyzw vf2, vf2, q waitq
; CHECK-NEXT:    mul.xyzw vf1, vf1, vf1 nop
; CHECK-NEXT:    nop sq.xyzw vf2, 3(vi0)
; CHECK-NEXT:    nop sq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %a = call <4 x float> @llvm.vu.lq(i16 1)
  %b = call <4 x float> @llvm.vu.lq(i16 2)
  %w = extractelement <4 x float> %v, i32 3
  %q = fdiv float 1.0, %w
  %b1 = fmul <4 x float> %b, %b
  %b2 = fmul <4 x float> %b1, %b1
  %b3 = fmul <4 x float> %b2, %b2
  %s = insertelement <4 x float> poison, float %q, i32 0
  %bq = shufflevector <4 x float> %s, <4 x float> poison, <4 x i32> zeroinitializer
  %r = fmul <4 x float> %a, %bq
  call void @llvm.vu.sq(<4 x float> %r, i16 3)
  call void @llvm.vu.sq(<4 x float> %b3, i16 4)
  ret void
}

; x / y and sqrt(z) of different fields; the scalar results are moved out
; of Q with ADDq.
define void @fields() {
; CHECK-LABEL: fields:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop div q, vf1x, vf1y
; CHECK-NEXT:    nop waitq
; CHECK-NEXT:    addq.x vf2, vf0, q sqrt q, vf1z
; CHECK-NEXT:    addq.x vf1, vf0, q waitq
; CHECK-NEXT:    add.xyzw vf1, vf2, vf1 nop
; CHECK-NEXT:    addx.xyz vf1, vf0, vf1x nop
; CHECK-NEXT:    mulx.w vf1, vf0, vf1x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %x = extractelement <4 x float> %v, i32 0
  %y = extractelement <4 x float> %v, i32 1
  %z = extractelement <4 x float> %v, i32 2
  %d = fdiv float %x, %y
  %r = call float @llvm.sqrt.f32(float %z)
  %s = fadd float %d, %r
  %sv = insertelement <4 x float> poison, float %s, i32 0
  call void @llvm.vu.sq(<4 x float> %sv, i16 1)
  ret void
}

; The second division writes Q before the first quotient is used, so the
; first one is moved out of Q.
define void @two_divisions() {
; CHECK-LABEL: two_divisions:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    nop div q, vf0w, vf1x
; CHECK-NEXT:    nop waitq
; CHECK-NEXT:    addq.x vf3, vf0, q div q, vf0w, vf1y
; CHECK-NEXT:    mulx.xyzw vf1, vf2, vf3x nop
; CHECK-NEXT:    mulq.xyzw vf1, vf1, q waitq
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %a = call <4 x float> @llvm.vu.lq(i16 1)
  %x = extractelement <4 x float> %v, i32 0
  %y = extractelement <4 x float> %v, i32 1
  %q0 = fdiv float 1.0, %x
  %q1 = fdiv float 1.0, %y
  %s0 = insertelement <4 x float> poison, float %q0, i32 0
  %b0 = shufflevector <4 x float> %s0, <4 x float> poison, <4 x i32> zeroinitializer
  %s1 = insertelement <4 x float> poison, float %q1, i32 0
  %b1 = shufflevector <4 x float> %s1, <4 x float> poison, <4 x i32> zeroinitializer
  %r0 = fmul <4 x float> %a, %b0
  %r1 = fmul <4 x float> %r0, %b1
  call void @llvm.vu.sq(<4 x float> %r1, i16 2)
  ret void
}

declare float @llvm.sqrt.f32(float)

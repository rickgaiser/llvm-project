# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=vu -start-before=greedy -stop-after=post-ra-pseudos \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# There is only one ACC and one Q. When two values of one of them are live at
# the same time, the register allocator keeps one of them in a VF register:
#   ACC -> VF: MSUBx.xyzw d, vf0, vf0x    VF -> ACC: MULAw.xyzw acc, s, vf0w
#   Q -> VF:   ADDq.x d, vf0, q           VF -> Q:   DIV q, s.x, vf0.w

---
name: two_acc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: two_acc
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $acc = MULA 15, $vf1, $vf2
    ; CHECK-NEXT: $vf3 = MSUBx killed $acc, 15, $vf0, $vf0
    ; CHECK-NEXT: $acc = MULA 15, $vf2, $vf2
    ; CHECK-NEXT: $vf4 = MSUBx killed $acc, 15, $vf0, $vf0
    ; CHECK-NEXT: $acc = MULAw 15, killed $vf3, $vf0
    ; CHECK-NEXT: $vf3 = MADD killed $acc, 15, $vf1, $vf2
    ; CHECK-NEXT: $acc = MULAw 15, killed $vf4, $vf0
    ; CHECK-NEXT: $vf1 = MADD killed $acc, 15, killed $vf1, killed $vf2
    ; CHECK-NEXT: SQ 15, killed $vf3, 0, $vi0
    ; CHECK-NEXT: SQ 15, killed $vf1, 1, $vi0
    ; CHECK-NEXT: PROGRAM_END
    %0:vf = COPY $vf1
    %1:vf = COPY $vf2
    %2:accr = MULA 15, %0, %1
    %3:accr = MULA 15, %1, %1
    %4:vf = MADD %2, 15, %0, %1
    %5:vf = MADD %3, 15, %0, %1
    SQ 15, %4, 0, $vi0
    SQ 15, %5, 1, $vi0
    PROGRAM_END
...
---
name: two_q
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vf1, $vf2
    ; CHECK-LABEL: name: two_q
    ; CHECK: liveins: $vf1, $vf2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $q = DIV $vf1, 0, $vf2, 1
    ; CHECK-NEXT: $vf4 = ADDq 8, $vf0, killed $q
    ; CHECK-NEXT: $q = DIV $vf2, 0, $vf1, 1
    ; CHECK-NEXT: $vf3 = ADDq 8, $vf0, killed $q
    ; CHECK-NEXT: $q = DIV killed $vf4, 0, $vf0, 3
    ; CHECK-NEXT: $vf1 = MULq 15, killed $vf1, killed $q
    ; CHECK-NEXT: $q = DIV killed $vf3, 0, $vf0, 3
    ; CHECK-NEXT: $vf2 = MULq 15, killed $vf2, killed $q
    ; CHECK-NEXT: SQ 15, killed $vf1, 0, $vi0
    ; CHECK-NEXT: SQ 15, killed $vf2, 1, $vi0
    ; CHECK-NEXT: PROGRAM_END
    %0:vf = COPY $vf1
    %1:vf = COPY $vf2
    %2:qr = DIV %0, 0, %1, 1
    %3:qr = DIV %1, 0, %0, 1
    %4:vf = MULq 15, %0, %2
    %5:vf = MULq 15, %1, %3
    SQ 15, %4, 0, $vi0
    SQ 15, %5, 1, $vi0
    PROGRAM_END
...

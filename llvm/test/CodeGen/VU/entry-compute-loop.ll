; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals all --version 6
; RUN: opt -mtriple=vu -passes=vu-entry-lowering -S < %s | FileCheck %s

; Compute programs (VUEntryLowering, VUEntryABI.md): from quadword 0 the item
; count, the uniforms and the items. The code is for one item when it uses
; llvm.vu.item.index, else it runs once and loops itself.

@passes = external addrspace(1) global i16, !vu.uniform !0
@x = external addrspace(4) global [0 x { <4 x float>, <4 x float> }]

; Two quadwords per item; the passes over the items are the program's own.
;.
; CHECK: @vu.header = private constant [453 x i8] c"/* compute program twice: VU data memory layout, in quadwords */\0A#define VU_TWICE_PASSES 1\0A#define VU_TWICE_ENTRY 0  /* micro address, 64-bit units */\0A#define VU_TWICE_N 0  /* the item count, field x */\0A#define VU_TWICE_X 2  /* the items */\0A#define VU_TWICE_SIZE 2  /* quadwords before the items */\0A#define VU_TWICE_ITEM_QW 2  /* quadwords per item */\0A#define VU_TWICE_FORMAT 0x0C  /* UNPACK V4-32 */\0A#define VU_TWICE_DBUF 0  /* no double buffering */\0A\0A", section ".vu.header", align 1
; CHECK: @llvm.used = appending global [1 x ptr] [ptr @vu.header], section "llvm.metadata"
;.
define void @twice() #0 {
; CHECK-LABEL: define void @twice() {
; CHECK-NEXT:  [[VU_ENTRY:.*:]]
; CHECK-NEXT:    [[N1:%.*]] = call i16 @llvm.vu.ilw(i16 0, i32 0)
; CHECK-NEXT:    [[K:%.*]] = load i16, ptr addrspace(1) inttoptr (i16 16 to ptr addrspace(1)), align 2
; CHECK-NEXT:    br label %[[ENTRY:.*]]
; CHECK:       [[ENTRY]]:
; CHECK-NEXT:    br label %[[PASS:.*]]
; CHECK:       [[PASS]]:
; CHECK-NEXT:    [[J:%.*]] = phi i16 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[ITEM_END:.*]] ]
; CHECK-NEXT:    br label %[[ITEM:.*]]
; CHECK:       [[ITEM]]:
; CHECK-NEXT:    [[I:%.*]] = phi i16 [ 0, %[[PASS]] ], [ [[I_NEXT:%.*]], %[[ITEM]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr [0 x { <4 x float>, <4 x float> }], ptr addrspace(4) inttoptr (i16 32 to ptr addrspace(4)), i16 0, i16 [[I]], i32 1
; CHECK-NEXT:    [[V:%.*]] = load <4 x float>, ptr addrspace(4) [[P]], align 16
; CHECK-NEXT:    [[R:%.*]] = fadd <4 x float> [[V]], [[V]]
; CHECK-NEXT:    store <4 x float> [[R]], ptr addrspace(4) [[P]], align 16
; CHECK-NEXT:    [[I_NEXT]] = add i16 [[I]], 1
; CHECK-NEXT:    [[C:%.*]] = icmp eq i16 [[I_NEXT]], [[N1]]
; CHECK-NEXT:    br i1 [[C]], label %[[ITEM_END]], label %[[ITEM]]
; CHECK:       [[ITEM_END]]:
; CHECK-NEXT:    [[J_NEXT]] = add i16 [[J]], 1
; CHECK-NEXT:    [[D:%.*]] = icmp eq i16 [[J_NEXT]], [[K]]
; CHECK-NEXT:    br i1 [[D]], label %[[DONE:.*]], label %[[PASS]]
; CHECK:       [[DONE]]:
; CHECK-NEXT:    ret void
;
entry:
  %n = call i16 @llvm.vu.item.count()
  %k = load i16, ptr addrspace(1) @passes
  br label %pass
pass:
  %j = phi i16 [ 0, %entry ], [ %j.next, %item.end ]
  br label %item
item:
  %i = phi i16 [ 0, %pass ], [ %i.next, %item ]
  %p = getelementptr [0 x { <4 x float>, <4 x float> }], ptr addrspace(4) @x, i16 0, i16 %i, i32 1
  %v = load <4 x float>, ptr addrspace(4) %p
  %r = fadd <4 x float> %v, %v
  store <4 x float> %r, ptr addrspace(4) %p
  %i.next = add i16 %i, 1
  %c = icmp eq i16 %i.next, %n
  br i1 %c, label %item.end, label %item
item.end:
  %j.next = add i16 %j, 1
  %d = icmp eq i16 %j.next, %k
  br i1 %d, label %done, label %pass
done:
  ret void
}

declare i16 @llvm.vu.item.count()
attributes #0 = { "vu-entry"="compute" }
!0 = !{i32 0}

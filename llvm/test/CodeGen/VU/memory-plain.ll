; RUN: llc -mtriple=vu -mcpu=vu1 -verify-machineinstrs < %s | FileCheck %s

; Plain loads and stores of VU data memory (VULowerMemory): pointers are byte
; addresses, the VU addresses quadwords. Terms of an address with a scale of
; 16 bytes become quadword terms, and the rest selects the fields.

; a table at a computed index: table[int(v.x)]
define void @table() {
; CHECK-LABEL: table:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    ftoi0.x vf1, vf1 nop
; CHECK-NEXT:    nop mtir vi1, vf1x
; CHECK-NEXT:    nop lq.xyzw vf1, 2(vi1)
; CHECK-NEXT:    nop sq.xyzw vf1, 3(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %v = load <4 x float>, ptr inttoptr (i16 16 to ptr)
  %x = extractelement <4 x float> %v, i32 0
  %i = fptosi float %x to i16
  %p = getelementptr [8 x <4 x float>], ptr inttoptr (i16 32 to ptr), i16 0, i16 %i
  %t = load <4 x float>, ptr %p
  store <4 x float> %t, ptr inttoptr (i16 48 to ptr)
  ret void
}

; scalar fields, a float3 store, and a field of a struct
define void @fields() {
; CHECK-LABEL: fields:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 4(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 6(vi0)
; CHECK-NEXT:    addz.xyz vf1, vf0, vf1z nop
; CHECK-NEXT:    add.xyzw vf2, vf2, vf2 nop
; CHECK-NEXT:    nop mr32.w vf1, vf1
; CHECK-NEXT:    nop sq.xyz vf2, 8(vi0)
; CHECK-NEXT:    nop sq.w vf1, 8(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %s = load float, ptr inttoptr (i16 72 to ptr)          ; quadword 4, field z
  %p = getelementptr { <4 x float>, <4 x float> }, ptr inttoptr (i16 80 to ptr), i16 0, i32 1
  %v = load <4 x float>, ptr %p                         ; quadword 6
  %m = fmul <4 x float> %v, <float 2.0, float 2.0, float 2.0, float 2.0>
  %m3 = shufflevector <4 x float> %m, <4 x float> poison, <3 x i32> <i32 0, i32 1, i32 2>
  store <3 x float> %m3, ptr inttoptr (i16 128 to ptr) ; quadword 8, xyz
  store float %s, ptr inttoptr (i16 140 to ptr)        ; quadword 8, w
  ret void
}

; a loop over an array with a base from xtop
declare i16 @llvm.vu.xtop()
define void @loop() {
; CHECK-LABEL: loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop iaddiu vi4, vi0, 0
; CHECK-NEXT:    nop xtop vi2
; CHECK-NEXT:    nop iadd vi1, vi2, vi4
; CHECK-NEXT:    nop iaddiu vi3, vi0, 64
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi1)
; CHECK-NEXT:    nop iaddi vi4, vi4, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    add.xyzw vf1, vf1, vf1 ibeq vi4, vi3, .LBB2_2
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB2_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop sq.xyzw vf1, 100(vi1)
; CHECK-NEXT:    nop iadd vi1, vi2, vi4
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi1)
; CHECK-NEXT:    nop iaddi vi4, vi4, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    add.xyzw vf1, vf1, vf1 ibne vi4, vi3, .LBB2_1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB2_2:
; CHECK-NEXT:    nop sq.xyzw vf1, 100(vi1)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
entry:
  %top = call i16 @llvm.vu.xtop()
  %b = shl i16 %top, 4
  %base = inttoptr i16 %b to ptr
  br label %loop
loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %pi = getelementptr <4 x float>, ptr %base, i16 %i
  %po = getelementptr <4 x float>, ptr %pi, i16 100
  %x = load <4 x float>, ptr %pi
  %y = fadd <4 x float> %x, %x
  store <4 x float> %y, ptr %po
  %i.next = add i16 %i, 1
  %c = icmp eq i16 %i.next, 64
  br i1 %c, label %done, label %loop
done:
  ret void
}

; a matrix: 16 floats in 4 quadwords
define void @matrix() {
; CHECK-LABEL: matrix:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 11(vi0)
; CHECK-NEXT:    nop sq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %m = load <16 x float>, ptr inttoptr (i16 160 to ptr)
  %c = shufflevector <16 x float> %m, <16 x float> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>
  store <4 x float> %c, ptr inttoptr (i16 16 to ptr)
  ret void
}

; 16-bit counts
define void @count() {
; CHECK-LABEL: count:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop ilw.y vi1, 0(vi0)
; CHECK-NEXT:    nop iaddi vi1, vi1, 3
; CHECK-NEXT:    nop isw.z vi1, 1(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
  %n = load i16, ptr inttoptr (i16 4 to ptr)
  %m = add i16 %n, 3

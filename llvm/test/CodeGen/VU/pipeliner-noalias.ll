; The memory operands of VU loads and stores have no IR value, as the address
; is a quadword index. Scoped noalias metadata still tells the input and the
; output apart, also across iterations, so the transform of one vertex does
; not wait for the stores of the previous one.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare i16 @llvm.vu.ilw(i16, i32)

; CHECK: Minimal Initiation Interval: 8 (ResMII 8, RecMII 2)
; CHECK: Schedule found with Initiation Interval: 9, MaxStageCount: 2
define void @scoped() {
entry:
  %in = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %out = call i16 @llvm.vu.ilw(i16 0, i32 1)
  %n = call i16 @llvm.vu.ilw(i16 0, i32 2)
  %m0 = call <4 x float> @llvm.vu.lq(i16 1)
  %m1 = call <4 x float> @llvm.vu.lq(i16 2)
  %m3 = call <4 x float> @llvm.vu.lq(i16 3)
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %pi = phi i16 [ %in, %entry ], [ %pi.next, %loop ]
  %po = phi i16 [ %out, %entry ], [ %po.next, %loop ]
  %pos = call <4 x float> @llvm.vu.lq(i16 %pi), !alias.scope !3, !noalias !4
  %pc = add i16 %pi, 1
  %col = call <4 x float> @llvm.vu.lq(i16 %pc), !alias.scope !3, !noalias !4
  %x = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> zeroinitializer
  %y = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %t0 = fmul fast <4 x float> %m0, %x
  %t1 = fmul fast <4 x float> %m1, %y
  %s0 = fadd fast <4 x float> %t0, %t1
  %p = fadd fast <4 x float> %s0, %m3
  %w = extractelement <4 x float> %p, i32 3
  %q = fdiv fast float 1.0, %w
  %qs = insertelement <4 x float> poison, float %q, i32 0
  %qv = shufflevector <4 x float> %qs, <4 x float> poison, <4 x i32> zeroinitializer
  %pq = fmul fast <4 x float> %p, %qv
  call void @llvm.vu.sq(<4 x float> %col, i16 %po), !alias.scope !4, !noalias !3
  %po1 = add i16 %po, 1
  call void @llvm.vu.sq(<4 x float> %pq, i16 %po1), !alias.scope !4, !noalias !3
  %pi.next = add i16 %pi, 2
  %po.next = add i16 %po, 2
  %i.next = add i16 %i, 1
  %c = icmp eq i16 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

; Without the metadata, the stores may write what the next iteration loads:
; every iteration waits for the previous one.
; CHECK: Minimal Initiation Interval: 21 (ResMII 8, RecMII 21)
define void @unscoped() {
entry:
  %in = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %out = call i16 @llvm.vu.ilw(i16 0, i32 1)
  %n = call i16 @llvm.vu.ilw(i16 0, i32 2)
  %m0 = call <4 x float> @llvm.vu.lq(i16 1)
  %m1 = call <4 x float> @llvm.vu.lq(i16 2)
  %m3 = call <4 x float> @llvm.vu.lq(i16 3)
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %pi = phi i16 [ %in, %entry ], [ %pi.next, %loop ]
  %po = phi i16 [ %out, %entry ], [ %po.next, %loop ]
  %pos = call <4 x float> @llvm.vu.lq(i16 %pi)
  %pc = add i16 %pi, 1
  %col = call <4 x float> @llvm.vu.lq(i16 %pc)
  %x = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> zeroinitializer
  %y = shufflevector <4 x float> %pos, <4 x float> poison, <4 x i32> <i32 1, i32 1, i32 1, i32 1>
  %t0 = fmul fast <4 x float> %m0, %x
  %t1 = fmul fast <4 x float> %m1, %y
  %s0 = fadd fast <4 x float> %t0, %t1
  %p = fadd fast <4 x float> %s0, %m3
  %w = extractelement <4 x float> %p, i32 3
  %q = fdiv fast float 1.0, %w
  %qs = insertelement <4 x float> poison, float %q, i32 0
  %qv = shufflevector <4 x float> %qs, <4 x float> poison, <4 x i32> zeroinitializer
  %pq = fmul fast <4 x float> %p, %qv
  call void @llvm.vu.sq(<4 x float> %col, i16 %po)
  %po1 = add i16 %po, 1
  call void @llvm.vu.sq(<4 x float> %pq, i16 %po1)
  %pi.next = add i16 %pi, 2
  %po.next = add i16 %po, 2
  %i.next = add i16 %i, 1
  %c = icmp eq i16 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

!0 = distinct !{!0, i1 true, !"vertices"}
!1 = distinct !{!1, !0, !"in"}
!2 = distinct !{!2, !0, !"out"}
!3 = !{!1}
!4 = !{!2}

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=vu -mcpu=vu1 -O3 -verify-machineinstrs < %s | FileCheck %s

; Clipping: CLIPw.xyz judges a vector against +/-|w|, FCAND tests the flags
; (llvm.vu.clip, llvm.vu.fcand). The flags have no interlock: a test sees a
; CLIP 4 cycles after it, so a test that comes too early gets empty words
; before it (VUHazards). A CLIP and its test are one instruction for the
; pipeliner (CLIP_FCAND), which keeps them in one stage.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare void @llvm.vu.isw(i16, i16, i32)
declare i16 @llvm.vu.ilw(i16, i32)
declare void @llvm.vu.clip(<4 x float>, <4 x float>)
declare i16 @llvm.vu.fcand(i32)

; The test right after the CLIP waits 3 words.
define void @test_after_clip() {
; CHECK-LABEL: test_after_clip:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    clipw.xyz vf1, vf2w nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop fcand vi1, 63
; CHECK-NEXT:    nop isw.x vi1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %g = call <4 x float> @llvm.vu.lq(i16 1)
  call void @llvm.vu.clip(<4 x float> %v, <4 x float> %g)
  %c = call i16 @llvm.vu.fcand(i32 63)
  call void @llvm.vu.isw(i16 %c, i16 2, i32 0)
  ret void
}

; Each point of a strip is judged against the guard band; a point whose
; triangle (it and the two before) has a point outside gets bit 15 in w.
define void @strip() {
; CHECK-LABEL: strip:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop iaddiu vi4, vi0, 0
; CHECK-NEXT:    nop lq.xyzw vf1, 1(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 2(vi4)
; CHECK-NEXT:    nop ilw.x vi3, 0(vi0)
; CHECK-NEXT:    nop iaddi vi2, vi4, 1
; CHECK-NEXT:    clipw.xyz vf2, vf1w nop
; CHECK-NEXT:    nop sq.xyzw vf2, 200(vi4)
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibeq vi3, vi2, .LBB1_2
; CHECK-NEXT:    nop fcand vi1, 262143
; CHECK-NEXT:  .LBB1_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop lq.xyzw vf2, 2(vi2)
; CHECK-NEXT:    nop iaddi vi2, vi2, 1
; CHECK-NEXT:    nop iaddiu vi1, vi1, 32767
; CHECK-NEXT:    nop isw.w vi1, 198(vi2)
; CHECK-NEXT:    clipw.xyz vf2, vf1w nop
; CHECK-NEXT:    nop sq.xyzw vf2, 199(vi2)
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibne vi3, vi2, .LBB1_1
; CHECK-NEXT:    nop fcand vi1, 262143
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    nop iaddiu vi1, vi1, 32767
; CHECK-NEXT:    nop isw.w vi1, 199(vi2)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop nop
entry:
  %n = call i16 @llvm.vu.ilw(i16 0, i32 0)
  %g = call <4 x float> @llvm.vu.lq(i16 1)
  br label %loop
loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %p = add i16 %i, 2
  %v = call <4 x float> @llvm.vu.lq(i16 %p)
  call void @llvm.vu.clip(<4 x float> %v, <4 x float> %g)
  %cut = call i16 @llvm.vu.fcand(i32 262143)
  %adc = add i16 %cut, 32767
  %q = add i16 %i, 200
  call void @llvm.vu.sq(<4 x float> %v, i16 %q)
  call void @llvm.vu.isw(i16 %adc, i16 %q, i32 3)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret void
}

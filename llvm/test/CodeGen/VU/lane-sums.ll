; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=vu -enable-pipeliner=false < %s | FileCheck %s

; A sum of fields takes one FMAC instruction less with broadcasts, which
; counts in a loop, and a few cycles less through ACC, which counts outside of
; loops. The order of the additions, and so the result, is the same.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

define void @no_loop() {
; CHECK-LABEL: no_loop:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop lq.xyzw vf2, 1(vi0)
; CHECK-NEXT:    mul.xyzw vf2, vf1, vf2 nop
; CHECK-NEXT:    mulay.xyzw acc, vf0, vf2y nop
; CHECK-NEXT:    maddaz.xyzw acc, vf0, vf2z nop
; CHECK-NEXT:    maddx.xyzw vf2, vf0, vf2x nop
; CHECK-NEXT:    addw.x vf2, vf0, vf2w nop
; CHECK-NEXT:    mulx.w vf1, vf0, vf2x nop
; CHECK-NEXT:    nop sq.xyzw vf1, 2(vi0)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  %b = call <4 x float> @llvm.vu.lq(i16 1)
  %t = fmul <4 x float> %a, %b
  %tx = extractelement <4 x float> %t, i32 0
  %ty = extractelement <4 x float> %t, i32 1
  %tz = extractelement <4 x float> %t, i32 2
  %tyz = fadd float %ty, %tz
  %dot = fadd float %tyz, %tx
  %v = insertelement <4 x float> %a, float %dot, i32 3
  call void @llvm.vu.sq(<4 x float> %v, i16 2)
  ret void
}

define void @in_loop() {
; CHECK-LABEL: in_loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop lq.xyzw vf1, 0(vi0)
; CHECK-NEXT:    nop iaddiu vi1, vi0, 10
; CHECK-NEXT:    nop iaddiu vi2, vi0, 50
; CHECK-NEXT:  .LBB1_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop lq.xyzw vf2, 0(vi1)
; CHECK-NEXT:    mul.xyzw vf3, vf1, vf2 nop
; CHECK-NEXT:    addz.xyzw vf4, vf3, vf3z nop
; CHECK-NEXT:    addx.xyzw vf3, vf4, vf3x nop
; CHECK-NEXT:    addy.x vf3, vf0, vf3y nop
; CHECK-NEXT:    mulx.w vf2, vf0, vf3x nop
; CHECK-NEXT:    nop sq.xyzw vf2, 100(vi1)
; CHECK-NEXT:    nop iaddi vi1, vi1, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibne vi1, vi2, .LBB1_1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB1_2: ; %exit
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
entry:
  %a = call <4 x float> @llvm.vu.lq(i16 0)
  br label %loop

loop:
  %i = phi i16 [ 10, %entry ], [ %i.next, %loop ]
  %b = call <4 x float> @llvm.vu.lq(i16 %i)
  %t = fmul <4 x float> %a, %b
  %tx = extractelement <4 x float> %t, i32 0
  %ty = extractelement <4 x float> %t, i32 1
  %tz = extractelement <4 x float> %t, i32 2
  %tyz = fadd float %ty, %tz
  %dot = fadd float %tyz, %tx
  %v = insertelement <4 x float> %b, float %dot, i32 3
  %o = add i16 %i, 100
  call void @llvm.vu.sq(<4 x float> %v, i16 %o)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 50
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

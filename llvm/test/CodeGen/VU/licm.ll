; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Constants are loaded through I (LOI) once, before the loop.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

define void @scale_loop() {
; CHECK-LABEL: scale_loop:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop loi 0x40400000
; CHECK-NEXT:    addi.x vf1, vf0, i iaddiu vi1, vi0, 0
; CHECK-NEXT:    nop iaddiu vi2, vi0, 100
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop lq.xyzw vf2, 0(vi1)
; CHECK-NEXT:    mulx.xyzw vf2, vf2, vf1x nop
; CHECK-NEXT:    nop sq.xyzw vf2, 0(vi1)
; CHECK-NEXT:    nop iaddi vi1, vi1, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibne vi1, vi2, .LBB0_1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB0_2: ; %exit
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %v = call <4 x float> @llvm.vu.lq(i16 %i)
  %s = fmul <4 x float> %v, <float 3.0, float 3.0, float 3.0, float 3.0>
  call void @llvm.vu.sq(<4 x float> %s, i16 %i)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 100
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Software pipelining of single block loops: a prologue and epilogues around a
; kernel that overlaps several iterations, with an exit test per stage.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)

; The store of iteration i can only be read by iteration i + 64, which never
; overlaps with iteration i, so the loop is pipelined (II 4, 4 stages).
define void @far_dependence() {
; CHECK-LABEL: far_dependence:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop iaddiu vi1, vi0, 65
; CHECK-NEXT:    nop iaddiu vi4, vi0, 97
; CHECK-NEXT:    nop lq.xyzw vf4, -64(vi1)
; CHECK-NEXT:    nop iaddi vi2, vi1, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibeq vi2, vi4, .LBB0_6
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    nop lq.xyzw vf2, -64(vi2)
; CHECK-NEXT:    mul.xyzw vf1, vf4, vf4 iaddi vi3, vi2, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    nop ibeq vi3, vi4, .LBB0_5
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB0_2: ; %loop
; CHECK-NEXT:    nop lq.xyzw vf5, -64(vi3)
; CHECK-NEXT:    add.xyzw vf3, vf1, vf4 iaddi vi5, vi3, 1
; CHECK-NEXT:    mul.xyzw vf1, vf2, vf2 nop
; CHECK-NEXT:    nop ibeq vi5, vi4, .LBB0_4
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB0_3: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop move.xyzw vf4, vf2
; CHECK-NEXT:    nop move.xyzw vf2, vf5
; CHECK-NEXT:    nop iaddiu vi6, vi1, 0
; CHECK-NEXT:    nop iaddiu vi1, vi2, 0
; CHECK-NEXT:    nop iaddiu vi2, vi3, 0
; CHECK-NEXT:    nop iaddiu vi3, vi5, 0
; CHECK-NEXT:    nop lq.xyzw vf5, -64(vi3)
; CHECK-NEXT:    mul.xyzw vf6, vf2, vf2 iaddi vi5, vi3, 1
; CHECK-NEXT:    add.xyzw vf3, vf1, vf4 sq.xyzw vf3, 0(vi6)
; CHECK-NEXT:    nop move.xyzw vf1, vf6
; CHECK-NEXT:    nop ibne vi5, vi4, .LBB0_3
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    nop move.xyzw vf4, vf2
; CHECK-NEXT:    nop sq.xyzw vf3, 0(vi1)
; CHECK-NEXT:    nop iaddiu vi1, vi2, 0
; CHECK-NEXT:    nop iaddiu vi2, vi3, 0
; CHECK-NEXT:    nop move.xyzw vf2, vf5
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    add.xyzw vf1, vf1, vf4 move.xyzw vf4, vf2
; CHECK-NEXT:    nop sq.xyzw vf1, 0(vi1)
; CHECK-NEXT:    nop iaddiu vi1, vi2, 0
; CHECK-NEXT:  .LBB0_6:
; CHECK-NEXT:    mul.xyzw vf1, vf4, vf4 nop
; CHECK-NEXT:    add.xyzw vf1, vf1, vf4 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 0(vi1)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %in = add i16 %i, 1
  %out = add i16 %i, 65
  %v = call <4 x float> @llvm.vu.lq(i16 %in)
  %w = fmul <4 x float> %v, %v
  %s = fadd <4 x float> %w, %v
  call void @llvm.vu.sq(<4 x float> %s, i16 %out)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 32
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; a[i + 1] = 3 * a[i]: the load of the next iteration reads the store, so it
; stays after it (II 9, 2 stages).
define void @recurrence() {
; CHECK-LABEL: recurrence:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    nop loi 0x40400000
; CHECK-NEXT:    addi.x vf1, vf0, i iaddiu vi1, vi0, 1
; CHECK-NEXT:    nop iaddiu vi2, vi0, 11
; CHECK-NEXT:  .LBB1_2: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    nop lq.xyzw vf2, -1(vi1)
; CHECK-NEXT:    nop iaddi vi3, vi1, 1
; CHECK-NEXT:    nop nop
; CHECK-NEXT:    mulx.xyzw vf2, vf2, vf1x ibeq vi3, vi2, .LBB1_3
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB1_1: ; %loop
; CHECK-NEXT:    ; in Loop: Header=BB1_2 Depth=1
; CHECK-NEXT:    nop sq.xyzw vf2, 0(vi1)
; CHECK-NEXT:    nop iaddiu vi1, vi3, 0
; CHECK-NEXT:    nop b .LBB1_2
; CHECK-NEXT:    nop nop
; CHECK-NEXT:  .LBB1_3:
; CHECK-NEXT:    nop sq.xyzw vf2, 0(vi1)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
entry:
  br label %loop

loop:
  %i = phi i16 [ 0, %entry ], [ %i.next, %loop ]
  %v = call <4 x float> @llvm.vu.lq(i16 %i)
  %s = fmul <4 x float> %v, <float 3.0, float 3.0, float 3.0, float 3.0>
  %next = add i16 %i, 1
  call void @llvm.vu.sq(<4 x float> %s, i16 %next)
  %i.next = add i16 %i, 1
  %done = icmp eq i16 %i.next, 10
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

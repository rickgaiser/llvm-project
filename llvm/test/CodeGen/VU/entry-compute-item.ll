; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s --check-prefix=ASM

; Compute programs (VUEntryLowering, VUEntryABI.md): from quadword 0 the item
; count, the uniforms and the items. The code is for one item when it uses
; llvm.vu.item.index, else it runs once and loops itself.

; ASM-LABEL: scale:
; ASM:         ilw.x vi{{[0-9]+}}, 0(vi0)
; ASM:         lq.xyzw vf{{[0-9]+}}, 1(vi0)

@c = external addrspace(1) global <4 x float>, !vu.uniform !0
@x = external addrspace(4) global [0 x <4 x float>]

;.
; CHECK: @vu.header = private constant [448 x i8] c"/* compute program scale: VU data memory layout, in quadwords */\0A#define VU_SCALE_C 1\0A#define VU_SCALE_ENTRY 0  /* micro address, 64-bit units */\0A#define VU_SCALE_N 0  /* the item count, field x */\0A#define VU_SCALE_X 2  /* the items */\0A#define VU_SCALE_SIZE 2  /* quadwords before the items */\0A#define VU_SCALE_ITEM_QW 1  /* quadwords per item */\0A#define VU_SCALE_FORMAT 0x0C  /* UNPACK V4-32 */\0A#define VU_SCALE_DBUF 0  /* no double buffering */\0A\0A", section ".vu.header", align 1
; CHECK: @llvm.used = appending global [1 x ptr] [ptr @vu.header], section "llvm.metadata"
;.
define void @scale() #0 {
; CHECK-LABEL: define void @scale(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[VU_ENTRY:.*]]:
; CHECK-NEXT:    [[N:%.*]] = call i16 @llvm.vu.ilw(i16 0, i32 0)
; CHECK-NEXT:    [[EMPTY:%.*]] = icmp eq i16 [[N]], 0
; CHECK-NEXT:    [[K:%.*]] = load <4 x float>, ptr addrspace(1) inttoptr (i16 16 to ptr addrspace(1)), align 16
; CHECK-NEXT:    br i1 [[EMPTY]], label %[[VU_DONE:.*]], label %[[VU_ITEM:.*]]
; CHECK:       [[VU_ITEM]]:
; CHECK-NEXT:    [[I1:%.*]] = phi i16 [ 0, %[[VU_ENTRY]] ], [ [[I_NEXT:%.*]], %[[VU_ITEM]] ]
; CHECK-NEXT:    [[P:%.*]] = getelementptr [0 x <4 x float>], ptr addrspace(4) inttoptr (i16 32 to ptr addrspace(4)), i16 0, i16 [[I1]]
; CHECK-NEXT:    [[V:%.*]] = load <4 x float>, ptr addrspace(4) [[P]], align 16
; CHECK-NEXT:    [[R:%.*]] = fmul <4 x float> [[V]], [[K]]
; CHECK-NEXT:    store <4 x float> [[R]], ptr addrspace(4) [[P]], align 16
; CHECK-NEXT:    [[I_NEXT]] = add i16 [[I1]], 1
; CHECK-NEXT:    [[LAST:%.*]] = icmp eq i16 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[LAST]], label %[[VU_DONE]], label %[[VU_ITEM]]
; CHECK:       [[VU_DONE]]:
; CHECK-NEXT:    ret void
;
  %i = call i16 @llvm.vu.item.index()
  %p = getelementptr [0 x <4 x float>], ptr addrspace(4) @x, i16 0, i16 %i
  %v = load <4 x float>, ptr addrspace(4) %p
  %k = load <4 x float>, ptr addrspace(1) @c
  %r = fmul <4 x float> %v, %k
  store <4 x float> %r, ptr addrspace(4) %p
  ret void
}

declare i16 @llvm.vu.item.index()
attributes #0 = { "vu-entry"="compute" "target-cpu"="vu0" }
!0 = !{i32 0}


; An indexed vertex program ("vu-indexed"="16", VUEntryABI.md): the code for
; one vertex runs once for each of the 16 vertices of a batch and writes the
; outputs into the table at the top of data memory; a gather then copies them
; into the GIF packet (one for both buffers) by the index list (V4-8U, each
; index the vertex times the number of outputs) and sends it. The uniforms are
; in one of two blocks above the buffers (counts.z); the vertex count and the
; number of index quadwords are counts.x and counts.y.

; After the vertex loop: the empty GIF tag (NLOOP 0, EOP) is sent, which
; waits until the GIF has read the packet of the batch before; then the tag
; and the gather, whose loads have the table address as their offset.
; The init, then the batches (vu.kick ends one, MSCNT starts the next).
; ASM-LABEL: shade:
; ASM:         xitop vi{{[0-9]+}}
; ASM:       .LBB0_1: ; %vu.batch
; ASM:         xtop vi[[TOP:[0-9]+]]
; ASM-DAG:     ilw.x vi{{[0-9]+}}, 0(vi[[TOP]])
; ASM-DAG:     ilw.z vi{{[0-9]+}}, 0(vi[[TOP]])
; ASM-DAG:     ilw.w vi{{[0-9]+}}, 0(vi[[TOP]])
; ASM-DAG:     xitop vi{{[0-9]+}}
; ASM:         isw.x vi{{[0-9]+}}, 979(vi0)
; ASM:         isw.y vi{{[0-9]+}}, 979(vi0)
; ASM:         xgkick vi{{[0-9]+}}
; ASM:         sq.xyzw vf{{[0-9]+}}, 254(vi0)
; ASM:         isw.x vi{{[0-9]+}}, 254(vi0)
; ASM:         lq.xyzw vf{{[0-9]+}}, 992(vi{{[0-9]+}})
; ASM:         lq.xyzw vf{{[0-9]+}}, 993(vi{{[0-9]+}})
; ASM:       %vu.kick
; ASM:         xgkick vi{{[0-9]+}}
; ASM-NEXT:    nop[e] nop
; ASM-NEXT:    nop nop
; ASM-NEXT:    b .LBB0_1

; HDR:      #define VU_SHADE_MVP 0
; HDR-NEXT: #define VU_SHADE_SCALE 4  /* field y */
; HDR:      #define VU_SHADE_BUF_QW 127  /* double buffer size */
; HDR-NEXT: #define VU_SHADE_UNI_QW 5  /* uniforms, after the context's GIF tag */
; HDR-NEXT: #define VU_SHADE_CTX_AT 980  /* the contexts: GIF tag (NLOOP 0), uniforms */
; HDR-NEXT: #define VU_SHADE_CTX_QW 6  /* per context */
; HDR-NEXT: #define VU_SHADE_NCTX 2  /* contexts (1: a FLUSHE before writing it) */
; HDR:      #define VU_SHADE_MAX_N 16  /* vertices per batch */
; HDR-NEXT: #define VU_SHADE_ALIGN 4
; HDR-NEXT: #define VU_SHADE_COUNTS 0  /* x vertices, z index quadwords, w indices */
; HDR-NEXT: #define VU_SHADE_IN_AT 1  /* first item */
; HDR-NEXT: #define VU_SHADE_OUT_AT 254  /* the output GIF tag, one for both buffers */
; HDR-NEXT: #define VU_SHADE_INDEXED 1
; HDR-NEXT: #define VU_SHADE_EMPTY_AT 979  /* the empty GIF tag */
; HDR-NEXT: #define VU_SHADE_MAX_I 352  /* indices per batch, a multiple of 16 */

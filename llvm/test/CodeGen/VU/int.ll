; 16-bit integer arithmetic on VI registers.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare void @llvm.vu.sq.mask(<4 x float>, i16, i32)
declare i16 @llvm.vu.ilw(i16, i32)

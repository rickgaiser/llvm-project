; CHECK-NEXT:    nop isw.w vi2, 0(vi1)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %t = call i16 @llvm.vu.xitop()
  %a = call i16 @llvm.vu.ilw(i16 %t, i32 1)
  %b = shl i16 %a, 2
  %c = sub i16 %b, -300
  %d = and i16 %c, 255
  %e = or i16 %d, %a
  %f = sitofp i16 %e to float
  %g = fptosi float %f to i16
  call void @llvm.vu.isw(i16 %g, i16 %t, i32 3)
  ret void
}


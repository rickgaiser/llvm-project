; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %v = call <4 x float> @llvm.vu.lq(i16 0)
  %a = call i16 @llvm.vu.ilw(i16 1, i32 0)
  %i = bitcast <4 x float> %v to <4 x i32>
  %e = extractelement <4 x i32> %i, i32 3
  %t = trunc i32 %e to i16

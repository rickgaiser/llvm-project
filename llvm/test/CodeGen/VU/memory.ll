; RUN: llc -mtriple=vu -verify-machineinstrs < %s | FileCheck %s

; Memory intrinsics take quadword addresses. A constant offset in the range
; [-1024, 1023] is folded into the instruction.

declare <4 x float> @llvm.vu.lq(i16)
declare void @llvm.vu.sq(<4 x float>, i16)
declare void @llvm.vu.sq.mask(<4 x float>, i16, i32)
declare i16 @llvm.vu.ilw(i16, i32)
declare void @llvm.vu.isw(i16, i16, i32)
declare i16 @llvm.vu.xitop()

define void @address_modes() {
; CHECK-LABEL: address_modes:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop xitop vi1
; CHECK-NEXT:    nop lq.xyzw vf1, 5(vi1)
; CHECK-NEXT:    nop lq.xyzw vf2, 1023(vi0)
; CHECK-NEXT:    nop iaddiu vi2, vi1, 2000
; CHECK-NEXT:    add.xyzw vf1, vf1, vf2 nop
; CHECK-NEXT:    nop sq.xyzw vf1, 0(vi1)
; CHECK-NEXT:    nop sq.w vf1, -1024(vi1)
; CHECK-NEXT:    nop sq.xyzw vf1, 0(vi2)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %base = call i16 @llvm.vu.xitop()
  %p1 = add i16 %base, 5
  %a = call <4 x float> @llvm.vu.lq(i16 %p1)
  %b = call <4 x float> @llvm.vu.lq(i16 1023)
  %c = fadd <4 x float> %a, %b
  call void @llvm.vu.sq(<4 x float> %c, i16 %base)
  %p2 = add i16 %base, -1024
  call void @llvm.vu.sq.mask(<4 x float> %c, i16 %p2, i32 1)
  %far = add i16 %base, 2000
  call void @llvm.vu.sq(<4 x float> %c, i16 %far)
  ret void
}

define void @integer_fields() {
; CHECK-LABEL: integer_fields:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    nop xitop vi1
; CHECK-NEXT:    nop ilw.x vi2, 0(vi1)
; CHECK-NEXT:    nop ilw.w vi3, 7(vi0)
; CHECK-NEXT:    nop iadd vi2, vi2, vi3
; CHECK-NEXT:    nop isw.z vi2, -3(vi1)
; CHECK-NEXT:    nop[e] nop
; CHECK-NEXT:    nop nop
  %base = call i16 @llvm.vu.xitop()
  %x = call i16 @llvm.vu.ilw(i16 %base, i32 0)
  %w = call i16 @llvm.vu.ilw(i16 7, i32 3)
  %s = add i16 %x, %w
  %p = add i16 %base, -3
  call void @llvm.vu.isw(i16 %s, i16 %p, i32 2)
  ret void
}

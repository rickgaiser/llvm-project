## Check that objects with the R5900 machine flag (EF_MIPS_MACH_5900) can be
## disassembled. Reading the ELF flags used to hit llvm_unreachable.

# RUN: yaml2obj %s -o %t.o
# RUN: llvm-objdump -d %t.o | FileCheck %s

# CHECK:      <foo>:
# CHECK-NEXT:   0: 21 10 64 00   addu $2, $3, $4

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_MIPS
  Flags:   [ EF_MIPS_ARCH_3, EF_MIPS_MACH_5900, EF_MIPS_ABI2 ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: '21106400'
Symbols:
  - Name:    foo
    Section: .text

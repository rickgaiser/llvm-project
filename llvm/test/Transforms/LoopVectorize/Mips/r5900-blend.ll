; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "load <|store <|mul nuw nsw <" --version 6
; RUN: opt -passes=loop-vectorize -mtriple=mips64el -mcpu=r5900 -S < %s | FileCheck %s

; Blend 32-bit pixels by the alpha of the source: per channel s * a + d *
; (256 - a). The products of 8-bit values fit in 16 bits, so a v4i32
; multiply is one PMULTH and the loop is vectorized with 4 elements.

@src = global [4096 x i32] zeroinitializer, align 64
@dst = global [4096 x i32] zeroinitializer, align 64

define void @blend() {
; CHECK-LABEL: define void @blend(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0:%.*]], align 4
; CHECK:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1:%.*]], align 4
; CHECK:    [[TMP6:%.*]] = mul nuw nsw <4 x i32> [[TMP4:%.*]], [[TMP2:%.*]]
; CHECK:    [[TMP7:%.*]] = mul nuw nsw <4 x i32> [[TMP5:%.*]], [[TMP3:%.*]]
; CHECK:    store <4 x i32> [[TMP11:%.*]], ptr [[TMP1]], align 4
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds [4096 x i32], ptr @src, i32 0, i32 %i
  %pd = getelementptr inbounds [4096 x i32], ptr @dst, i32 0, i32 %i
  %s = load i32, ptr %ps, align 4
  %d = load i32, ptr %pd, align 4
  %a = lshr i32 %s, 24
  %na = sub nuw nsw i32 256, %a
  %sr = and i32 %s, 255
  %dr = and i32 %d, 255
  %ms = mul nuw nsw i32 %sr, %a
  %md = mul nuw nsw i32 %dr, %na
  %sum = add nuw nsw i32 %ms, %md
  %r = lshr i32 %sum, 8
  %da = and i32 %d, -256
  %o = or i32 %r, %da
  store i32 %o, ptr %pd, align 4
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 4096
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

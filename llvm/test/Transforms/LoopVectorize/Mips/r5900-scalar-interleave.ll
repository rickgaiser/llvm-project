; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes=loop-vectorize -mcpu=r5900 -S < %s | FileCheck %s

; A loop that is not vectorized (a multiply of 32-bit values has no MMI form)
; is not interleaved on the R5900 either: interleaved by 2, each store waits
; for its MULT (4 cycles), and LoopUnroll then only unrolls the remainder.
; LoopUnroll unrolls the loop itself.

target datalayout = "e-m:e-p:32:32-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "mips64el-unknown-unknown-gnuabin32"

define void @scale(ptr noalias %in, ptr noalias %out, i32 %n, i32 %k) {
; CHECK-LABEL: define void @scale(
; CHECK-SAME: ptr noalias [[IN:%.*]], ptr noalias [[OUT:%.*]], i32 [[N:%.*]], i32 [[K:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[N]], 0
; CHECK-NEXT:    br i1 [[C]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
; CHECK:       [[LOOP_PREHEADER]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ [[I_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[LOOP_PREHEADER]] ]
; CHECK-NEXT:    [[PI:%.*]] = getelementptr inbounds i32, ptr [[IN]], i32 [[I]]
; CHECK-NEXT:    [[PO:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i32 [[I]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[PI]], align 4
; CHECK-NEXT:    [[M:%.*]] = mul nsw i32 [[V]], [[K]]
; CHECK-NEXT:    store i32 [[M]], ptr [[PO]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %c = icmp sgt i32 %n, 0
  br i1 %c, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pi = getelementptr inbounds i32, ptr %in, i32 %i
  %po = getelementptr inbounds i32, ptr %out, i32 %i
  %v = load i32, ptr %pi, align 4
  %m = mul nsw i32 %v, %k
  store i32 %m, ptr %po, align 4
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

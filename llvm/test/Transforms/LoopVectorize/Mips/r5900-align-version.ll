; CHECK:    [[VY3:%.*]] = load float, ptr [[PY3:%.*]], align 4
; CHECK:    store float [[S3:%.*]], ptr [[PY3]], align 4
;
; VEC-LABEL: define void @saxpy_unrolled(
; VEC-SAME: ptr noalias [[X:%.*]], ptr noalias [[Y:%.*]], i32 [[N:%.*]], float [[A:%.*]]) #[[ATTR0]] {
; VEC:    [[ALIGNED:%.*]] = icmp eq i32 [[TMP3:%.*]], 0
; VEC:    br i1 [[ALIGNED]], [[LOOP_PH:label %.*]], [[LOOP_PH_UNALIGNED:label %.*]]
; VEC:    [[VX0_UNALIGNED:%.*]] = load float, ptr [[PX0_UNALIGNED:%.*]], align 4
; VEC:    [[VY0_UNALIGNED:%.*]] = load float, ptr [[PY0_UNALIGNED:%.*]], align 4
; VEC:    store float [[S0_UNALIGNED:%.*]], ptr [[PY0_UNALIGNED]], align 4
; VEC:    [[VX1_UNALIGNED:%.*]] = load float, ptr [[PX1_UNALIGNED:%.*]], align 4
; VEC:    [[VY1_UNALIGNED:%.*]] = load float, ptr [[PY1_UNALIGNED:%.*]], align 4
; VEC:    store float [[S1_UNALIGNED:%.*]], ptr [[PY1_UNALIGNED]], align 4
; VEC:    [[VX2_UNALIGNED:%.*]] = load float, ptr [[PX2_UNALIGNED:%.*]], align 4
; VEC:    [[VY2_UNALIGNED:%.*]] = load float, ptr [[PY2_UNALIGNED:%.*]], align 4
; VEC:    store float [[S2_UNALIGNED:%.*]], ptr [[PY2_UNALIGNED]], align 4
; VEC:    [[VX3_UNALIGNED:%.*]] = load float, ptr [[PX3_UNALIGNED:%.*]], align 4
; VEC:    [[VY3_UNALIGNED:%.*]] = load float, ptr [[PY3_UNALIGNED:%.*]], align 4
; VEC:    store float [[S3_UNALIGNED:%.*]], ptr [[PY3_UNALIGNED]], align 4
; VEC:    [[X_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[X]], i32 -16)
; VEC:    [[Y_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[Y]], i32 -16)
; VEC:    [[VX0:%.*]] = load float, ptr [[PX0:%.*]], align 4
; VEC:    [[VY0:%.*]] = load float, ptr [[PY0:%.*]], align 4
; VEC:    store float [[S0:%.*]], ptr [[PY0]], align 4
; VEC:    [[VX1:%.*]] = load float, ptr [[PX1:%.*]], align 4

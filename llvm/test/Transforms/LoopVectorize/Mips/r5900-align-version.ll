; CHECK:    [[VX0_UNALIGNED:%.*]] = load float, ptr [[PX0_UNALIGNED:%.*]], align 4
; CHECK:    [[VY0_UNALIGNED:%.*]] = load float, ptr [[PY0_UNALIGNED:%.*]], align 4
; CHECK:    store float [[S0_UNALIGNED:%.*]], ptr [[PY0_UNALIGNED]], align 4
; CHECK:    [[VX1_UNALIGNED:%.*]] = load float, ptr [[PX1_UNALIGNED:%.*]], align 4
; CHECK:    [[VY1_UNALIGNED:%.*]] = load float, ptr [[PY1_UNALIGNED:%.*]], align 4
; CHECK:    store float [[S1_UNALIGNED:%.*]], ptr [[PY1_UNALIGNED]], align 4
; CHECK:    [[VX2_UNALIGNED:%.*]] = load float, ptr [[PX2_UNALIGNED:%.*]], align 4
; CHECK:    [[VY2_UNALIGNED:%.*]] = load float, ptr [[PY2_UNALIGNED:%.*]], align 4
; CHECK:    store float [[S2_UNALIGNED:%.*]], ptr [[PY2_UNALIGNED]], align 4
; CHECK:    [[VX3_UNALIGNED:%.*]] = load float, ptr [[PX3_UNALIGNED:%.*]], align 4
; CHECK:    [[VY3_UNALIGNED:%.*]] = load float, ptr [[PY3_UNALIGNED:%.*]], align 4
; CHECK:    store float [[S3_UNALIGNED:%.*]], ptr [[PY3_UNALIGNED]], align 4
; CHECK:    [[X_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[X]], i32 -16)
; CHECK:    [[Y_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[Y]], i32 -16)
; CHECK:    [[VX0:%.*]] = load float, ptr [[PX0:%.*]], align 4
; CHECK:    [[VY0:%.*]] = load float, ptr [[PY0:%.*]], align 4
; CHECK:    store float [[S0:%.*]], ptr [[PY0]], align 4
; CHECK:    [[VX1:%.*]] = load float, ptr [[PX1:%.*]], align 4
; CHECK:    [[VY1:%.*]] = load float, ptr [[PY1:%.*]], align 4
; CHECK:    store float [[S1:%.*]], ptr [[PY1]], align 4

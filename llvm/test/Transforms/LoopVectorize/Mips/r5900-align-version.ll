; A global of the module: aligned to 16 bytes, no versioning.
define void @scale_global(ptr noalias %q, i32 %n) {
;
;
; CHECK-LABEL: define void @scale_global(
; CHECK-SAME: ptr noalias [[Q:%.*]], i32 [[N:%.*]]) #[[ATTR1]] {
; CHECK:    [[V:%.*]] = load i32, ptr [[PG:%.*]], align 4
; CHECK:    store i32 [[A:%.*]], ptr [[PG]], align 4
;
; VEC-LABEL: define void @scale_global(
; VEC-SAME: ptr noalias [[Q:%.*]], i32 [[N:%.*]]) #[[ATTR1]] {
; VEC:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0:%.*]], align 4
; VEC:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1:%.*]], align 4
; VEC:    [[TMP2:%.*]] = mul <4 x i32> [[WIDE_LOAD]], splat (i32 3)
; VEC:    [[TMP3:%.*]] = mul <4 x i32> [[WIDE_LOAD1]], splat (i32 3)
; VEC:    store <4 x i32> [[TMP4:%.*]], ptr [[TMP0]], align 4
; VEC:    store <4 x i32> [[TMP5:%.*]], ptr [[TMP1]], align 4
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %pg = getelementptr inbounds [1024 x i32], ptr @g, i32 0, i32 %i
  %v = load i32, ptr %pg, align 4
  %m = mul i32 %v, 3
  %a = add i32 %m, 1
  store i32 %a, ptr %pg, align 4
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 1024
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; An unrolled loop with a prefetch per iteration, of elements x[i + c] with i
; stepping by 16 bytes: versioned, for the SLP vectorizer.
define void @saxpy_unrolled(ptr noalias %x, ptr noalias %y, i32 %n, float %a) "target-features"="+vu0" {
; CHECK-LABEL: define void @saxpy_unrolled(

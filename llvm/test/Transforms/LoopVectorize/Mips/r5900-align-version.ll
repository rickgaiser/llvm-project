  store float %s0, ptr %py0, align 4
  %i1 = or disjoint i32 %i, 1
  %px1 = getelementptr inbounds float, ptr %x, i32 %i1
  %vx1 = load float, ptr %px1, align 4
  %py1 = getelementptr inbounds float, ptr %y, i32 %i1

  %vx2 = load float, ptr %px2, align 4
  %py2 = getelementptr inbounds float, ptr %y, i32 %i2
  %vy2 = load float, ptr %py2, align 4
  %m2 = fmul float %vx2, %a
  %s2 = fadd float %m2, %vy2
  store float %s2, ptr %py2, align 4
  %i3 = or disjoint i32 %i, 3
  %px3 = getelementptr inbounds float, ptr %x, i32 %i3
  %vx3 = load float, ptr %px3, align 4
  %py3 = getelementptr inbounds float, ptr %y, i32 %i3
  %vy3 = load float, ptr %py3, align 4
  %m3 = fmul float %vx3, %a
  %s3 = fadd float %m3, %vy3
  store float %s3, ptr %py3, align 4
  %i.next = add i32 %i, 4
  %done = icmp sge i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}


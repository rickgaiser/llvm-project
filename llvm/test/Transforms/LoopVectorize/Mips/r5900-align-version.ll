; RUN: opt -passes=mips-r5900-align-version -mcpu=r5900 -S < %s | FileCheck %s
; RUN: opt -passes=mips-r5900-align-version,loop-vectorize -mcpu=r5900 -S < %s | FileCheck %s --check-prefix=VEC

; Loops over arrays of unknown alignment are versioned on their alignment,
; so that the aligned copy can use LQ/SQ (and LQC2/SQC2 with VU0); a global of
; the module is aligned instead. Loops that the loop vectorizer cannot or
; would not vectorize are left alone.

target datalayout = "e-m:e-p:32:32-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "mips64el-unknown-unknown-gnuabin32"

@g = internal global [1024 x i32] zeroinitializer, align 4

; y = a * x + y on VU0.
;.
; CHECK: @g = internal global [1024 x i32] zeroinitializer, align 16
;.
; VEC: @g = internal global [1024 x i32] zeroinitializer, align 16
;.
define void @saxpy(ptr noalias %x, ptr noalias %y, i32 %n, float %a) "target-features"="+vu0" {
;
;
; CHECK-LABEL: define void @saxpy(
; CHECK-SAME: ptr noalias [[X:%.*]], ptr noalias [[Y:%.*]], i32 [[N:%.*]], float [[A:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK:    [[ALIGNED:%.*]] = icmp eq i32 [[TMP3:%.*]], 0
; CHECK:    br i1 [[ALIGNED]], [[LOOP_PH:label %.*]], [[LOOP_PH_UNALIGNED:label %.*]]
; CHECK:    [[VX_UNALIGNED:%.*]] = load float, ptr [[PX_UNALIGNED:%.*]], align 4
; CHECK:    [[VY_UNALIGNED:%.*]] = load float, ptr [[PY_UNALIGNED:%.*]], align 4
; CHECK:    store float [[S_UNALIGNED:%.*]], ptr [[PY_UNALIGNED]], align 4
; CHECK:    [[X_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[X]], i32 -16)
; CHECK:    [[Y_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[Y]], i32 -16)
; CHECK:    [[VX:%.*]] = load float, ptr [[PX:%.*]], align 4
; CHECK:    [[VY:%.*]] = load float, ptr [[PY:%.*]], align 4
; CHECK:    store float [[S:%.*]], ptr [[PY]], align 4
;
; VEC-LABEL: define void @saxpy(
; VEC-SAME: ptr noalias [[X:%.*]], ptr noalias [[Y:%.*]], i32 [[N:%.*]], float [[A:%.*]]) #[[ATTR0:[0-9]+]] {
; VEC:    [[ALIGNED:%.*]] = icmp eq i32 [[TMP3:%.*]], 0
; VEC:    br i1 [[ALIGNED]], [[LOOP_PH:label %.*]], [[LOOP_PH_UNALIGNED:label %.*]]
; VEC:    [[VX_UNALIGNED:%.*]] = load float, ptr [[PX_UNALIGNED:%.*]], align 4
; VEC:    [[VY_UNALIGNED:%.*]] = load float, ptr [[PY_UNALIGNED:%.*]], align 4
; VEC:    store float [[S_UNALIGNED:%.*]], ptr [[PY_UNALIGNED]], align 4
; VEC:    [[X_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[X]], i32 -16)
; VEC:    [[Y_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[Y]], i32 -16)
; VEC:    [[WIDE_LOAD:%.*]] = load <4 x float>, ptr [[TMP20:%.*]], align 4
; VEC:    [[WIDE_LOAD8:%.*]] = load <4 x float>, ptr [[TMP22:%.*]], align 4
; VEC:    [[WIDE_LOAD9:%.*]] = load <4 x float>, ptr [[TMP21:%.*]], align 4
; VEC:    [[WIDE_LOAD10:%.*]] = load <4 x float>, ptr [[TMP23:%.*]], align 4
; VEC:    [[TMP24:%.*]] = fmul fast <4 x float> [[WIDE_LOAD]], [[BROADCAST_SPLAT:%.*]]
; VEC:    [[TMP25:%.*]] = fmul fast <4 x float> [[WIDE_LOAD8]], [[BROADCAST_SPLAT]]
; VEC:    [[TMP26:%.*]] = fadd fast <4 x float> [[TMP24]], [[WIDE_LOAD9]]
; VEC:    [[TMP27:%.*]] = fadd fast <4 x float> [[TMP25]], [[WIDE_LOAD10]]
; VEC:    store <4 x float> [[TMP26]], ptr [[TMP21]], align 4
; VEC:    store <4 x float> [[TMP27]], ptr [[TMP23]], align 4
; VEC:    [[VX:%.*]] = load float, ptr [[PX:%.*]], align 4
; VEC:    [[VY:%.*]] = load float, ptr [[PY:%.*]], align 4
; VEC:    store float [[S:%.*]], ptr [[PY]], align 4
;
entry:
  %c = icmp sgt i32 %n, 0
  br i1 %c, label %loop, label %exit

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %px = getelementptr inbounds float, ptr %x, i32 %i
  %py = getelementptr inbounds float, ptr %y, i32 %i
  %vx = load float, ptr %px, align 4
  %vy = load float, ptr %py, align 4
  %m = fmul fast float %vx, %a
  %s = fadd fast float %m, %vy
  store float %s, ptr %py, align 4
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret void
}


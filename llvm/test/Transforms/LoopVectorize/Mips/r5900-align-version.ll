; An integer sum (a reduction, MMI): versioned, the sum used after the loop.
define i32 @sum(ptr %p, i32 %n) {
;
;
; CHECK-LABEL: define i32 @sum(
; CHECK-SAME: ptr [[P:%.*]], i32 [[N:%.*]]) #[[ATTR1]] {
; CHECK:    [[ALIGNED:%.*]] = icmp eq i32 [[TMP1:%.*]], 0
; CHECK:    br i1 [[ALIGNED]], [[LOOP_PH:label %.*]], [[LOOP_PH_UNALIGNED:label %.*]]
; CHECK:    [[V_UNALIGNED:%.*]] = load i32, ptr [[PP_UNALIGNED:%.*]], align 4
; CHECK:    [[P_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[P]], i32 -16)
; CHECK:    [[V:%.*]] = load i32, ptr [[PP:%.*]], align 4
;
; VEC-LABEL: define i32 @sum(
; VEC-SAME: ptr [[P:%.*]], i32 [[N:%.*]]) #[[ATTR1]] {
; VEC:    [[ALIGNED:%.*]] = icmp eq i32 [[TMP1:%.*]], 0
; VEC:    br i1 [[ALIGNED]], [[LOOP_PH:label %.*]], [[LOOP_PH_UNALIGNED:label %.*]]
; VEC:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP3:%.*]], align 4
; VEC:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP4:%.*]], align 4
; VEC:    [[TMP5:%.*]] = add <4 x i32> [[VEC_PHI:%.*]], [[WIDE_LOAD]]
; VEC:    [[TMP6:%.*]] = add <4 x i32> [[VEC_PHI2:%.*]], [[WIDE_LOAD3]]
; VEC:    [[V_UNALIGNED:%.*]] = load i32, ptr [[PP_UNALIGNED:%.*]], align 4
; VEC:    [[P_ALIGNED:%.*]] = call align 16 ptr @llvm.ptrmask.p0.i32(ptr [[P]], i32 -16)
; VEC:    [[WIDE_LOAD13:%.*]] = load <4 x i32>, ptr [[TMP10:%.*]], align 4
; VEC:    [[WIDE_LOAD14:%.*]] = load <4 x i32>, ptr [[TMP11:%.*]], align 4
; VEC:    [[TMP12:%.*]] = add <4 x i32> [[VEC_PHI11:%.*]], [[WIDE_LOAD13]]
; VEC:    [[TMP13:%.*]] = add <4 x i32> [[VEC_PHI12:%.*]], [[WIDE_LOAD14]]
; VEC:    [[V:%.*]] = load i32, ptr [[PP:%.*]], align 4
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  %pp = getelementptr inbounds i32, ptr %p, i32 %i
  %v = load i32, ptr %pp, align 4
  %s.next = add i32 %s, %v
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret i32 %s.next
}

; A hash: its phi is no reduction, the loop is not vectorized.
define i32 @hash(ptr %p, i32 %n) {
;
;
; CHECK-LABEL: define i32 @hash(

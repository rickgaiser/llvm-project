; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "load <|trunc <|store <" --version 6
; RUN: opt -passes=loop-vectorize -mtriple=mips64el -mcpu=r5900 -S < %s | FileCheck %s

; Convert 32-bit pixels to 16-bit ones. On the R5900 the loop works on 8
; elements, so that PPACH packs them into one register: the vector bandwidth
; is maximized. The global arrays are 64-byte aligned and the induction
; variable starts at 0, so the vector loads and stores are aligned, which
; the cost model sees although the scalar accesses are not.

@src = global [4096 x i32] zeroinitializer, align 64
@dst = global [4096 x i16] zeroinitializer, align 64

define void @to_ct16() {
; CHECK-LABEL: define void @to_ct16(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK:    [[WIDE_LOAD:%.*]] = load <8 x i32>, ptr [[TMP0:%.*]], align 4
; CHECK:    [[TMP12:%.*]] = trunc <8 x i32> [[TMP11:%.*]] to <8 x i16>
; CHECK:    store <8 x i16> [[TMP12]], ptr [[TMP13:%.*]], align 2
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds [4 x i8], ptr @src, i32 %i
  %p = load i32, ptr %ps, align 4
  %r = lshr i32 %p, 3
  %r5 = and i32 %r, 31
  %g = lshr i32 %p, 6
  %g5 = and i32 %g, 992
  %rg = or i32 %r5, %g5
  %b = lshr i32 %p, 9
  %b5 = and i32 %b, 31744
  %rgb = or i32 %rg, %b5
  %a = lshr i32 %p, 16
  %a1 = and i32 %a, 32768
  %c = or i32 %rgb, %a1
  %t = trunc i32 %c to i16
  %pd = getelementptr inbounds [2 x i8], ptr @dst, i32 %i
  store i16 %t, ptr %pd, align 2
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 4096
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

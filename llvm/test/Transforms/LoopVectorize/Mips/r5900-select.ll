; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "load <|icmp [a-z]* <|select <|store <" --version 6
; RUN: opt -passes=loop-vectorize -mtriple=mips64el -mcpu=r5900 -S < %s | FileCheck %s

; Composite a sprite over a frame except for its transparent key color. The
; R5900 compares 4 pixels with PCEQW and selects with the mask.
define void @color_key(ptr noalias %out, ptr noalias %spr, ptr noalias %frame) {
; CHECK-LABEL: define void @color_key(
; CHECK-SAME: ptr noalias [[OUT:%.*]], ptr noalias [[SPR:%.*]], ptr noalias [[FRAME:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0:%.*]], align 16
; CHECK:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1:%.*]], align 16
; CHECK:    [[WIDE_LOAD2:%.*]] = load <4 x i32>, ptr [[TMP2:%.*]], align 16
; CHECK:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP3:%.*]], align 16
; CHECK:    [[TMP4:%.*]] = icmp eq <4 x i32> [[WIDE_LOAD]], splat (i32 16711935)
; CHECK:    [[TMP5:%.*]] = icmp eq <4 x i32> [[WIDE_LOAD1]], splat (i32 16711935)
; CHECK:    [[TMP6:%.*]] = select <4 x i1> [[TMP4]], <4 x i32> [[WIDE_LOAD2]], <4 x i32> [[WIDE_LOAD]]
; CHECK:    [[TMP7:%.*]] = select <4 x i1> [[TMP5]], <4 x i32> [[WIDE_LOAD3]], <4 x i32> [[WIDE_LOAD1]]
; CHECK:    store <4 x i32> [[TMP6]], ptr [[TMP8:%.*]], align 16
; CHECK:    store <4 x i32> [[TMP7]], ptr [[TMP9:%.*]], align 16
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i32, ptr %spr, i32 %i
  %s = load i32, ptr %ps, align 16
  %pd = getelementptr inbounds i32, ptr %frame, i32 %i
  %d = load i32, ptr %pd, align 16
  %key = icmp eq i32 %s, 16711935
  %c = select i1 %key, i32 %d, i32 %s
  %po = getelementptr inbounds i32, ptr %out, i32 %i
  store i32 %c, ptr %po, align 16
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 4096
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

; Copy the pixels with an alpha of at least 0x40, an unsigned compare.
define void @alpha_test(ptr noalias %out, ptr noalias %spr, ptr noalias %frame) {
; CHECK-LABEL: define void @alpha_test(
; CHECK-SAME: ptr noalias [[OUT:%.*]], ptr noalias [[SPR:%.*]], ptr noalias [[FRAME:%.*]]) #[[ATTR0]] {
; CHECK:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP0:%.*]], align 16
; CHECK:    [[WIDE_LOAD1:%.*]] = load <4 x i32>, ptr [[TMP1:%.*]], align 16
; CHECK:    [[WIDE_LOAD2:%.*]] = load <4 x i32>, ptr [[TMP2:%.*]], align 16
; CHECK:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP3:%.*]], align 16
; CHECK:    [[TMP4:%.*]] = icmp ugt <4 x i32> [[WIDE_LOAD]], splat (i32 1073741823)
; CHECK:    [[TMP5:%.*]] = icmp ugt <4 x i32> [[WIDE_LOAD1]], splat (i32 1073741823)
; CHECK:    [[TMP6:%.*]] = select <4 x i1> [[TMP4]], <4 x i32> [[WIDE_LOAD]], <4 x i32> [[WIDE_LOAD2]]
; CHECK:    [[TMP7:%.*]] = select <4 x i1> [[TMP5]], <4 x i32> [[WIDE_LOAD1]], <4 x i32> [[WIDE_LOAD3]]
; CHECK:    store <4 x i32> [[TMP6]], ptr [[TMP8:%.*]], align 16
; CHECK:    store <4 x i32> [[TMP7]], ptr [[TMP9:%.*]], align 16
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i32, ptr %spr, i32 %i
  %s = load i32, ptr %ps, align 16
  %pd = getelementptr inbounds i32, ptr %frame, i32 %i
  %d = load i32, ptr %pd, align 16
  %opaque = icmp ugt i32 %s, 1073741823
  %c = select i1 %opaque, i32 %s, i32 %d
  %po = getelementptr inbounds i32, ptr %out, i32 %i
  store i32 %c, ptr %po, align 16
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 4096
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

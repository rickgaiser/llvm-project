; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --filter "load <|store <|mul nsw <|interleaved.vec" --version 6
; RUN: opt -passes=loop-vectorize -mtriple=mips64el -mcpu=r5900 -S < %s | FileCheck %s

; Mix two voices with a Q15 volume into interleaved stereo 16-bit samples.
; On the R5900 this is vectorized with 8 elements: the 16x16->32 multiplies
; are PMULTH, and the left and right samples are stored as an interleave
; group (PEXTLH, PEXTUH). The voices are rows of a 64-byte aligned array, so
; their loads are aligned once widened.

@pcm = global [2 x [256 x i16]] zeroinitializer, align 64
@out = global [512 x i16] zeroinitializer, align 64

define void @mix(i16 %vl, i16 %vr) {
; CHECK-LABEL: define void @mix(
; CHECK-SAME: i16 [[VL:%.*]], i16 [[VR:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK:    [[WIDE_LOAD:%.*]] = load <8 x i16>, ptr [[TMP0:%.*]], align 2
; CHECK:    [[WIDE_LOAD3:%.*]] = load <8 x i16>, ptr [[TMP1:%.*]], align 2
; CHECK:    [[TMP4:%.*]] = mul nsw <8 x i32> [[TMP2:%.*]], [[BROADCAST_SPLAT:%.*]]
; CHECK:    [[TMP5:%.*]] = mul nsw <8 x i32> [[TMP3:%.*]], [[BROADCAST_SPLAT]]
; CHECK:    [[TMP6:%.*]] = mul nsw <8 x i32> [[TMP2]], [[BROADCAST_SPLAT2:%.*]]
; CHECK:    [[TMP7:%.*]] = mul nsw <8 x i32> [[TMP3]], [[BROADCAST_SPLAT2]]
; CHECK:    [[INTERLEAVED_VEC:%.*]] = shufflevector <16 x i16> [[TMP16:%.*]], <16 x i16> poison, <16 x i32> <i32 0, i32 8, i32 1, i32 9, i32 2, i32 10, i32 3, i32 11, i32 4, i32 12, i32 5, i32 13, i32 6, i32 14, i32 7, i32 15>
; CHECK:    store <16 x i16> [[INTERLEAVED_VEC]], ptr [[TMP15:%.*]], align 2
;
entry:
  %l16 = sext i16 %vl to i32
  %r16 = sext i16 %vr to i32
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %p0 = getelementptr inbounds [2 x [256 x i16]], ptr @pcm, i32 0, i32 0, i32 %i
  %p1 = getelementptr inbounds [2 x [256 x i16]], ptr @pcm, i32 0, i32 1, i32 %i
  %s0 = load i16, ptr %p0, align 2
  %s1 = load i16, ptr %p1, align 2
  %e0 = sext i16 %s0 to i32
  %e1 = sext i16 %s1 to i32
  %m0l = mul nsw i32 %e0, %l16
  %m1l = mul nsw i32 %e1, %l16
  %m0r = mul nsw i32 %e0, %r16
  %m1r = mul nsw i32 %e1, %r16
  %suml = add nsw i32 %m0l, %m1l
  %sumr = add nsw i32 %m0r, %m1r
  %shl = ashr i32 %suml, 15
  %shr = ashr i32 %sumr, 15
  %tl = trunc i32 %shl to i16
  %tr = trunc i32 %shr to i16
  %i2 = shl nuw nsw i32 %i, 1
  %pl = getelementptr inbounds [2 x i8], ptr @out, i32 %i2
  %pr = getelementptr inbounds i8, ptr %pl, i32 2
  store i16 %tl, ptr %pl, align 2
  store i16 %tr, ptr %pr, align 2
  %i.next = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %i.next, 256
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

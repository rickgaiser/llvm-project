; A v8i32 multiply of values sign extended from i16 is selected as PMULTH,
; which needs the extensions in its block: the vector sign extension and the
; broadcast of a sign extended scalar are sunk into the loop.

define void @mul_splat(ptr %p, ptr %q, i16 %v) {
; CHECK-LABEL: define void @mul_splat(
; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]], i16 [[V:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[A:%.*]] = load <8 x i16>, ptr [[P]], align 16
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP0:%.*]] = sext <8 x i16> [[A]] to <8 x i32>
; CHECK-NEXT:    [[TMP1:%.*]] = sext i16 [[V]] to i32
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <8 x i32> poison, i32 [[TMP1]], i32 0
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <8 x i32> [[TMP2]], <8 x i32> poison, <8 x i32> zeroinitializer
; CHECK-NEXT:    [[M:%.*]] = mul nsw <8 x i32> [[TMP0]], [[TMP3]]
; CHECK-NEXT:    [[QI:%.*]] = getelementptr <8 x i32>, ptr [[Q]], i32 [[I]]
; CHECK-NEXT:    store <8 x i32> [[M]], ptr [[QI]], align 32
; CHECK-NEXT:    [[I_NEXT]] = add i32 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i32 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %a = load <8 x i16>, ptr %p, align 16
  %ea = sext <8 x i16> %a to <8 x i32>
  %ev = sext i16 %v to i32
  %ins = insertelement <8 x i32> poison, i32 %ev, i32 0
  %s = shufflevector <8 x i32> %ins, <8 x i32> poison, <8 x i32> zeroinitializer
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %m = mul nsw <8 x i32> %ea, %s
  %qi = getelementptr <8 x i32>, ptr %q, i32 %i
  store <8 x i32> %m, ptr %qi, align 32
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, 4
  br i1 %done, label %exit, label %loop

exit:
  ret void
}

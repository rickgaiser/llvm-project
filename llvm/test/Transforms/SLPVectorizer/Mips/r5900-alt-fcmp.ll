; RUN: opt -passes=slp-vectorizer -S -mtriple=mips64el -mcpu=r5900 < %s | FileCheck %s

; Compares with alternate predicates are costed with the compared type, not
; the i1 result. Without VU0, a v4f32 compare is four FPU compares, so this is
; not vectorized.

define void @alt_fcmp(float %a, float %b, ptr %r) {
; CHECK-LABEL: define void @alt_fcmp(
; CHECK-SAME: float [[A:%.*]], float [[B:%.*]], ptr [[R:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[C1:%.*]] = fcmp fast olt float [[A]], [[B]]
; CHECK-NEXT:    [[Z1:%.*]] = zext i1 [[C1]] to i32
; CHECK-NEXT:    [[C2:%.*]] = fcmp fast ole float [[A]], [[B]]
; CHECK-NEXT:    [[Z2:%.*]] = zext i1 [[C2]] to i32
; CHECK-NEXT:    [[C3:%.*]] = fcmp fast ogt float [[A]], [[B]]
; CHECK-NEXT:    [[Z3:%.*]] = zext i1 [[C3]] to i32
; CHECK-NEXT:    [[C4:%.*]] = fcmp fast oge float [[A]], [[B]]
; CHECK-NEXT:    [[Z4:%.*]] = zext i1 [[C4]] to i32
; CHECK-NEXT:    [[P2:%.*]] = getelementptr i32, ptr [[R]], i32 1
; CHECK-NEXT:    [[P3:%.*]] = getelementptr i32, ptr [[R]], i32 2
; CHECK-NEXT:    [[P4:%.*]] = getelementptr i32, ptr [[R]], i32 3
; CHECK-NEXT:    store i32 [[Z1]], ptr [[R]], align 4
; CHECK-NEXT:    store i32 [[Z2]], ptr [[P2]], align 4
; CHECK-NEXT:    store i32 [[Z3]], ptr [[P3]], align 4
; CHECK-NEXT:    store i32 [[Z4]], ptr [[P4]], align 4
; CHECK-NEXT:    ret void
;
  %c1 = fcmp fast olt float %a, %b
  %z1 = zext i1 %c1 to i32
  %c2 = fcmp fast ole float %a, %b
  %z2 = zext i1 %c2 to i32
  %c3 = fcmp fast ogt float %a, %b
  %z3 = zext i1 %c3 to i32
  %c4 = fcmp fast oge float %a, %b
  %z4 = zext i1 %c4 to i32
  %p2 = getelementptr i32, ptr %r, i32 1
  %p3 = getelementptr i32, ptr %r, i32 2
  %p4 = getelementptr i32, ptr %r, i32 3
  store i32 %z1, ptr %r
  store i32 %z2, ptr %p2
  store i32 %z3, ptr %p3
  store i32 %z4, ptr %p4
  ret void
}

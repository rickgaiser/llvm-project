; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=slp-vectorizer -S -mtriple=mips64el -mcpu=r5900 | FileCheck %s

; out[i] = (in[i] << 2) + 1. With unknown alignment the R5900 MMI loads and stores
; go through a stack temporary, which costs more than the scalar code saves.
; With 16-byte alignment, lq/sq are as cheap as a scalar load/store.

define void @scale_unaligned(ptr noalias %in, ptr noalias %out) {
; CHECK-LABEL: define void @scale_unaligned(
; CHECK-SAME: ptr noalias [[IN:%.*]], ptr noalias [[OUT:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[IN1:%.*]] = getelementptr inbounds i32, ptr [[IN]], i32 1
; CHECK-NEXT:    [[IN2:%.*]] = getelementptr inbounds i32, ptr [[IN]], i32 2
; CHECK-NEXT:    [[IN3:%.*]] = getelementptr inbounds i32, ptr [[IN]], i32 3
; CHECK-NEXT:    [[A0:%.*]] = load i32, ptr [[IN]], align 4
; CHECK-NEXT:    [[A1:%.*]] = load i32, ptr [[IN1]], align 4
; CHECK-NEXT:    [[A2:%.*]] = load i32, ptr [[IN2]], align 4
; CHECK-NEXT:    [[A3:%.*]] = load i32, ptr [[IN3]], align 4
; CHECK-NEXT:    [[M0:%.*]] = shl i32 [[A0]], 2
; CHECK-NEXT:    [[M1:%.*]] = shl i32 [[A1]], 2
; CHECK-NEXT:    [[M2:%.*]] = shl i32 [[A2]], 2
; CHECK-NEXT:    [[M3:%.*]] = shl i32 [[A3]], 2
; CHECK-NEXT:    [[R0:%.*]] = add i32 [[M0]], 1
; CHECK-NEXT:    [[R1:%.*]] = add i32 [[M1]], 1
; CHECK-NEXT:    [[R2:%.*]] = add i32 [[M2]], 1
; CHECK-NEXT:    [[R3:%.*]] = add i32 [[M3]], 1
; CHECK-NEXT:    [[OUT1:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i32 1
; CHECK-NEXT:    [[OUT2:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i32 2
; CHECK-NEXT:    [[OUT3:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i32 3
; CHECK-NEXT:    store i32 [[R0]], ptr [[OUT]], align 4
; CHECK-NEXT:    store i32 [[R1]], ptr [[OUT1]], align 4
; CHECK-NEXT:    store i32 [[R2]], ptr [[OUT2]], align 4
; CHECK-NEXT:    store i32 [[R3]], ptr [[OUT3]], align 4
; CHECK-NEXT:    ret void
;
  %in1 = getelementptr inbounds i32, ptr %in, i32 1
  %in2 = getelementptr inbounds i32, ptr %in, i32 2
  %in3 = getelementptr inbounds i32, ptr %in, i32 3
  %a0 = load i32, ptr %in, align 4
  %a1 = load i32, ptr %in1, align 4
  %a2 = load i32, ptr %in2, align 4
  %a3 = load i32, ptr %in3, align 4
  %m0 = shl i32 %a0, 2
  %m1 = shl i32 %a1, 2
  %m2 = shl i32 %a2, 2
  %m3 = shl i32 %a3, 2
  %r0 = add i32 %m0, 1
  %r1 = add i32 %m1, 1
  %r2 = add i32 %m2, 1
  %r3 = add i32 %m3, 1
  %out1 = getelementptr inbounds i32, ptr %out, i32 1
  %out2 = getelementptr inbounds i32, ptr %out, i32 2
  %out3 = getelementptr inbounds i32, ptr %out, i32 3
  store i32 %r0, ptr %out, align 4
  store i32 %r1, ptr %out1, align 4
  store i32 %r2, ptr %out2, align 4
  store i32 %r3, ptr %out3, align 4
  ret void
}


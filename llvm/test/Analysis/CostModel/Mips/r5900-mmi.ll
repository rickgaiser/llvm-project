}

; Shuffles that are MMI instructions cost 1 (2 slots), an odd unzip 3; others
; go through the stack.
define void @mmi_shuffles(<16 x i8> %a, <16 x i8> %b, <4 x i32> %c, <4 x i32> %d) {
; CHECK-LABEL: 'mmi_shuffles'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %even = shufflevector <16 x i8> %a, <16 x i8> %b, <16 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14, i32 16, i32 18, i32 20, i32 22, i32 24, i32 26, i32 28, i32 30>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 6 for instruction: %odd = shufflevector <16 x i8> %a, <16 x i8> %b, <16 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15, i32 17, i32 19, i32 21, i32 23, i32 25, i32 27, i32 29, i32 31>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %ziplo = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 0, i32 4, i32 1, i32 5>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %cathi = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 2, i32 3, i32 6, i32 7>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 22 for instruction: %other = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 1, i32 0, i32 4, i32 5>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: ret void
;
  %even = shufflevector <16 x i8> %a, <16 x i8> %b, <16 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14, i32 16, i32 18, i32 20, i32 22, i32 24, i32 26, i32 28, i32 30>
  %odd = shufflevector <16 x i8> %a, <16 x i8> %b, <16 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15, i32 17, i32 19, i32 21, i32 23, i32 25, i32 27, i32 29, i32 31>
  %ziplo = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 0, i32 4, i32 1, i32 5>
  %cathi = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 2, i32 3, i32 6, i32 7>
  %other = shufflevector <4 x i32> %c, <4 x i32> %d, <4 x i32> <i32 1, i32 0, i32 4, i32 5>
  ret void
}

; Extensions of v8i16 and v16i8 are PEXTL/PEXTU per result register, and an
; arithmetic shift for a sign extension. A v8i32 multiply of values sign
; extended from i16 is PMULTH, PMFLO, PMFHI, PCPYLD and PCPYUD.
define void @widen_ops(<8 x i16> %h, <8 x i16> %h2, <16 x i8> %b) {
; CHECK-LABEL: 'widen_ops'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %zh = zext <8 x i16> %h to <8 x i32>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: %sh = sext <8 x i16> %h to <8 x i32>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: %sh2 = sext <8 x i16> %h2 to <8 x i32>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 8 for instruction: %sha = sext <8 x i16> %h to <8 x i32>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %zb = zext <16 x i8> %b to <16 x i16>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 24 for instruction: %sb = sext <16 x i8> %b to <16 x i32>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 10 for instruction: %m = mul nsw <8 x i32> %sh, %sh2
; CHECK-NEXT:  Cost Model: Found an estimated cost of 68 for instruction: %mz = mul nsw <8 x i32> %zh, %zh
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %a = add <8 x i32> %sha, %m
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: ret void
;
  %zh = zext <8 x i16> %h to <8 x i32>
  %sh = sext <8 x i16> %h to <8 x i32>
  %sh2 = sext <8 x i16> %h2 to <8 x i32>
  %sha = sext <8 x i16> %h to <8 x i32>
  %zb = zext <16 x i8> %b to <16 x i16>
  %sb = sext <16 x i8> %b to <16 x i32>
  %m = mul nsw <8 x i32> %sh, %sh2
  %mz = mul nsw <8 x i32> %zh, %zh

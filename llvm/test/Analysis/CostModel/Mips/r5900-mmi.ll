; R5900 MMI integer vector costs. Operations with a single MMI instruction
; cost 1 per 128-bit part; the others are scalarized through a stack temporary.

define void @arith(<16 x i8> %b, <8 x i16> %h, <4 x i32> %w, <2 x i64> %d, <8 x i32> %w8) {
; CHECK-LABEL: 'arith'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %add.b = add <16 x i8> %b, %b
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %sub.h = sub <8 x i16> %h, %h
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %add.w = add <4 x i32> %w, %w
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %xor.w = xor <4 x i32> %w, %w
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %and.d = and <2 x i64> %d, %d
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %add.w8 = add <8 x i32> %w8, %w8
; CHECK-NEXT:  Cost Model: Found an estimated cost of 34 for instruction: %mul.w = mul <4 x i32> %w, %w
; CHECK-NEXT:  Cost Model: Found an estimated cost of 24 for instruction: %mul3.w = mul <4 x i32> %w, splat (i32 3)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %shl.w = shl <4 x i32> %w, splat (i32 1)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %ashr.h = ashr <8 x i16> %h, splat (i16 3)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 34 for instruction: %shlv.w = shl <4 x i32> %w, %w
; CHECK-NEXT:  Cost Model: Found an estimated cost of 84 for instruction: %lshr.b = lshr <16 x i8> %b, splat (i8 1)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: ret void
;
  %add.b = add <16 x i8> %b, %b
  %sub.h = sub <8 x i16> %h, %h
  %add.w = add <4 x i32> %w, %w
  %xor.w = xor <4 x i32> %w, %w
  %and.d = and <2 x i64> %d, %d
  %add.w8 = add <8 x i32> %w8, %w8
  %mul.w = mul <4 x i32> %w, %w
  %mul3.w = mul <4 x i32> %w, splat (i32 3)
  %shl.w = shl <4 x i32> %w, splat (i32 1)
  %ashr.h = ashr <8 x i16> %h, splat (i16 3)
  %shlv.w = shl <4 x i32> %w, %w
  %lshr.b = lshr <16 x i8> %b, splat (i8 1)
  ret void
}

define void @intrinsics(<16 x i8> %b, <8 x i16> %h, <4 x i32> %w) {
; CHECK-LABEL: 'intrinsics'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %abs.w = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %w, i1 false)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %smax.h = call <8 x i16> @llvm.smax.v8i16(<8 x i16> %h, <8 x i16> %h)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 236 for instruction: %smax.b = call <16 x i8> @llvm.smax.v16i8(<16 x i8> %b, <16 x i8> %b)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %sadd.w = call <4 x i32> @llvm.sadd.sat.v4i32(<4 x i32> %w, <4 x i32> %w)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %uadd.b = call <16 x i8> @llvm.uadd.sat.v16i8(<16 x i8> %b, <16 x i8> %b)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 28 for instruction: %ctlz.w = call <4 x i32> @llvm.ctlz.v4i32(<4 x i32> %w, i1 false)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: ret void
;
  %abs.w = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %w, i1 false)
  %smax.h = call <8 x i16> @llvm.smax.v8i16(<8 x i16> %h, <8 x i16> %h)
  %smax.b = call <16 x i8> @llvm.smax.v16i8(<16 x i8> %b, <16 x i8> %b)
  %sadd.w = call <4 x i32> @llvm.sadd.sat.v4i32(<4 x i32> %w, <4 x i32> %w)
  %uadd.b = call <16 x i8> @llvm.uadd.sat.v16i8(<16 x i8> %b, <16 x i8> %b)
  %ctlz.w = call <4 x i32> @llvm.ctlz.v4i32(<4 x i32> %w, i1 false)
  ret void
}

